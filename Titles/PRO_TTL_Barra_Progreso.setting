{
	Tools = ordered() {
		PRO_TTL_Barra_Progreso = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				Input1 = InstanceInput { SourceOp = "Pista", Source = "TopLeftRed", Name = "Color de la pista", ControlGroup = 1, Default = 1, },
				Input2 = InstanceInput { SourceOp = "Pista", Source = "TopLeftGreen", ControlGroup = 1, Default = 1, },
				Input3 = InstanceInput { SourceOp = "Pista", Source = "TopLeftBlue", ControlGroup = 1, Default = 1, },
				Input4 = InstanceInput { SourceOp = "Pista", Source = "TopLeftAlpha", Name = "Opacidad de la pista", Default = 0.25, },
				Input5 = InstanceInput { SourceOp = "Relleno", Source = "TopLeftRed", Name = "Color del relleno", ControlGroup = 5, Default = 1, },
				Input6 = InstanceInput { SourceOp = "Relleno", Source = "TopLeftGreen", ControlGroup = 5, Default = 0.25, },
				Input7 = InstanceInput { SourceOp = "Relleno", Source = "TopLeftBlue", ControlGroup = 5, Default = 0.25, },
				Input8 = InstanceInput { SourceOp = "Barra", Source = "Ancho", Name = "Ancho total", Default = 0.8, },
				Input9 = InstanceInput { SourceOp = "Barra", Source = "Alto", Name = "Grosor", Default = 0.012, },
				Input10 = InstanceInput { SourceOp = "Barra", Source = "PosY", Name = "Altura en pantalla", Default = 0.06, },
				Input11 = InstanceInput { SourceOp = "Barra", Source = "Redondeo", Name = "Redondeo", Default = 0.5, },
				Input12 = InstanceInput { SourceOp = "Barra", Source = "Center", Name = "Posición", },
				Input13 = InstanceInput { SourceOp = "Barra", Source = "Size", Name = "Escala", Default = 1, },
				Input14 = InstanceInput { SourceOp = "Barra", Source = "Entrada", Name = "Duración entrada (% del clip)", Default = 0.05, },
				Input15 = InstanceInput { SourceOp = "Barra", Source = "Salida", Name = "Duración salida (% del clip, 0 = sin salida)", Default = 0.03, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Barra", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Lienzo = Background {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 0, },
						TopLeftGreen = Input { Value = 0, },
						TopLeftBlue = Input { Value = 0, },
						TopLeftAlpha = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -440, 0 } },
				},
				MascFondo = RectangleMask {
					CtrlWShown = false,
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" }, },
						OutputSize = Input { Value = FuID { "Custom" }, },
						MaskWidth = Input { Value = 1920, },
						MaskHeight = Input { Value = 1080, },
						PixelAspect = Input { Value = { 1, 1 }, },
						UseFrameFormatSettings = Input { Value = 1, },
						ClippingMode = Input { Value = FuID { "None" }, },
						Center = Input { Value = { 0.5, 0.06 }, Expression = "Point(0.5, Barra.PosY)", },
						Width = Input { Value = 0.8, Expression = "Barra.Ancho", },
						Height = Input { Value = 0.0213, Expression = "Barra.Alto*1.7778", },
						CornerRadius = Input { Value = 0.5, Expression = "Barra.Redondeo", },
					},
					ViewInfo = OperatorInfo { Pos = { -385, -99 } },
				},
				Pista = Background {
					CtrlWShown = false,
					Inputs = {
						EffectMask = Input { SourceOp = "MascFondo", Source = "Mask", },
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 1, },
						TopLeftGreen = Input { Value = 1, },
						TopLeftBlue = Input { Value = 1, },
						TopLeftAlpha = Input { Value = 0.25, },
					},
					ViewInfo = OperatorInfo { Pos = { -385, -66 } },
				},
				MascRelleno = RectangleMask {
					CtrlWShown = false,
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" }, },
						OutputSize = Input { Value = FuID { "Custom" }, },
						MaskWidth = Input { Value = 1920, },
						MaskHeight = Input { Value = 1080, },
						PixelAspect = Input { Value = { 1, 1 }, },
						UseFrameFormatSettings = Input { Value = 1, },
						ClippingMode = Input { Value = FuID { "None" }, },
						Center = Input { Value = { 0.5, 0.06 }, Expression = "Point(0.5 - Barra.Ancho/2 + Barra.Ancho*Barra.Progreso/2, Barra.PosY)", },
						Width = Input { Value = 0, Expression = "Barra.Ancho*Barra.Progreso", },
						Height = Input { Value = 0.0213, Expression = "Barra.Alto*1.7778", },
						CornerRadius = Input { Value = 0.5, Expression = "Barra.Redondeo", },
					},
					ViewInfo = OperatorInfo { Pos = { -330, -99 } },
				},
				Relleno = Background {
					CtrlWShown = false,
					Inputs = {
						EffectMask = Input { SourceOp = "MascRelleno", Source = "Mask", },
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 1, },
						TopLeftGreen = Input { Value = 0.25, },
						TopLeftBlue = Input { Value = 0.25, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { -330, -66 } },
				},
				M1 = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "Lienzo", Source = "Output", },
						Foreground = Input { SourceOp = "Pista", Source = "Output", },
						Blend = Input { Value = 1, Expression = "Barra.Xs*(max(0, min(1, (Barra.U - 0)/1)))*(max(0, min(1, (Barra.U - 0)/1)))*(3-2*(max(0, min(1, (Barra.U - 0)/1))))*Barra.Xs", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 } },
				},
				M2 = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "M1", Source = "Output", },
						Foreground = Input { SourceOp = "Relleno", Source = "Output", },
						Blend = Input { Value = 1, Expression = "Barra.Xs", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 165, 0 } },
				},
				Barra = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "M2", Source = "Output", },
						Progreso = Input { SourceOp = "PROBarraProgresoAnim", Source = "Value", },
						Entrada = Input { Value = 0.05, },
						Salida = Input { Value = 0.03, },
						U = Input { Value = 1, Expression = "max(0, min(1, Barra.Progreso/Barra.Entrada))", },
						Xs = Input { Value = 1, Expression = "(max(0, min(1, (1 - Barra.Progreso)/max(Barra.Salida, 0.0001))))*(max(0, min(1, (1 - Barra.Progreso)/max(Barra.Salida, 0.0001))))*(3-2*(max(0, min(1, (1 - Barra.Progreso)/max(Barra.Salida, 0.0001)))))", },
						Ancho = Input { Value = 0.8, },
						Alto = Input { Value = 0.012, },
						PosY = Input { Value = 0.06, },
						Redondeo = Input { Value = 0.5, },
					},
					ViewInfo = OperatorInfo { Pos = { 440, 0 } },
					UserControls = ordered() {
						Progreso = {
							LINKS_Name = "Progreso",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
