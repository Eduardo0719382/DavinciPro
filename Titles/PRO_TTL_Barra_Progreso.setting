							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.03,
							INP_MinScale = 0,
							INP_MaxScale = 0.5,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 0.5,
							ICS_ControlPage = "Controls",
						},
						Ancho = {
							LINKS_Name = "Ancho total",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.8,
							INP_MinScale = 0.05,
							INP_MaxScale = 1,
							INP_MinAllowed = 0.05,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
