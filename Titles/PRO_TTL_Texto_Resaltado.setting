{
	Tools = ordered() {
		PRO_TTL_Texto_Resaltado = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				Input1 = InstanceInput { SourceOp = "Texto", Source = "StyledText", Name = "Texto", },
				Input2 = InstanceInput { SourceOp = "Texto", Source = "Font", Name = "Fuente del texto", ControlGroup = 2, },
				Input3 = InstanceInput { SourceOp = "Texto", Source = "Style", ControlGroup = 2, },
				Input4 = InstanceInput { SourceOp = "Texto", Source = "Size", Name = "Tamaño del texto", Default = 0.07, },
				Input5 = InstanceInput { SourceOp = "Texto", Source = "Red1", Name = "Color del texto", ControlGroup = 5, Default = 0.05, },
				Input6 = InstanceInput { SourceOp = "Texto", Source = "Green1", ControlGroup = 5, Default = 0.05, },
				Input7 = InstanceInput { SourceOp = "Texto", Source = "Blue1", ControlGroup = 5, Default = 0.05, },
				Input8 = InstanceInput { SourceOp = "Banda", Source = "TopLeftRed", Name = "Color del resaltado", ControlGroup = 8, Default = 1, },
				Input9 = InstanceInput { SourceOp = "Banda", Source = "TopLeftGreen", ControlGroup = 8, Default = 0.85, },
				Input10 = InstanceInput { SourceOp = "Banda", Source = "TopLeftBlue", ControlGroup = 8, Default = 0.1, },
				Input11 = InstanceInput { SourceOp = "Resaltado", Source = "Ancho", Name = "Ancho del resaltado", Default = 0.42, },
				Input12 = InstanceInput { SourceOp = "Resaltado", Source = "Alto", Name = "Alto del resaltado", Default = 0.075, },
				Input13 = InstanceInput { SourceOp = "Resaltado", Source = "Inclinacion", Name = "Inclinación (grados)", Default = -2, },
				Input14 = InstanceInput { SourceOp = "Resaltado", Source = "Center", Name = "Posición", },
				Input15 = InstanceInput { SourceOp = "Resaltado", Source = "Size", Name = "Escala", Default = 1, },
				Input16 = InstanceInput { SourceOp = "Resaltado", Source = "Entrada", Name = "Duración entrada (% del clip)", Default = 0.3, },
				Input17 = InstanceInput { SourceOp = "Resaltado", Source = "Salida", Name = "Duración salida (% del clip, 0 = sin salida)", Default = 0.12, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Resaltado", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Lienzo = Background {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 0, },
						TopLeftGreen = Input { Value = 0, },
						TopLeftBlue = Input { Value = 0, },
						TopLeftAlpha = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -440, 0 } },
				},
				MascBanda = RectangleMask {
					CtrlWShown = false,
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" }, },
						OutputSize = Input { Value = FuID { "Custom" }, },
						MaskWidth = Input { Value = 1920, },
						MaskHeight = Input { Value = 1080, },
						PixelAspect = Input { Value = { 1, 1 }, },
						UseFrameFormatSettings = Input { Value = 1, },
						ClippingMode = Input { Value = FuID { "None" }, },
						Center = Input { Value = { 0.29, 0.497 }, Expression = "Point(0.5 - Resaltado.Ancho/2 + Resaltado.Ancho*(max(0, min(1, (Resaltado.U - 0.25)/0.75)))*(max(0, min(1, (Resaltado.U - 0.25)/0.75)))*(3-2*(max(0, min(1, (Resaltado.U - 0.25)/0.75))))/2, 0.497)", },
						Width = Input { Value = 0, Expression = "Resaltado.Ancho*(max(0, min(1, (Resaltado.U - 0.25)/0.75)))*(max(0, min(1, (Resaltado.U - 0.25)/0.75)))*(3-2*(max(0, min(1, (Resaltado.U - 0.25)/0.75))))", },
						Height = Input { Value = 0.133, Expression = "Resaltado.Alto*1.7778", },
						CornerRadius = Input { Value = 0.15, },
						Angle = Input { Value = -2, Expression = "Resaltado.Inclinacion", },
					},
					ViewInfo = OperatorInfo { Pos = { -385, -165 } },
				},
				Banda = Background {
					CtrlWShown = false,
					Inputs = {
						EffectMask = Input { SourceOp = "MascBanda", Source = "Mask", },
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 1, },
						TopLeftGreen = Input { Value = 0.85, },
						TopLeftBlue = Input { Value = 0.1, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { -385, -132 } },
				},
				Texto = TextPlus {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						Center = Input { Value = { 0.5, 0.5 }, },
						StyledText = Input { Value = "PALABRA CLAVE", },
						Font = Input { Value = "Arial", },
						Style = Input { Value = "Bold", },
						Size = Input { Value = 0.07, },
						Red1 = Input { Value = 0.05, },
						Green1 = Input { Value = 0.05, },
						Blue1 = Input { Value = 0.05, },
					},
					ViewInfo = OperatorInfo { Pos = { -330, -132 } },
				},
				M1 = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "Lienzo", Source = "Output", },
						Foreground = Input { SourceOp = "Banda", Source = "Output", },
						Blend = Input { Value = 1, Expression = "Resaltado.Xs", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 } },
				},
				M2 = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "M1", Source = "Output", },
						Foreground = Input { SourceOp = "Texto", Source = "Output", },
						Blend = Input { Value = 1, Expression = "(max(0, min(1, (Resaltado.U - 0)/0.35)))*(max(0, min(1, (Resaltado.U - 0)/0.35)))*(3-2*(max(0, min(1, (Resaltado.U - 0)/0.35))))*Resaltado.Xs", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 165, 0 } },
				},
				Resaltado = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "M2", Source = "Output", },
						Progreso = Input { SourceOp = "PROTextoResaltadoAnim", Source = "Value", },
						Entrada = Input { Value = 0.3, },
						Salida = Input { Value = 0.12, },
						U = Input { Value = 1, Expression = "max(0, min(1, Resaltado.Progreso/Resaltado.Entrada))", },
						Xs = Input { Value = 1, Expression = "(max(0, min(1, (1 - Resaltado.Progreso)/max(Resaltado.Salida, 0.0001))))*(max(0, min(1, (1 - Resaltado.Progreso)/max(Resaltado.Salida, 0.0001))))*(3-2*(max(0, min(1, (1 - Resaltado.Progreso)/max(Resaltado.Salida, 0.0001)))))", },
						Ancho = Input { Value = 0.42, },
						Alto = Input { Value = 0.075, },
						Inclinacion = Input { Value = -2, },
					},
					ViewInfo = OperatorInfo { Pos = { 440, 0 } },
					UserControls = ordered() {
						Progreso = {
							LINKS_Name = "Progreso",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Entrada = {
							LINKS_Name = "Duración entrada (% del clip)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.3,
							INP_MinScale = 0.01,
							INP_MaxScale = 0.8,
							INP_MinAllowed = 0.01,
							INP_MaxAllowed = 0.8,
							ICS_ControlPage = "Controls",
						},
						Salida = {
							LINKS_Name = "Duración salida (% del clip, 0 = sin salida)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.12,
							INP_MinScale = 0,
							INP_MaxScale = 0.5,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 0.5,
							ICS_ControlPage = "Controls",
						},
						Ancho = {
							LINKS_Name = "Ancho del resaltado",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.42,
							INP_MinScale = 0.02,
							INP_MaxScale = 1,
							INP_MinAllowed = 0.02,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Alto = {
							LINKS_Name = "Alto del resaltado",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.075,
							INP_MinScale = 0.005,
							INP_MaxScale = 0.3,
							INP_MinAllowed = 0.005,
							INP_MaxAllowed = 0.3,
							ICS_ControlPage = "Controls",
						},
						Inclinacion = {
							LINKS_Name = "Inclinación (grados)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = -2,
							INP_MinScale = -15,
							INP_MaxScale = 15,
							INP_MinAllowed = -15,
							INP_MaxAllowed = 15,
							ICS_ControlPage = "Controls",
						},
						U = {
							LINKS_Name = "Avance interno",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
						Xs = {
							LINKS_Name = "Salida interna",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
					},
				},
			},
		},
		PROTextoResaltadoAnim = LUTLookup {
			Inputs = {
			},
			CtrlWZoom = false,
		},
	},
	ActiveTool = "PRO_TTL_Texto_Resaltado"
}
