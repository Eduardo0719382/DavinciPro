						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5, 0.5 + iif(Documental.Vertical > 0.5, 0.15, 0))", },
						Size = Input { Value = 1, Expression = "iif(Documental.Vertical > 0.5, 1, 1)", },
					},
