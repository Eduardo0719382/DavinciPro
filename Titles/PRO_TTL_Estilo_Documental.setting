					},
					ViewInfo = OperatorInfo { Pos = { -385, -66 } },
				},
				Anim2 = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Dato", Source = "Output", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5 - 0.3*(1 - (max(0, min(1, (Documental.U - 0.35)/0.65)))*(max(0, min(1, (Documental.U - 0.35)/0.65)))*(3-2*(max(0, min(1, (Documental.U - 0.35)/0.65))))), 0.5)", },
