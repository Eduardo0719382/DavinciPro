						Foreground = Input { SourceOp = "Anim2", Source = "Output", },
						Blend = Input { Value = 1, Expression = "(max(0, min(1, (Documental.U - 0.35)/0.65)))*(max(0, min(1, (Documental.U - 0.35)/0.65)))*(3-2*(max(0, min(1, (Documental.U - 0.35)/0.65))))*Documental.Xs", },
