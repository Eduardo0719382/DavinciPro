				},
				Documental = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Formato", Source = "Output", },
						Progreso = Input { SourceOp = "PROEstiloDocumentalAnim", Source = "Value", },
						Entrada = Input { Value = 0.2, },
						Salida = Input { Value = 0.12, },
						U = Input { Value = 1, Expression = "max(0, min(1, Documental.Progreso/Documental.Entrada))", },
						Xs = Input { Value = 1, Expression = "(max(0, min(1, (1 - Documental.Progreso)/max(Documental.Salida, 0.0001))))*(max(0, min(1, (1 - Documental.Progreso)/max(Documental.Salida, 0.0001))))*(3-2*(max(0, min(1, (1 - Documental.Progreso)/max(Documental.Salida, 0.0001)))))", },
