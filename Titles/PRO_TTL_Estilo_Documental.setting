					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Titulo", Source = "Output", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5 - 0.3*(1 - (max(0, min(1, (Documental.U - 0)/0.6)))*(max(0, min(1, (Documental.U - 0)/0.6)))*(3-2*(max(0, min(1, (Documental.U - 0)/0.6))))), 0.5)", },
