							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.15,
							INP_MinScale = 0.01,
							INP_MaxScale = 0.8,
							INP_MinAllowed = 0.01,
							INP_MaxAllowed = 0.8,
							ICS_ControlPage = "Controls",
						},
						Salida = {
