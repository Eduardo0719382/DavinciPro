{
	Tools = ordered() {
		PRO_TTL_Suscribete = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				Input1 = InstanceInput { SourceOp = "Texto", Source = "StyledText", Name = "Texto", },
				Input2 = InstanceInput { SourceOp = "Boton", Source = "TopLeftRed", Name = "Color del botón", ControlGroup = 2, Default = 0.9, },
				Input3 = InstanceInput { SourceOp = "Boton", Source = "TopLeftGreen", ControlGroup = 2, Default = 0.1, },
				Input4 = InstanceInput { SourceOp = "Boton", Source = "TopLeftBlue", ControlGroup = 2, Default = 0.1, },
				Input5 = InstanceInput { SourceOp = "Texto", Source = "Red1", Name = "Color del texto", ControlGroup = 5, Default = 1, },
				Input6 = InstanceInput { SourceOp = "Texto", Source = "Green1", ControlGroup = 5, Default = 1, },
				Input7 = InstanceInput { SourceOp = "Texto", Source = "Blue1", ControlGroup = 5, Default = 1, },
				Input8 = InstanceInput { SourceOp = "CTA", Source = "Rebote", Name = "Rebote", Default = 1.5, },
				Input9 = InstanceInput { SourceOp = "CTA", Source = "Center", Name = "Posición", },
				Input10 = InstanceInput { SourceOp = "CTA", Source = "Size", Name = "Escala", Default = 1, },
				Input11 = InstanceInput { SourceOp = "CTA", Source = "Entrada", Name = "Duración entrada (% del clip)", Default = 0.15, },
				Input12 = InstanceInput { SourceOp = "CTA", Source = "Salida", Name = "Duración salida (% del clip, 0 = sin salida)", Default = 0.1, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "CTA", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Lienzo = Background {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 0, },
						TopLeftGreen = Input { Value = 0, },
						TopLeftBlue = Input { Value = 0, },
						TopLeftAlpha = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -440, 0 } },
				},
				MascBoton = RectangleMask {
					CtrlWShown = false,
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" }, },
						OutputSize = Input { Value = FuID { "Custom" }, },
						MaskWidth = Input { Value = 1920, },
						MaskHeight = Input { Value = 1080, },
						PixelAspect = Input { Value = { 1, 1 }, },
						UseFrameFormatSettings = Input { Value = 1, },
						ClippingMode = Input { Value = FuID { "None" }, },
						Center = Input { Value = { 0.5, 0.2 }, },
						Width = Input { Value = 0.26, },
						Height = Input { Value = 0.115557, },
						CornerRadius = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { -385, -132 } },
				},
				Boton = Background {
					CtrlWShown = false,
					Inputs = {
						EffectMask = Input { SourceOp = "MascBoton", Source = "Mask", },
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 0.9, },
						TopLeftGreen = Input { Value = 0.1, },
						TopLeftBlue = Input { Value = 0.1, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { -385, -99 } },
				},
				Texto = TextPlus {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						Center = Input { Value = { 0.5, 0.2 }, },
						StyledText = Input { Value = "SUSCRÍBETE", },
						Font = Input { Value = "Arial", },
						Style = Input { Value = "Bold", },
						Size = Input { Value = 0.04, },
						Red1 = Input { Value = 1, },
						Green1 = Input { Value = 1, },
						Blue1 = Input { Value = 1, },
						CharacterSpacing = Input { Value = 1.1, },
					},
					ViewInfo = OperatorInfo { Pos = { -330, -99 } },
				},
				Pastilla = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "Lienzo", Source = "Output", },
						Foreground = Input { SourceOp = "Boton", Source = "Output", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -275, -66 } },
				},
				ConTexto = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "Pastilla", Source = "Output", },
						Foreground = Input { SourceOp = "Texto", Source = "Output", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -220, -66 } },
				},
				Pop = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "ConTexto", Source = "Output", },
						Pivot = Input { Value = { 0.5, 0.2 }, },
						Center = Input { Value = { 0.5, 0.2 }, },
						Size = Input { Value = 1, Expression = "max(0, CTA.E*CTA.Xs*(1 - 0.12*max(0, sin((CTA.Progreso - 0.45)/0.1*3.14159265))*min(1, max(0, (CTA.Progreso - 0.45)*100))*min(1, max(0, (0.55 - CTA.Progreso)*100))))", },
					},
					ViewInfo = OperatorInfo { Pos = { -165, -66 } },
				},
				M1 = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "Lienzo", Source = "Output", },
						Foreground = Input { SourceOp = "Pop", Source = "Output", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 } },
				},
				CTA = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "M1", Source = "Output", },
						Progreso = Input { SourceOp = "PROSuscribeteAnim", Source = "Value", },
						Entrada = Input { Value = 0.15, },
						Salida = Input { Value = 0.1, },
						U = Input { Value = 1, Expression = "max(0, min(1, CTA.Progreso/CTA.Entrada))", },
						Xs = Input { Value = 1, Expression = "(max(0, min(1, (1 - CTA.Progreso)/max(CTA.Salida, 0.0001))))*(max(0, min(1, (1 - CTA.Progreso)/max(CTA.Salida, 0.0001))))*(3-2*(max(0, min(1, (1 - CTA.Progreso)/max(CTA.Salida, 0.0001)))))", },
						Rebote = Input { Value = 1.5, },
						E = Input { Value = 1, Expression = "(1 + ((1.70158*CTA.Rebote) + 1)*(CTA.U - 1)*(CTA.U - 1)*(CTA.U - 1) + (1.70158*CTA.Rebote)*(CTA.U - 1)*(CTA.U - 1))", },
					},
					ViewInfo = OperatorInfo { Pos = { 440, 0 } },
					UserControls = ordered() {
						Progreso = {
							LINKS_Name = "Progreso",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
