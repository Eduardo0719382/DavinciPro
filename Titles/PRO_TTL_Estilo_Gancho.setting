{
	Tools = ordered() {
		PRO_TTL_Estilo_Gancho = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				Input1 = InstanceInput { SourceOp = "Titular", Source = "StyledText", Name = "Titular", },
				Input2 = InstanceInput { SourceOp = "Apoyo", Source = "StyledText", Name = "Texto de apoyo", },
				Input3 = InstanceInput { SourceOp = "Titular", Source = "Font", Name = "Fuente del titular", ControlGroup = 3, },
				Input4 = InstanceInput { SourceOp = "Titular", Source = "Style", ControlGroup = 3, },
				Input5 = InstanceInput { SourceOp = "Gancho", Source = "TamTitular", Name = "Tamaño del titular", Default = 0.12, },
				Input6 = InstanceInput { SourceOp = "Titular", Source = "Red1", Name = "Color del titular", ControlGroup = 6, Default = 1, },
				Input7 = InstanceInput { SourceOp = "Titular", Source = "Green1", ControlGroup = 6, Default = 0.86, },
				Input8 = InstanceInput { SourceOp = "Titular", Source = "Blue1", ControlGroup = 6, Default = 0, },
				Input9 = InstanceInput { SourceOp = "Titular", Source = "Red4", Name = "Color de la sombra", ControlGroup = 9, Default = 0, },
				Input10 = InstanceInput { SourceOp = "Titular", Source = "Green4", ControlGroup = 9, Default = 0, },
				Input11 = InstanceInput { SourceOp = "Titular", Source = "Blue4", ControlGroup = 9, Default = 0, },
				Input12 = InstanceInput { SourceOp = "Titular", Source = "Offset4", Name = "Desplazamiento de la sombra", },
				Input13 = InstanceInput { SourceOp = "Apoyo", Source = "Font", Name = "Fuente del apoyo", ControlGroup = 13, },
				Input14 = InstanceInput { SourceOp = "Apoyo", Source = "Style", ControlGroup = 13, },
				Input15 = InstanceInput { SourceOp = "Gancho", Source = "TamApoyo", Name = "Tamaño del apoyo", Default = 0.035, },
				Input16 = InstanceInput { SourceOp = "Apoyo", Source = "Red1", Name = "Color del apoyo", ControlGroup = 16, Default = 1, },
				Input17 = InstanceInput { SourceOp = "Apoyo", Source = "Green1", ControlGroup = 16, Default = 1, },
				Input18 = InstanceInput { SourceOp = "Apoyo", Source = "Blue1", ControlGroup = 16, Default = 1, },
				Input19 = InstanceInput { SourceOp = "Gancho", Source = "Golpe", Name = "Fuerza del golpe", Default = 2, },
				Input20 = InstanceInput { SourceOp = "Gancho", Source = "Temblor", Name = "Temblor al aterrizar", Default = 1, },
				Input21 = InstanceInput { SourceOp = "Gancho", Source = "Inclinacion", Name = "Inclinación (grados)", Default = -4, },
				Input22 = InstanceInput { SourceOp = "Gancho", Source = "Vertical", Name = "Formato vertical (9:16)", Default = 0, },
				Input23 = InstanceInput { SourceOp = "Gancho", Source = "Center", Name = "Posición", },
				Input24 = InstanceInput { SourceOp = "Gancho", Source = "Size", Name = "Escala", Default = 1, },
				Input25 = InstanceInput { SourceOp = "Gancho", Source = "Entrada", Name = "Duración entrada (% del clip)", Default = 0.15, },
				Input26 = InstanceInput { SourceOp = "Gancho", Source = "Salida", Name = "Duración salida (% del clip, 0 = sin salida)", Default = 0.08, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Gancho", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Lienzo = Background {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 0, },
						TopLeftGreen = Input { Value = 0, },
						TopLeftBlue = Input { Value = 0, },
						TopLeftAlpha = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -440, 0 } },
				},
				Titular = TextPlus {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						Center = Input { Value = { 0.5, 0.5 }, },
						StyledText = Input { Value = "NO HAGAS ESTO", },
						Font = Input { Value = "Anton", },
						Style = Input { Value = "Regular", },
						Size = Input { Value = 0.12, Expression = "Gancho.TamTitular*iif(Gancho.Vertical > 0.5, 0.3164, 1)", },
						Red1 = Input { Value = 1, },
						Green1 = Input { Value = 0.86, },
						Blue1 = Input { Value = 0, },
						Enabled2 = Input { Value = 1, },
						Thickness2 = Input { Value = 0.03, },
						OutsideOnly2 = Input { Value = 1, },
						Red2 = Input { Value = 0, },
						Green2 = Input { Value = 0, },
						Blue2 = Input { Value = 0, },
						Enabled4 = Input { Value = 1, },
						ElementShape4 = Input { Value = 0, },
						Offset4 = Input { Value = { 0.01, -0.014 }, },
						Red4 = Input { Value = 0, },
						Green4 = Input { Value = 0, },
						Blue4 = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -385, -132 } },
				},
				Apoyo = TextPlus {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						Center = Input { Value = { 0.5, 0.5 }, },
						StyledText = Input { Value = "(MIRA HASTA EL FINAL)", },
						Font = Input { Value = "Montserrat", },
						Style = Input { Value = "ExtraBold", },
						Size = Input { Value = 0.035, Expression = "Gancho.TamApoyo*iif(Gancho.Vertical > 0.5, 0.3164, 1)", },
						Red1 = Input { Value = 1, },
						Green1 = Input { Value = 1, },
						Blue1 = Input { Value = 1, },
						Enabled2 = Input { Value = 1, },
						Thickness2 = Input { Value = 0.06, },
						OutsideOnly2 = Input { Value = 1, },
						Red2 = Input { Value = 0, },
						Green2 = Input { Value = 0, },
						Blue2 = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -330, -132 } },
				},
				Anim1 = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Titular", Source = "Output", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5 + Gancho.Temblor*0.012*(1 - max(0, min(1, (Gancho.Progreso - Gancho.Entrada*0.6)/0.06)))*iif(Gancho.U >= 0.6, 1, 0)*sin(time*2.9), 0.5 + ((0.54 + Gancho.Temblor*0.012*(1 - max(0, min(1, (Gancho.Progreso - Gancho.Entrada*0.6)/0.06)))*iif(Gancho.U >= 0.6, 1, 0)*sin(time*3.7 + 1)) - 0.5)*iif(Gancho.Vertical > 0.5, 0.3164, 1))", },
						Size = Input { Value = 1, Expression = "1 + Gancho.Golpe*(1 - max(0, min(1, Gancho.U/0.6)))*(1 - max(0, min(1, Gancho.U/0.6)))", },
						Angle = Input { Value = 0, Expression = "Gancho.Inclinacion", },
					},
					ViewInfo = OperatorInfo { Pos = { -385, -66 } },
				},
				Anim2 = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Apoyo", Source = "Output", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5, 0.5 + ((0.42 - 0.02*(1 - (max(0, min(1, (Gancho.U - 0.6)/0.4)))*(max(0, min(1, (Gancho.U - 0.6)/0.4)))*(3-2*(max(0, min(1, (Gancho.U - 0.6)/0.4)))))) - 0.5)*iif(Gancho.Vertical > 0.5, 0.3164, 1))", },
						Size = Input { Value = 1, Expression = "1", },
					},
					ViewInfo = OperatorInfo { Pos = { -330, -66 } },
				},
				M1 = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "Lienzo", Source = "Output", },
						Foreground = Input { SourceOp = "Anim1", Source = "Output", },
						Blend = Input { Value = 1, Expression = "min(1, 4*Gancho.U)*Gancho.Xs", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 } },
				},
				M2 = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "M1", Source = "Output", },
						Foreground = Input { SourceOp = "Anim2", Source = "Output", },
						Blend = Input { Value = 1, Expression = "(max(0, min(1, (Gancho.U - 0.6)/0.4)))*(max(0, min(1, (Gancho.U - 0.6)/0.4)))*(3-2*(max(0, min(1, (Gancho.U - 0.6)/0.4))))*Gancho.Xs", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 165, 0 } },
				},
				Formato = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "M2", Source = "Output", },
						Center = Input { Value = { 0.5, 0.55 }, Expression = "Point(0.5 + iif(Gancho.Vertical > 0.5, 0, 0), 0.5 + iif(Gancho.Vertical > 0.5, 0.12, 0.05))", },
						Size = Input { Value = 1, Expression = "iif(Gancho.Vertical > 0.5, 1.5, 1)", },
					},
					ViewInfo = OperatorInfo { Pos = { 385, 0 } },
				},
				Gancho = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Formato", Source = "Output", },
						Progreso = Input { SourceOp = "PROEstiloGanchoAnim", Source = "Value", },
						Entrada = Input { Value = 0.15, },
						Salida = Input { Value = 0.08, },
						U = Input { Value = 1, Expression = "max(0, min(1, Gancho.Progreso/Gancho.Entrada))", },
						Xs = Input { Value = 1, Expression = "(max(0, min(1, (1 - Gancho.Progreso)/max(Gancho.Salida, 0.0001))))*(max(0, min(1, (1 - Gancho.Progreso)/max(Gancho.Salida, 0.0001))))*(3-2*(max(0, min(1, (1 - Gancho.Progreso)/max(Gancho.Salida, 0.0001)))))", },
						Golpe = Input { Value = 2, },
						Temblor = Input { Value = 1, },
						Inclinacion = Input { Value = -4, },
						Vertical = Input { Value = 0, },
						TamTitular = Input { Value = 0.12, },
						TamApoyo = Input { Value = 0.035, },
					},
					ViewInfo = OperatorInfo { Pos = { 440, 0 } },
					UserControls = ordered() {
						Progreso = {
							LINKS_Name = "Progreso",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Entrada = {
							LINKS_Name = "Duración entrada (% del clip)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.15,
							INP_MinScale = 0.01,
							INP_MaxScale = 0.8,
							INP_MinAllowed = 0.01,
							INP_MaxAllowed = 0.8,
							ICS_ControlPage = "Controls",
						},
						Salida = {
							LINKS_Name = "Duración salida (% del clip, 0 = sin salida)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.08,
							INP_MinScale = 0,
							INP_MaxScale = 0.5,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 0.5,
							ICS_ControlPage = "Controls",
						},
						Golpe = {
							LINKS_Name = "Fuerza del golpe",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 2,
							INP_MinScale = 0,
							INP_MaxScale = 5,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 5,
							ICS_ControlPage = "Controls",
						},
						Temblor = {
							LINKS_Name = "Temblor al aterrizar",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 5,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 5,
							ICS_ControlPage = "Controls",
						},
						Inclinacion = {
							LINKS_Name = "Inclinación (grados)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = -4,
							INP_MinScale = -20,
							INP_MaxScale = 20,
							INP_MinAllowed = -20,
							INP_MaxAllowed = 20,
							ICS_ControlPage = "Controls",
						},
						Vertical = {
							LINKS_Name = "Formato vertical (9:16)",
							LINKID_DataType = "Number",
							INPID_InputControl = "CheckboxControl",
							INP_Integer = true,
							CBC_TriState = false,
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						TamTitular = {
							LINKS_Name = "Tamaño Titular",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.12,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
						TamApoyo = {
							LINKS_Name = "Tamaño Apoyo",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.035,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
						U = {
							LINKS_Name = "Avance interno",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
						Xs = {
							LINKS_Name = "Salida interna",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
					},
				},
			},
		},
		PROEstiloGanchoAnim = LUTLookup {
			Inputs = {
			},
			CtrlWZoom = false,
		},
	},
	ActiveTool = "PRO_TTL_Estilo_Gancho"
}
