{
	Tools = ordered() {
		PRO_TTL_Texto_Maquina = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				Input1 = InstanceInput { SourceOp = "Fuente", Source = "StyledText", Name = "Texto", },
				Input2 = InstanceInput { SourceOp = "Texto", Source = "Font", Name = "Fuente", ControlGroup = 2, },
				Input3 = InstanceInput { SourceOp = "Texto", Source = "Style", ControlGroup = 2, },
				Input4 = InstanceInput { SourceOp = "Maquina", Source = "TamTexto", Name = "Tamaño", Default = 0.06, },
				Input5 = InstanceInput { SourceOp = "Texto", Source = "Red1", Name = "Color", ControlGroup = 5, Default = 1, },
				Input6 = InstanceInput { SourceOp = "Texto", Source = "Green1", ControlGroup = 5, Default = 1, },
				Input7 = InstanceInput { SourceOp = "Texto", Source = "Blue1", ControlGroup = 5, Default = 1, },
				Input8 = InstanceInput { SourceOp = "Texto", Source = "Center", Name = "Inicio del texto", },
				Input9 = InstanceInput { SourceOp = "Maquina", Source = "Cursor", Name = "Cursor parpadeante", Default = 1, },
				Input10 = InstanceInput { SourceOp = "Maquina", Source = "Vertical", Name = "Formato vertical (9:16)", Default = 0, },
				Input11 = InstanceInput { SourceOp = "Maquina", Source = "Center", Name = "Posición", },
				Input12 = InstanceInput { SourceOp = "Maquina", Source = "Size", Name = "Escala", Default = 1, },
				Input13 = InstanceInput { SourceOp = "Maquina", Source = "Entrada", Name = "Duración entrada (% del clip)", Default = 0.6, },
				Input14 = InstanceInput { SourceOp = "Maquina", Source = "Salida", Name = "Duración salida (% del clip, 0 = sin salida)", Default = 0.1, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Maquina", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Lienzo = Background {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 0, },
						TopLeftGreen = Input { Value = 0, },
						TopLeftBlue = Input { Value = 0, },
						TopLeftAlpha = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -440, 0 } },
				},
				Fuente = TextPlus {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						Center = Input { Value = { 0.5, 0.5 }, },
						StyledText = Input { Value = "Escribe aquí tu frase...", },
						Font = Input { Value = "Arial", },
						Style = Input { Value = "Bold", },
						Size = Input { Value = 0.06, Expression = "Maquina.TamFuente*iif(Maquina.Vertical > 0.5, 0.3164, 1)", },
						Red1 = Input { Value = 1, },
						Green1 = Input { Value = 1, },
						Blue1 = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { -385, -198 } },
				},
				Texto = TextPlus {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						Center = Input { Value = { 0.12, 0.5 }, },
						StyledText = Input { Value = "", Expression = "Text(string.sub(Fuente.StyledText.Value, 1, floor(Maquina.U*string.len(Fuente.StyledText.Value) + 0.5)) .. string.rep(\"|\", Maquina.Cursor*iif(sin(time*0.5) > 0, 1, 0)))", },
						Font = Input { Value = "Courier New", },
						Style = Input { Value = "Bold", },
						Size = Input { Value = 0.06, Expression = "Maquina.TamTexto*iif(Maquina.Vertical > 0.5, 0.3164, 1)", },
						Red1 = Input { Value = 1, },
						Green1 = Input { Value = 1, },
						Blue1 = Input { Value = 1, },
						HorizontalLeftCenterRight = Input { Value = -1, },
					},
					ViewInfo = OperatorInfo { Pos = { -385, -132 } },
				},
				M1 = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "Lienzo", Source = "Output", },
						Foreground = Input { SourceOp = "Texto", Source = "Output", },
						Blend = Input { Value = 1, Expression = "Maquina.Xs", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 } },
				},
				Formato = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "M1", Source = "Output", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5 + iif(Maquina.Vertical > 0.5, 0.05, 0), 0.5 + iif(Maquina.Vertical > 0.5, 0, 0))", },
						Size = Input { Value = 1, Expression = "iif(Maquina.Vertical > 0.5, 1.3, 1)", },
					},
					ViewInfo = OperatorInfo { Pos = { 385, 0 } },
				},
				Maquina = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Formato", Source = "Output", },
						Progreso = Input { SourceOp = "PROTextoMaquinaAnim", Source = "Value", },
						Entrada = Input { Value = 0.6, },
						Salida = Input { Value = 0.1, },
						U = Input { Value = 1, Expression = "max(0, min(1, Maquina.Progreso/Maquina.Entrada))", },
						Xs = Input { Value = 1, Expression = "(max(0, min(1, (1 - Maquina.Progreso)/max(Maquina.Salida, 0.0001))))*(max(0, min(1, (1 - Maquina.Progreso)/max(Maquina.Salida, 0.0001))))*(3-2*(max(0, min(1, (1 - Maquina.Progreso)/max(Maquina.Salida, 0.0001)))))", },
						Cursor = Input { Value = 1, },
						Vertical = Input { Value = 0, },
						TamFuente = Input { Value = 0.06, },
						TamTexto = Input { Value = 0.06, },
					},
					ViewInfo = OperatorInfo { Pos = { 440, 0 } },
					UserControls = ordered() {
						Progreso = {
							LINKS_Name = "Progreso",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Entrada = {
							LINKS_Name = "Duración entrada (% del clip)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.6,
							INP_MinScale = 0.01,
							INP_MaxScale = 0.8,
							INP_MinAllowed = 0.01,
							INP_MaxAllowed = 0.8,
							ICS_ControlPage = "Controls",
						},
						Salida = {
							LINKS_Name = "Duración salida (% del clip, 0 = sin salida)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.1,
							INP_MinScale = 0,
							INP_MaxScale = 0.5,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 0.5,
							ICS_ControlPage = "Controls",
						},
						Cursor = {
							LINKS_Name = "Cursor parpadeante",
							LINKID_DataType = "Number",
							INPID_InputControl = "CheckboxControl",
							INP_Integer = true,
							CBC_TriState = false,
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Vertical = {
							LINKS_Name = "Formato vertical (9:16)",
							LINKID_DataType = "Number",
							INPID_InputControl = "CheckboxControl",
							INP_Integer = true,
							CBC_TriState = false,
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						TamFuente = {
							LINKS_Name = "Tamaño Fuente",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.06,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
						TamTexto = {
							LINKS_Name = "Tamaño Texto",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.06,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
						U = {
							LINKS_Name = "Avance interno",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
						Xs = {
							LINKS_Name = "Salida interna",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
					},
				},
			},
		},
		PROTextoMaquinaAnim = LUTLookup {
			Inputs = {
			},
			CtrlWZoom = false,
		},
	},
	ActiveTool = "PRO_TTL_Texto_Maquina"
}
