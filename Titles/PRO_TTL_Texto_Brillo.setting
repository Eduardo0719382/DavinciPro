{
	Tools = ordered() {
		PRO_TTL_Texto_Brillo = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				Input1 = InstanceInput { SourceOp = "Texto", Source = "StyledText", Name = "Texto", },
				Input2 = InstanceInput { SourceOp = "Texto", Source = "Font", Name = "Fuente", ControlGroup = 2, },
				Input3 = InstanceInput { SourceOp = "Texto", Source = "Style", ControlGroup = 2, },
				Input4 = InstanceInput { SourceOp = "Texto", Source = "Size", Name = "Tamaño", Default = 0.12, },
				Input5 = InstanceInput { SourceOp = "Texto", Source = "Red1", Name = "Color", ControlGroup = 5, Default = 0.95, },
				Input6 = InstanceInput { SourceOp = "Texto", Source = "Green1", ControlGroup = 5, Default = 0.75, },
				Input7 = InstanceInput { SourceOp = "Texto", Source = "Blue1", ControlGroup = 5, Default = 0.3, },
				Input8 = InstanceInput { SourceOp = "Brillo", Source = "Periodo", Name = "Fotogramas entre destellos", Default = 60, },
				Input9 = InstanceInput { SourceOp = "Brillo", Source = "Intensidad", Name = "Intensidad del destello", Default = 1.2, },
				Input10 = InstanceInput { SourceOp = "Brillo", Source = "AnchoBrillo", Name = "Ancho del destello", Default = 0.06, },
				Input11 = InstanceInput { SourceOp = "Brillo", Source = "Center", Name = "Posición", },
				Input12 = InstanceInput { SourceOp = "Brillo", Source = "Size", Name = "Escala", Default = 1, },
				Input13 = InstanceInput { SourceOp = "Brillo", Source = "Entrada", Name = "Duración entrada (% del clip)", Default = 0.15, },
				Input14 = InstanceInput { SourceOp = "Brillo", Source = "Salida", Name = "Duración salida (% del clip, 0 = sin salida)", Default = 0.1, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Brillo", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Lienzo = Background {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 0, },
						TopLeftGreen = Input { Value = 0, },
						TopLeftBlue = Input { Value = 0, },
						TopLeftAlpha = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -440, 0 } },
				},
				Texto = TextPlus {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						Center = Input { Value = { 0.5, 0.5 }, },
						StyledText = Input { Value = "BRILLO", },
						Font = Input { Value = "Arial", },
						Style = Input { Value = "Bold", },
						Size = Input { Value = 0.12, },
						Red1 = Input { Value = 0.95, },
						Green1 = Input { Value = 0.75, },
						Blue1 = Input { Value = 0.3, },
					},
					ViewInfo = OperatorInfo { Pos = { -385, -132 } },
				},
				Franja = RectangleMask {
					CtrlWShown = false,
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" }, },
						OutputSize = Input { Value = FuID { "Custom" }, },
						MaskWidth = Input { Value = 1920, },
						MaskHeight = Input { Value = 1080, },
						PixelAspect = Input { Value = { 1, 1 }, },
						UseFrameFormatSettings = Input { Value = 1, },
						ClippingMode = Input { Value = FuID { "None" }, },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(-0.3 + 1.6*min(1, (time/Brillo.Periodo - floor(time/Brillo.Periodo))/0.4), 0.5)", },
						Width = Input { Value = 0.06, Expression = "Brillo.AnchoBrillo", },
						Height = Input { Value = 4, },
						Angle = Input { Value = 20, },
						SoftEdge = Input { Value = 0.03, },
					},
					ViewInfo = OperatorInfo { Pos = { -330, -165 } },
				},
				Destello = BrightnessContrast {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Texto", Source = "Output", },
						EffectMask = Input { SourceOp = "Franja", Source = "Mask", },
						Gain = Input { Value = 2.2, Expression = "1 + Brillo.Intensidad", },
						Saturation = Input { Value = 0.4, },
					},
					ViewInfo = OperatorInfo { Pos = { -275, -132 } },
				},
				M1 = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "Lienzo", Source = "Output", },
						Foreground = Input { SourceOp = "Destello", Source = "Output", },
						Blend = Input { Value = 1, Expression = "(max(0, min(1, (Brillo.U - 0)/1)))*(max(0, min(1, (Brillo.U - 0)/1)))*(3-2*(max(0, min(1, (Brillo.U - 0)/1))))*Brillo.Xs", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 } },
				},
				Brillo = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "M1", Source = "Output", },
						Progreso = Input { SourceOp = "PROTextoBrilloAnim", Source = "Value", },
						Entrada = Input { Value = 0.15, },
						Salida = Input { Value = 0.1, },
						U = Input { Value = 1, Expression = "max(0, min(1, Brillo.Progreso/Brillo.Entrada))", },
						Xs = Input { Value = 1, Expression = "(max(0, min(1, (1 - Brillo.Progreso)/max(Brillo.Salida, 0.0001))))*(max(0, min(1, (1 - Brillo.Progreso)/max(Brillo.Salida, 0.0001))))*(3-2*(max(0, min(1, (1 - Brillo.Progreso)/max(Brillo.Salida, 0.0001)))))", },
						Periodo = Input { Value = 60, },
						Intensidad = Input { Value = 1.2, },
						AnchoBrillo = Input { Value = 0.06, },
					},
					ViewInfo = OperatorInfo { Pos = { 440, 0 } },
					UserControls = ordered() {
						Progreso = {
							LINKS_Name = "Progreso",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Entrada = {
							LINKS_Name = "Duración entrada (% del clip)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.15,
							INP_MinScale = 0.01,
							INP_MaxScale = 0.8,
							INP_MinAllowed = 0.01,
							INP_MaxAllowed = 0.8,
							ICS_ControlPage = "Controls",
						},
						Salida = {
							LINKS_Name = "Duración salida (% del clip, 0 = sin salida)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.1,
							INP_MinScale = 0,
							INP_MaxScale = 0.5,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 0.5,
							ICS_ControlPage = "Controls",
						},
						Periodo = {
							LINKS_Name = "Fotogramas entre destellos",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 60,
							INP_MinScale = 10,
							INP_MaxScale = 300,
							INP_MinAllowed = 10,
							INP_MaxAllowed = 300,
							ICS_ControlPage = "Controls",
						},
						Intensidad = {
							LINKS_Name = "Intensidad del destello",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1.2,
							INP_MinScale = 0,
							INP_MaxScale = 4,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 4,
							ICS_ControlPage = "Controls",
						},
						AnchoBrillo = {
							LINKS_Name = "Ancho del destello",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.06,
							INP_MinScale = 0.005,
							INP_MaxScale = 0.3,
							INP_MinAllowed = 0.005,
							INP_MaxAllowed = 0.3,
							ICS_ControlPage = "Controls",
						},
						U = {
							LINKS_Name = "Avance interno",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
						Xs = {
							LINKS_Name = "Salida interna",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
					},
				},
			},
		},
		PROTextoBrilloAnim = LUTLookup {
			Inputs = {
			},
			CtrlWZoom = false,
		},
	},
	ActiveTool = "PRO_TTL_Texto_Brillo"
}
