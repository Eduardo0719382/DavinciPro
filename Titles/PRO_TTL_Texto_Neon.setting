{
	Tools = ordered() {
		PRO_TTL_Texto_Neon = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				Input1 = InstanceInput { SourceOp = "Texto", Source = "StyledText", Name = "Texto", },
				Input2 = InstanceInput { SourceOp = "Texto", Source = "Font", Name = "Fuente", ControlGroup = 2, },
				Input3 = InstanceInput { SourceOp = "Texto", Source = "Style", ControlGroup = 2, },
				Input4 = InstanceInput { SourceOp = "Texto", Source = "Size", Name = "Tamaño", Default = 0.14, },
				Input5 = InstanceInput { SourceOp = "Texto", Source = "Red1", Name = "Color", ControlGroup = 5, Default = 1, },
				Input6 = InstanceInput { SourceOp = "Texto", Source = "Green1", ControlGroup = 5, Default = 0.25, },
				Input7 = InstanceInput { SourceOp = "Texto", Source = "Blue1", ControlGroup = 5, Default = 0.7, },
				Input8 = InstanceInput { SourceOp = "Neon", Source = "Glow", Name = "Brillo del halo", Default = 0.8, },
				Input9 = InstanceInput { SourceOp = "HaloLejos", Source = "XBlurSize", Name = "Radio del halo", Default = 45, },
				Input10 = InstanceInput { SourceOp = "Neon", Source = "Parpadeo", Name = "Fallos de parpadeo", Default = 0.3, },
				Input11 = InstanceInput { SourceOp = "Neon", Source = "Center", Name = "Posición", },
				Input12 = InstanceInput { SourceOp = "Neon", Source = "Size", Name = "Escala", Default = 1, },
				Input13 = InstanceInput { SourceOp = "Neon", Source = "Entrada", Name = "Duración entrada (% del clip)", Default = 0.25, },
				Input14 = InstanceInput { SourceOp = "Neon", Source = "Salida", Name = "Duración salida (% del clip, 0 = sin salida)", Default = 0.1, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Neon", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Lienzo = Background {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 0, },
						TopLeftGreen = Input { Value = 0, },
						TopLeftBlue = Input { Value = 0, },
						TopLeftAlpha = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -440, 0 } },
				},
				Texto = TextPlus {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						Center = Input { Value = { 0.5, 0.5 }, },
						StyledText = Input { Value = "NEON", },
						Font = Input { Value = "Arial", },
						Style = Input { Value = "Bold", },
						Size = Input { Value = 0.14, },
						Red1 = Input { Value = 1, },
						Green1 = Input { Value = 0.25, },
						Blue1 = Input { Value = 0.7, },
					},
					ViewInfo = OperatorInfo { Pos = { -385, -132 } },
				},
				Nucleo = BrightnessContrast {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Texto", Source = "Output", },
						Gain = Input { Value = 1.3, },
						Saturation = Input { Value = 0.35, },
					},
					ViewInfo = OperatorInfo { Pos = { -330, -165 } },
				},
				HaloCerca = Blur {
					CtrlWShown = false,
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" }, },
						XBlurSize = Input { Value = 10, },
						Input = Input { SourceOp = "Texto", Source = "Output", },
					},
					ViewInfo = OperatorInfo { Pos = { -330, -132 } },
				},
				HaloLejos = Blur {
					CtrlWShown = false,
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" }, },
						XBlurSize = Input { Value = 45, },
						Input = Input { SourceOp = "Texto", Source = "Output", },
					},
					ViewInfo = OperatorInfo { Pos = { -330, -99 } },
				},
				M1 = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "Lienzo", Source = "Output", },
						Foreground = Input { SourceOp = "HaloLejos", Source = "Output", },
						Blend = Input { Value = 1, Expression = "Neon.Glow*0.8*Neon.F*Neon.Xs", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 } },
				},
				M2 = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "M1", Source = "Output", },
						Foreground = Input { SourceOp = "HaloCerca", Source = "Output", },
						Blend = Input { Value = 1, Expression = "Neon.Glow*Neon.F*Neon.Xs", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 165, 0 } },
				},
				M3 = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "M2", Source = "Output", },
						Foreground = Input { SourceOp = "Nucleo", Source = "Output", },
						Blend = Input { Value = 1, Expression = "(0.35 + 0.65*Neon.F)*Neon.Xs", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 220, 0 } },
				},
				Neon = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "M3", Source = "Output", },
						Progreso = Input { SourceOp = "PROTextoNeonAnim", Source = "Value", },
						Entrada = Input { Value = 0.25, },
						Salida = Input { Value = 0.1, },
						U = Input { Value = 1, Expression = "max(0, min(1, Neon.Progreso/Neon.Entrada))", },
						Xs = Input { Value = 1, Expression = "(max(0, min(1, (1 - Neon.Progreso)/max(Neon.Salida, 0.0001))))*(max(0, min(1, (1 - Neon.Progreso)/max(Neon.Salida, 0.0001))))*(3-2*(max(0, min(1, (1 - Neon.Progreso)/max(Neon.Salida, 0.0001)))))", },
						Glow = Input { Value = 0.8, },
						Parpadeo = Input { Value = 0.3, },
						F = Input { Value = 1, Expression = "iif(sin(time*1.37)*sin(time*2.71 + 1)*sin(time*0.53 + 2) > 1 - Neon.Parpadeo*0.6, 0.3, 1)*iif(Neon.U < 1, iif(sin(time*2.3)*sin(time*0.9 + 1) > 0, 1, 0.15), 1)", },
					},
					ViewInfo = OperatorInfo { Pos = { 440, 0 } },
					UserControls = ordered() {
						Progreso = {
							LINKS_Name = "Progreso",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Entrada = {
							LINKS_Name = "Duración entrada (% del clip)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.25,
							INP_MinScale = 0.01,
							INP_MaxScale = 0.8,
							INP_MinAllowed = 0.01,
							INP_MaxAllowed = 0.8,
							ICS_ControlPage = "Controls",
						},
						Salida = {
							LINKS_Name = "Duración salida (% del clip, 0 = sin salida)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.1,
							INP_MinScale = 0,
							INP_MaxScale = 0.5,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 0.5,
							ICS_ControlPage = "Controls",
						},
						Glow = {
							LINKS_Name = "Brillo del halo",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.8,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Parpadeo = {
							LINKS_Name = "Fallos de parpadeo",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.3,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						F = {
							LINKS_Name = "Encendido interno",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
						U = {
							LINKS_Name = "Avance interno",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
						Xs = {
							LINKS_Name = "Salida interna",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
					},
				},
			},
		},
		PROTextoNeonAnim = LUTLookup {
			Inputs = {
			},
			CtrlWZoom = false,
		},
	},
	ActiveTool = "PRO_TTL_Texto_Neon"
}
