						Size = Input { Value = 1, Expression = "max(0, (1 + ((1.70158*Viral.Rebote) + 1)*(max(0, min(1, (Viral.U - 0.35)/0.65)) - 1)*(max(0, min(1, (Viral.U - 0.35)/0.65)) - 1)*(max(0, min(1, (Viral.U - 0.35)/0.65)) - 1) + (1.70158*Viral.Rebote)*(max(0, min(1, (Viral.U - 0.35)/0.65)) - 1)*(max(0, min(1, (Viral.U - 0.35)/0.65)) - 1)))", },
