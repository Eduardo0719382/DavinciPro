					Inputs = {
						Input = Input { SourceOp = "M2", Source = "Output", },
						Center = Input { Value = { 0.5, 0.22 }, Expression = "Point(0.5 + iif(Viral.Vertical > 0.5, 0, 0), 0.5 + iif(Viral.Vertical > 0.5, -0.14, -0.28))", },
						Size = Input { Value = 1, Expression = "iif(Viral.Vertical > 0.5, 1.7, 1)", },
					},
					ViewInfo = OperatorInfo { Pos = { 385, 0 } },
				},
