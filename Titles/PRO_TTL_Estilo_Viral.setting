				Input17 = InstanceInput { SourceOp = "Linea1", Source = "Thickness2", Name = "Grosor del contorno", Default = 0.07, },
				Input18 = InstanceInput { SourceOp = "Viral", Source = "Rebote", Name = "Rebote", Default = 1.4, },
				Input19 = InstanceInput { SourceOp = "Viral", Source = "Vertical", Name = "Formato vertical (9:16)", Default = 0, },
				Input20 = InstanceInput { SourceOp = "Viral", Source = "Center", Name = "Posición", },
				Input21 = InstanceInput { SourceOp = "Viral", Source = "Size", Name = "Escala", Default = 1, },
				Input22 = InstanceInput { SourceOp = "Viral", Source = "Entrada", Name = "Duración entrada (% del clip)", Default = 0.12, },
				Input23 = InstanceInput { SourceOp = "Viral", Source = "Salida", Name = "Duración salida (% del clip, 0 = sin salida)", Default = 0.08, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Viral", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Lienzo = Background {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 0, },
						TopLeftGreen = Input { Value = 0, },
						TopLeftBlue = Input { Value = 0, },
						TopLeftAlpha = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -440, 0 } },
				},
				Linea1 = TextPlus {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						Center = Input { Value = { 0.5, 0.5 }, },
						StyledText = Input { Value = "ESTO LO CAMBIA", },
						Font = Input { Value = "Montserrat", },
						Style = Input { Value = "Black", },
						Size = Input { Value = 0.075, Expression = "Viral.TamLinea1*iif(Viral.Vertical > 0.5, 0.3164, 1)", },
						Red1 = Input { Value = 1, },
						Green1 = Input { Value = 1, },
						Blue1 = Input { Value = 1, },
						Enabled2 = Input { Value = 1, },
						Thickness2 = Input { Value = 0.07, },
						OutsideOnly2 = Input { Value = 1, },
