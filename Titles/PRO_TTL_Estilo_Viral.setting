						Salida = Input { Value = 0.08, },
						U = Input { Value = 1, Expression = "max(0, min(1, Viral.Progreso/Viral.Entrada))", },
						Xs = Input { Value = 1, Expression = "(max(0, min(1, (1 - Viral.Progreso)/max(Viral.Salida, 0.0001))))*(max(0, min(1, (1 - Viral.Progreso)/max(Viral.Salida, 0.0001))))*(3-2*(max(0, min(1, (1 - Viral.Progreso)/max(Viral.Salida, 0.0001)))))", },
						Rebote = Input { Value = 1.4, },
						Vertical = Input { Value = 0, },
