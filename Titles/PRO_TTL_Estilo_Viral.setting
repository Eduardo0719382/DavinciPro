						Size = Input { Value = 1, Expression = "max(0, (1 + ((1.70158*Viral.Rebote) + 1)*(max(0, min(1, (Viral.U - 0)/0.55)) - 1)*(max(0, min(1, (Viral.U - 0)/0.55)) - 1)*(max(0, min(1, (Viral.U - 0)/0.55)) - 1) + (1.70158*Viral.Rebote)*(max(0, min(1, (Viral.U - 0)/0.55)) - 1)*(max(0, min(1, (Viral.U - 0)/0.55)) - 1)))", },
					},
