					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" }, },
						LockXY = Input { Value = 0, },
						XBlurSize = Input { Value = 0, Expression = "40*(1 - (max(0, min(1, (Deportivo.U - 0.45)/0.55)))*(max(0, min(1, (Deportivo.U - 0.45)/0.55)))*(3-2*(max(0, min(1, (Deportivo.U - 0.45)/0.55)))))", },
						YBlurSize = Input { Value = 0, },
						Input = Input { SourceOp = "Dato", Source = "Output", },
					},
					ViewInfo = OperatorInfo { Pos = { -330, -99 } },
				},
				Anim1 = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Rafaga1", Source = "Output", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5 - 0.6*(1 - (max(0, min(1, (Deportivo.U - 0.2)/0.5)))*(max(0, min(1, (Deportivo.U - 0.2)/0.5)))*(3-2*(max(0, min(1, (Deportivo.U - 0.2)/0.5))))), 0.5)", },
						Size = Input { Value = 1, Expression = "1", },
					},
					ViewInfo = OperatorInfo { Pos = { -385, -66 } },
				},
				Anim2 = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Rafaga2", Source = "Output", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5 - 0.6*(1 - (max(0, min(1, (Deportivo.U - 0.45)/0.55)))*(max(0, min(1, (Deportivo.U - 0.45)/0.55)))*(3-2*(max(0, min(1, (Deportivo.U - 0.45)/0.55))))), 0.5)", },
						Size = Input { Value = 1, Expression = "1", },
					},
					ViewInfo = OperatorInfo { Pos = { -330, -66 } },
				},
				M1 = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "Lienzo", Source = "Output", },
						Foreground = Input { SourceOp = "Barra", Source = "Output", },
						Blend = Input { Value = 1, Expression = "Deportivo.Xs", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 } },
				},
				M2 = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "M1", Source = "Output", },
						Foreground = Input { SourceOp = "Anim1", Source = "Output", },
						Blend = Input { Value = 1, Expression = "(max(0, min(1, (Deportivo.U - 0.2)/0.3)))*(max(0, min(1, (Deportivo.U - 0.2)/0.3)))*(3-2*(max(0, min(1, (Deportivo.U - 0.2)/0.3))))*Deportivo.Xs", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 165, 0 } },
				},
				M3 = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "M2", Source = "Output", },
						Foreground = Input { SourceOp = "Anim2", Source = "Output", },
						Blend = Input { Value = 1, Expression = "(max(0, min(1, (Deportivo.U - 0.45)/0.35)))*(max(0, min(1, (Deportivo.U - 0.45)/0.35)))*(3-2*(max(0, min(1, (Deportivo.U - 0.45)/0.35))))*Deportivo.Xs", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 220, 0 } },
				},
				Formato = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "M3", Source = "Output", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5, 0.5 + iif(Deportivo.Vertical > 0.5, 0.15, 0))", },
						Size = Input { Value = 1, Expression = "iif(Deportivo.Vertical > 0.5, 1, 1)", },
					},
					ViewInfo = OperatorInfo { Pos = { 385, 0 } },
				},
				Deportivo = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Formato", Source = "Output", },
						Progreso = Input { SourceOp = "PROEstiloDeportivoAnim", Source = "Value", },
						Entrada = Input { Value = 0.2, },
						Salida = Input { Value = 0.1, },
						U = Input { Value = 1, Expression = "max(0, min(1, Deportivo.Progreso/Deportivo.Entrada))", },
						Xs = Input { Value = 1, Expression = "(max(0, min(1, (1 - Deportivo.Progreso)/max(Deportivo.Salida, 0.0001))))*(max(0, min(1, (1 - Deportivo.Progreso)/max(Deportivo.Salida, 0.0001))))*(3-2*(max(0, min(1, (1 - Deportivo.Progreso)/max(Deportivo.Salida, 0.0001)))))", },
						Vertical = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 440, 0 } },
					UserControls = ordered() {
						Progreso = {
							LINKS_Name = "Progreso",
							LINKID_DataType = "Number",
