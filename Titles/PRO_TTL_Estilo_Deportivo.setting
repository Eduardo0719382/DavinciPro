{
	Tools = ordered() {
		PRO_TTL_Estilo_Deportivo = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				Input1 = InstanceInput { SourceOp = "Nombre", Source = "StyledText", Name = "Nombre", },
				Input2 = InstanceInput { SourceOp = "Dato", Source = "StyledText", Name = "Dato", },
				Input3 = InstanceInput { SourceOp = "Nombre", Source = "Font", Name = "Fuente del nombre", ControlGroup = 3, },
				Input4 = InstanceInput { SourceOp = "Nombre", Source = "Style", ControlGroup = 3, },
				Input5 = InstanceInput { SourceOp = "Nombre", Source = "Size", Name = "Tamaño del nombre", Default = 0.11, },
				Input6 = InstanceInput { SourceOp = "Nombre", Source = "Red1", Name = "Color del nombre", ControlGroup = 6, Default = 1, },
				Input7 = InstanceInput { SourceOp = "Nombre", Source = "Green1", ControlGroup = 6, Default = 1, },
				Input8 = InstanceInput { SourceOp = "Nombre", Source = "Blue1", ControlGroup = 6, Default = 1, },
				Input9 = InstanceInput { SourceOp = "Barra", Source = "TopLeftRed", Name = "Color del equipo", ControlGroup = 9, Default = 0.9, },
				Input10 = InstanceInput { SourceOp = "Barra", Source = "TopLeftGreen", ControlGroup = 9, Default = 0.1, },
				Input11 = InstanceInput { SourceOp = "Barra", Source = "TopLeftBlue", ControlGroup = 9, Default = 0.15, },
				Input12 = InstanceInput { SourceOp = "Dato", Source = "Font", Name = "Fuente del dato", ControlGroup = 12, },
				Input13 = InstanceInput { SourceOp = "Dato", Source = "Style", ControlGroup = 12, },
				Input14 = InstanceInput { SourceOp = "Dato", Source = "Size", Name = "Tamaño del dato", Default = 0.045, },
				Input15 = InstanceInput { SourceOp = "Deportivo", Source = "Vertical", Name = "Formato vertical (9:16)", Default = 0, },
				Input16 = InstanceInput { SourceOp = "Deportivo", Source = "Center", Name = "Posición", },
				Input17 = InstanceInput { SourceOp = "Deportivo", Source = "Size", Name = "Escala", Default = 1, },
				Input18 = InstanceInput { SourceOp = "Deportivo", Source = "Entrada", Name = "Duración entrada (% del clip)", Default = 0.2, },
				Input19 = InstanceInput { SourceOp = "Deportivo", Source = "Salida", Name = "Duración salida (% del clip, 0 = sin salida)", Default = 0.1, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Deportivo", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Lienzo = Background {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 0, },
						TopLeftGreen = Input { Value = 0, },
						TopLeftBlue = Input { Value = 0, },
						TopLeftAlpha = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -440, 0 } },
				},
				MascBarra = RectangleMask {
					CtrlWShown = false,
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" }, },
						OutputSize = Input { Value = FuID { "Custom" }, },
						MaskWidth = Input { Value = 1920, },
						MaskHeight = Input { Value = 1080, },
						PixelAspect = Input { Value = { 1, 1 }, },
						UseFrameFormatSettings = Input { Value = 1, },
						ClippingMode = Input { Value = FuID { "None" }, },
						Center = Input { Value = { 0.3, 0.2 }, Expression = "Point(0.06 + 0.25*(max(0, min(1, (Deportivo.U - 0)/0.5)))*(max(0, min(1, (Deportivo.U - 0)/0.5)))*(3-2*(max(0, min(1, (Deportivo.U - 0)/0.5)))), 0.205)", },
						Width = Input { Value = 0.5, Expression = "0.5*(max(0, min(1, (Deportivo.U - 0)/0.5)))*(max(0, min(1, (Deportivo.U - 0)/0.5)))*(3-2*(max(0, min(1, (Deportivo.U - 0)/0.5))))", },
						Height = Input { Value = 0.15, Expression = "0.085*iif(Deportivo.Vertical > 0.5, 0.5625, 1.7778)", },
						Angle = Input { Value = 6, },
					},
					ViewInfo = OperatorInfo { Pos = { -440, -165 } },
				},
				Barra = Background {
					CtrlWShown = false,
					Inputs = {
						EffectMask = Input { SourceOp = "MascBarra", Source = "Mask", },
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 0.9, },
						TopLeftGreen = Input { Value = 0.1, },
						TopLeftBlue = Input { Value = 0.15, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { -440, -132 } },
				},
				Nombre = TextPlus {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						Center = Input { Value = { 0.08, 0.2 }, },
						StyledText = Input { Value = "APELLIDO", },
						Font = Input { Value = "Teko", },
						Style = Input { Value = "SemiBold", },
						Size = Input { Value = 0.11, },
						Red1 = Input { Value = 1, },
						Green1 = Input { Value = 1, },
						Blue1 = Input { Value = 1, },
						HorizontalLeftCenterRight = Input { Value = -1, },
						Enabled4 = Input { Value = 1, },
						ElementShape4 = Input { Value = 0, },
						Offset4 = Input { Value = { 0.006, -0.01 }, },
						Red4 = Input { Value = 0, },
						Green4 = Input { Value = 0, },
						Blue4 = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -385, -132 } },
				},
				Dato = TextPlus {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						Center = Input { Value = { 0.08, 0.125 }, },
						StyledText = Input { Value = "DELANTERO · 25 GOLES", },
						Font = Input { Value = "Teko", },
						Style = Input { Value = "Regular", },
						Size = Input { Value = 0.045, },
						Red1 = Input { Value = 1, Expression = "Barra.TopLeftRed", },
						Green1 = Input { Value = 1, Expression = "Barra.TopLeftGreen", },
						Blue1 = Input { Value = 1, Expression = "Barra.TopLeftBlue", },
						HorizontalLeftCenterRight = Input { Value = -1, },
					},
					ViewInfo = OperatorInfo { Pos = { -330, -132 } },
				},
				Rafaga1 = Blur {
					CtrlWShown = false,
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" }, },
						LockXY = Input { Value = 0, },
						XBlurSize = Input { Value = 0, Expression = "40*(1 - (max(0, min(1, (Deportivo.U - 0.2)/0.5)))*(max(0, min(1, (Deportivo.U - 0.2)/0.5)))*(3-2*(max(0, min(1, (Deportivo.U - 0.2)/0.5)))))", },
						YBlurSize = Input { Value = 0, },
						Input = Input { SourceOp = "Nombre", Source = "Output", },
					},
					ViewInfo = OperatorInfo { Pos = { -385, -99 } },
				},
				Rafaga2 = Blur {
