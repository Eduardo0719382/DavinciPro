{
	Tools = ordered() {
		PRO_TTL_Estilo_Trailer = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				Input1 = InstanceInput { SourceOp = "Titulo", Source = "StyledText", Name = "Título", },
				Input2 = InstanceInput { SourceOp = "Sub", Source = "StyledText", Name = "Subtítulo", },
				Input3 = InstanceInput { SourceOp = "Titulo", Source = "Font", Name = "Fuente del título", ControlGroup = 3, },
				Input4 = InstanceInput { SourceOp = "Titulo", Source = "Style", ControlGroup = 3, },
				Input5 = InstanceInput { SourceOp = "Titulo", Source = "Size", Name = "Tamaño del título", Default = 0.13, },
				Input6 = InstanceInput { SourceOp = "Titulo", Source = "Red1", Name = "Color del título", ControlGroup = 6, Default = 1, },
				Input7 = InstanceInput { SourceOp = "Titulo", Source = "Green1", ControlGroup = 6, Default = 1, },
				Input8 = InstanceInput { SourceOp = "Titulo", Source = "Blue1", ControlGroup = 6, Default = 1, },
				Input9 = InstanceInput { SourceOp = "Sub", Source = "Font", Name = "Fuente del subtítulo", ControlGroup = 9, },
				Input10 = InstanceInput { SourceOp = "Sub", Source = "Style", ControlGroup = 9, },
				Input11 = InstanceInput { SourceOp = "Sub", Source = "Size", Name = "Tamaño del subtítulo", Default = 0.025, },
				Input12 = InstanceInput { SourceOp = "Sub", Source = "Red1", Name = "Color del subtítulo", ControlGroup = 12, Default = 0.8, },
				Input13 = InstanceInput { SourceOp = "Sub", Source = "Green1", ControlGroup = 12, Default = 0.8, },
				Input14 = InstanceInput { SourceOp = "Sub", Source = "Blue1", ControlGroup = 12, Default = 0.8, },
				Input15 = InstanceInput { SourceOp = "Trailer", Source = "Expansion", Name = "Separación de letras durante el clip", Default = 0.15, },
				Input16 = InstanceInput { SourceOp = "Trailer", Source = "Vertical", Name = "Formato vertical (9:16)", Default = 0, },
				Input17 = InstanceInput { SourceOp = "Trailer", Source = "Center", Name = "Posición", },
				Input18 = InstanceInput { SourceOp = "Trailer", Source = "Size", Name = "Escala", Default = 1, },
				Input19 = InstanceInput { SourceOp = "Trailer", Source = "Entrada", Name = "Duración entrada (% del clip)", Default = 0.3, },
				Input20 = InstanceInput { SourceOp = "Trailer", Source = "Salida", Name = "Duración salida (% del clip, 0 = sin salida)", Default = 0.2, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Trailer", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Lienzo = Background {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 0, },
						TopLeftGreen = Input { Value = 0, },
						TopLeftBlue = Input { Value = 0, },
						TopLeftAlpha = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -440, 0 } },
				},
				Titulo = TextPlus {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						Center = Input { Value = { 0.5, 0.5 }, },
						StyledText = Input { Value = "EL ÚLTIMO VIAJE", },
						Font = Input { Value = "Bebas Neue", },
						Style = Input { Value = "Regular", },
						Size = Input { Value = 0.13, },
						Red1 = Input { Value = 1, },
						Green1 = Input { Value = 1, },
						Blue1 = Input { Value = 1, },
						CharacterSpacing = Input { Value = 1, Expression = "1 + Trailer.Expansion*Trailer.Progreso", },
					},
					ViewInfo = OperatorInfo { Pos = { -385, -132 } },
				},
				Sub = TextPlus {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						Center = Input { Value = { 0.5, 0.5 }, },
						StyledText = Input { Value = "PRÓXIMAMENTE", },
						Font = Input { Value = "Montserrat", },
						Style = Input { Value = "Light", },
						Size = Input { Value = 0.025, },
						Red1 = Input { Value = 0.8, },
						Green1 = Input { Value = 0.8, },
						Blue1 = Input { Value = 0.8, },
						CharacterSpacing = Input { Value = 2.2, },
					},
					ViewInfo = OperatorInfo { Pos = { -330, -132 } },
				},
				Enfoque = Blur {
					CtrlWShown = false,
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" }, },
						XBlurSize = Input { Value = 0, Expression = "25*(1 - (max(0, min(1, (Trailer.U - 0)/1)))*(max(0, min(1, (Trailer.U - 0)/1)))*(3-2*(max(0, min(1, (Trailer.U - 0)/1)))))", },
						Input = Input { SourceOp = "Titulo", Source = "Output", },
					},
					ViewInfo = OperatorInfo { Pos = { -385, -99 } },
				},
				Anim1 = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Enfoque", Source = "Output", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5, 0.53)", },
						Size = Input { Value = 1, Expression = "1.06 - 0.06*(max(0, min(1, (Trailer.U - 0)/1)))*(max(0, min(1, (Trailer.U - 0)/1)))*(3-2*(max(0, min(1, (Trailer.U - 0)/1))))", },
					},
					ViewInfo = OperatorInfo { Pos = { -385, -66 } },
				},
				Anim2 = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Sub", Source = "Output", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5, 0.41)", },
						Size = Input { Value = 1, Expression = "1", },
					},
					ViewInfo = OperatorInfo { Pos = { -330, -66 } },
				},
				M1 = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "Lienzo", Source = "Output", },
						Foreground = Input { SourceOp = "Anim1", Source = "Output", },
						Blend = Input { Value = 1, Expression = "(max(0, min(1, (Trailer.U - 0)/1)))*(max(0, min(1, (Trailer.U - 0)/1)))*(3-2*(max(0, min(1, (Trailer.U - 0)/1))))*Trailer.Xs", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 } },
				},
				M2 = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "M1", Source = "Output", },
						Foreground = Input { SourceOp = "Anim2", Source = "Output", },
						Blend = Input { Value = 1, Expression = "(max(0, min(1, (Trailer.U - 0.5)/0.5)))*(max(0, min(1, (Trailer.U - 0.5)/0.5)))*(3-2*(max(0, min(1, (Trailer.U - 0.5)/0.5))))*Trailer.Xs", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 165, 0 } },
				},
				Formato = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "M2", Source = "Output", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5, 0.5 + iif(Trailer.Vertical > 0.5, 0, 0))", },
						Size = Input { Value = 1, Expression = "iif(Trailer.Vertical > 0.5, 0.8, 1)", },
					},
					ViewInfo = OperatorInfo { Pos = { 385, 0 } },
				},
				Trailer = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Formato", Source = "Output", },
						Progreso = Input { SourceOp = "PROEstiloTrailerAnim", Source = "Value", },
						Entrada = Input { Value = 0.3, },
						Salida = Input { Value = 0.2, },
						U = Input { Value = 1, Expression = "max(0, min(1, Trailer.Progreso/Trailer.Entrada))", },
						Xs = Input { Value = 1, Expression = "(max(0, min(1, (1 - Trailer.Progreso)/max(Trailer.Salida, 0.0001))))*(max(0, min(1, (1 - Trailer.Progreso)/max(Trailer.Salida, 0.0001))))*(3-2*(max(0, min(1, (1 - Trailer.Progreso)/max(Trailer.Salida, 0.0001)))))", },
						Expansion = Input { Value = 0.15, },
						Vertical = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 440, 0 } },
					UserControls = ordered() {
						Progreso = {
							LINKS_Name = "Progreso",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Entrada = {
							LINKS_Name = "Duración entrada (% del clip)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.3,
							INP_MinScale = 0.01,
							INP_MaxScale = 0.8,
							INP_MinAllowed = 0.01,
							INP_MaxAllowed = 0.8,
							ICS_ControlPage = "Controls",
						},
						Salida = {
							LINKS_Name = "Duración salida (% del clip, 0 = sin salida)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.2,
							INP_MinScale = 0,
							INP_MaxScale = 0.5,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 0.5,
							ICS_ControlPage = "Controls",
						},
						Expansion = {
							LINKS_Name = "Separación de letras durante el clip",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.15,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Vertical = {
							LINKS_Name = "Formato vertical (9:16)",
							LINKID_DataType = "Number",
							INPID_InputControl = "CheckboxControl",
							INP_Integer = true,
							CBC_TriState = false,
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						U = {
							LINKS_Name = "Avance interno",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
						Xs = {
							LINKS_Name = "Salida interna",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
					},
				},
			},
		},
		PROEstiloTrailerAnim = LUTLookup {
			Inputs = {
			},
			CtrlWZoom = false,
		},
	},
	ActiveTool = "PRO_TTL_Estilo_Trailer"
}
