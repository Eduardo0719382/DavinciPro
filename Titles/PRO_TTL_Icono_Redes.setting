						Input = Input { SourceOp = "Circulo2", Source = "Output", },
						Size = Input { Value = 1, Expression = "max(0, (1 + ((1.70158*Redes.Rebote) + 1)*(max(0, min(1, (Redes.U - 0)/0.4)) - 1)*(max(0, min(1, (Redes.U - 0)/0.4)) - 1)*(max(0, min(1, (Redes.U - 0)/0.4)) - 1) + (1.70158*Redes.Rebote)*(max(0, min(1, (Redes.U - 0)/0.4)) - 1)*(max(0, min(1, (Redes.U - 0)/0.4)) - 1)))", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5 + ((-Redes.Ancho/2) + 0.035)*(1 - max(0, (1 + ((1.70158*Redes.Rebote) + 1)*(max(0, min(1, (Redes.U - 0)/0.4)) - 1)*(max(0, min(1, (Redes.U - 0)/0.4)) - 1)*(max(0, min(1, (Redes.U - 0)/0.4)) - 1) + (1.70158*Redes.Rebote)*(max(0, min(1, (Redes.U - 0)/0.4)) - 1)*(max(0, min(1, (Redes.U - 0)/0.4)) - 1)))), 0.5)", },
