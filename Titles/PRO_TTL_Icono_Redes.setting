						Input = Input { SourceOp = "M3", Source = "Output", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5, 0.5 + iif(Redes.Vertical > 0.5, 0, 0))", },
						Size = Input { Value = 1, Expression = "iif(Redes.Vertical > 0.5, 1, 1)", },
					},
					ViewInfo = OperatorInfo { Pos = { 385, 0 } },
				},
