				Input3 = InstanceInput { SourceOp = "Insignia", Source = "TopLeftRed", Name = "Color del círculo", ControlGroup = 3, Default = 0.95, },
				Input4 = InstanceInput { SourceOp = "Insignia", Source = "TopLeftGreen", ControlGroup = 3, Default = 0.25, },
				Input5 = InstanceInput { SourceOp = "Insignia", Source = "TopLeftBlue", ControlGroup = 3, Default = 0.55, },
				Input6 = InstanceInput { SourceOp = "Pastilla", Source = "TopLeftRed", Name = "Color de la pastilla", ControlGroup = 6, Default = 0.1, },
				Input7 = InstanceInput { SourceOp = "Pastilla", Source = "TopLeftGreen", ControlGroup = 6, Default = 0.1, },
				Input8 = InstanceInput { SourceOp = "Pastilla", Source = "TopLeftBlue", ControlGroup = 6, Default = 0.12, },
				Input9 = InstanceInput { SourceOp = "Redes", Source = "Ancho", Name = "Ancho de la pastilla", Default = 0.36, },
				Input10 = InstanceInput { SourceOp = "Redes", Source = "Rebote", Name = "Rebote", Default = 1.4, },
				Input11 = InstanceInput { SourceOp = "Redes", Source = "Vertical", Name = "Formato vertical (9:16)", Default = 0, },
