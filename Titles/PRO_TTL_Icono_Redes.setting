				Input14 = InstanceInput { SourceOp = "Redes", Source = "Entrada", Name = "Duración entrada (% del clip)", Default = 0.3, },
				Input15 = InstanceInput { SourceOp = "Redes", Source = "Salida", Name = "Duración salida (% del clip, 0 = sin salida)", Default = 0.1, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Redes", Source = "Output", },
