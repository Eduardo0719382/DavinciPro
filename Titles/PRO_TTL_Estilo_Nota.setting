{
	Tools = ordered() {
		PRO_TTL_Estilo_Nota = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				Input1 = InstanceInput { SourceOp = "Texto", Source = "StyledText", Name = "Texto", },
				Input2 = InstanceInput { SourceOp = "Texto", Source = "Font", Name = "Fuente", ControlGroup = 2, },
				Input3 = InstanceInput { SourceOp = "Texto", Source = "Style", ControlGroup = 2, },
				Input4 = InstanceInput { SourceOp = "Texto", Source = "Size", Name = "Tamaño", Default = 0.075, },
				Input5 = InstanceInput { SourceOp = "Texto", Source = "Red1", Name = "Color", ControlGroup = 5, Default = 1, },
				Input6 = InstanceInput { SourceOp = "Texto", Source = "Green1", ControlGroup = 5, Default = 1, },
				Input7 = InstanceInput { SourceOp = "Texto", Source = "Blue1", ControlGroup = 5, Default = 1, },
				Input8 = InstanceInput { SourceOp = "Raya", Source = "TopLeftRed", Name = "Color del subrayado", ControlGroup = 8, Default = 1, },
				Input9 = InstanceInput { SourceOp = "Raya", Source = "TopLeftGreen", ControlGroup = 8, Default = 0.85, },
				Input10 = InstanceInput { SourceOp = "Raya", Source = "TopLeftBlue", ControlGroup = 8, Default = 0.1, },
				Input11 = InstanceInput { SourceOp = "Nota", Source = "Ancho", Name = "Ancho del subrayado", Default = 0.36, },
				Input12 = InstanceInput { SourceOp = "Nota", Source = "Vaiven", Name = "Vaivén", Default = 1, },
				Input13 = InstanceInput { SourceOp = "Nota", Source = "Vertical", Name = "Formato vertical (9:16)", Default = 0, },
				Input14 = InstanceInput { SourceOp = "Nota", Source = "Center", Name = "Posición", },
				Input15 = InstanceInput { SourceOp = "Nota", Source = "Size", Name = "Escala", Default = 1, },
				Input16 = InstanceInput { SourceOp = "Nota", Source = "Entrada", Name = "Duración entrada (% del clip)", Default = 0.3, },
				Input17 = InstanceInput { SourceOp = "Nota", Source = "Salida", Name = "Duración salida (% del clip, 0 = sin salida)", Default = 0.12, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Nota", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Lienzo = Background {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 0, },
						TopLeftGreen = Input { Value = 0, },
						TopLeftBlue = Input { Value = 0, },
						TopLeftAlpha = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -440, 0 } },
				},
				Texto = TextPlus {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						Center = Input { Value = { 0.5, 0.5 }, },
						StyledText = Input { Value = "nota rápida :)", },
						Font = Input { Value = "Ink Free", },
						Style = Input { Value = "Regular", },
						Size = Input { Value = 0.075, },
						Red1 = Input { Value = 1, },
						Green1 = Input { Value = 1, },
						Blue1 = Input { Value = 1, },
						Enabled8 = Input { Value = 1, },
						Softness8 = Input { Value = 1, },
						SoftnessX8 = Input { Value = 3, },
						SoftnessY8 = Input { Value = 3, },
						Offset8 = Input { Value = { 0.003, -0.005 }, },
						Red8 = Input { Value = 0, },
						Green8 = Input { Value = 0, },
						Blue8 = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -385, -132 } },
				},
				Anim1 = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Texto", Source = "Output", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5, 0.52 - 0.02*(1 - (max(0, min(1, (Nota.U - 0)/0.5)))*(max(0, min(1, (Nota.U - 0)/0.5)))*(3-2*(max(0, min(1, (Nota.U - 0)/0.5))))))", },
						Size = Input { Value = 1, Expression = "1", },
						Angle = Input { Value = 0, Expression = "Nota.Vaiven*1.5*sin(time*0.12)", },
					},
					ViewInfo = OperatorInfo { Pos = { -385, -66 } },
				},
				MascRaya = RectangleMask {
					CtrlWShown = false,
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" }, },
						OutputSize = Input { Value = FuID { "Custom" }, },
						MaskWidth = Input { Value = 1920, },
						MaskHeight = Input { Value = 1080, },
						PixelAspect = Input { Value = { 1, 1 }, },
						UseFrameFormatSettings = Input { Value = 1, },
						ClippingMode = Input { Value = FuID { "None" }, },
						Center = Input { Value = { 0.32, 0.455 }, Expression = "Point(0.5 - Nota.Ancho/2 + Nota.Ancho*(max(0, min(1, (Nota.U - 0.3)/0.7)))*(max(0, min(1, (Nota.U - 0.3)/0.7)))*(3-2*(max(0, min(1, (Nota.U - 0.3)/0.7))))/2, 0.455)", },
						Width = Input { Value = 0, Expression = "Nota.Ancho*(max(0, min(1, (Nota.U - 0.3)/0.7)))*(max(0, min(1, (Nota.U - 0.3)/0.7)))*(3-2*(max(0, min(1, (Nota.U - 0.3)/0.7))))", },
						Height = Input { Value = 0.018, Expression = "0.01*iif(Nota.Vertical > 0.5, 0.5625, 1.7778)", },
						Angle = Input { Value = -2, },
						CornerRadius = Input { Value = 0.5, },
					},
					ViewInfo = OperatorInfo { Pos = { -330, -165 } },
				},
				Raya = Background {
					CtrlWShown = false,
					Inputs = {
						EffectMask = Input { SourceOp = "MascRaya", Source = "Mask", },
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 1, },
						TopLeftGreen = Input { Value = 0.85, },
						TopLeftBlue = Input { Value = 0.1, },
						TopLeftAlpha = Input { Value = 0.85, },
					},
					ViewInfo = OperatorInfo { Pos = { -330, -132 } },
				},
				M1 = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "Lienzo", Source = "Output", },
						Foreground = Input { SourceOp = "Raya", Source = "Output", },
						Blend = Input { Value = 1, Expression = "Nota.Xs", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 } },
				},
				M2 = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "M1", Source = "Output", },
						Foreground = Input { SourceOp = "Anim1", Source = "Output", },
						Blend = Input { Value = 1, Expression = "(max(0, min(1, (Nota.U - 0)/0.5)))*(max(0, min(1, (Nota.U - 0)/0.5)))*(3-2*(max(0, min(1, (Nota.U - 0)/0.5))))*Nota.Xs", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 165, 0 } },
				},
				Formato = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "M2", Source = "Output", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5, 0.5 + iif(Nota.Vertical > 0.5, 0.05, 0))", },
						Size = Input { Value = 1, Expression = "iif(Nota.Vertical > 0.5, 1, 1)", },
					},
					ViewInfo = OperatorInfo { Pos = { 385, 0 } },
				},
				Nota = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Formato", Source = "Output", },
						Progreso = Input { SourceOp = "PROEstiloNotaAnim", Source = "Value", },
						Entrada = Input { Value = 0.3, },
						Salida = Input { Value = 0.12, },
						U = Input { Value = 1, Expression = "max(0, min(1, Nota.Progreso/Nota.Entrada))", },
						Xs = Input { Value = 1, Expression = "(max(0, min(1, (1 - Nota.Progreso)/max(Nota.Salida, 0.0001))))*(max(0, min(1, (1 - Nota.Progreso)/max(Nota.Salida, 0.0001))))*(3-2*(max(0, min(1, (1 - Nota.Progreso)/max(Nota.Salida, 0.0001)))))", },
						Ancho = Input { Value = 0.36, },
						Vaiven = Input { Value = 1, },
						Vertical = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 440, 0 } },
					UserControls = ordered() {
						Progreso = {
							LINKS_Name = "Progreso",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Entrada = {
							LINKS_Name = "Duración entrada (% del clip)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.3,
							INP_MinScale = 0.01,
							INP_MaxScale = 0.8,
							INP_MinAllowed = 0.01,
							INP_MaxAllowed = 0.8,
							ICS_ControlPage = "Controls",
						},
						Salida = {
							LINKS_Name = "Duración salida (% del clip, 0 = sin salida)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.12,
							INP_MinScale = 0,
							INP_MaxScale = 0.5,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 0.5,
							ICS_ControlPage = "Controls",
						},
						Ancho = {
							LINKS_Name = "Ancho del subrayado",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.36,
							INP_MinScale = 0.02,
							INP_MaxScale = 1,
							INP_MinAllowed = 0.02,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Vaiven = {
							LINKS_Name = "Vaivén",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 5,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 5,
							ICS_ControlPage = "Controls",
						},
						Vertical = {
							LINKS_Name = "Formato vertical (9:16)",
							LINKID_DataType = "Number",
							INPID_InputControl = "CheckboxControl",
							INP_Integer = true,
							CBC_TriState = false,
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						U = {
							LINKS_Name = "Avance interno",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
						Xs = {
							LINKS_Name = "Salida interna",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
					},
				},
			},
		},
		PROEstiloNotaAnim = LUTLookup {
			Inputs = {
			},
			CtrlWZoom = false,
