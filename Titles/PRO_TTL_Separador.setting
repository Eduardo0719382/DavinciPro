{
	Tools = ordered() {
		PRO_TTL_Separador = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				Input1 = InstanceInput { SourceOp = "Texto", Source = "StyledText", Name = "Texto (vacío = solo línea)", },
				Input2 = InstanceInput { SourceOp = "Separador", Source = "Largo", Name = "Largo", Default = 0.4, },
				Input3 = InstanceInput { SourceOp = "Linea", Source = "TopLeftRed", Name = "Color de la línea", ControlGroup = 3, Default = 1, },
				Input4 = InstanceInput { SourceOp = "Linea", Source = "TopLeftGreen", ControlGroup = 3, Default = 1, },
				Input5 = InstanceInput { SourceOp = "Linea", Source = "TopLeftBlue", ControlGroup = 3, Default = 1, },
				Input6 = InstanceInput { SourceOp = "Texto", Source = "Red1", Name = "Color del texto", ControlGroup = 6, Default = 1, },
				Input7 = InstanceInput { SourceOp = "Texto", Source = "Green1", ControlGroup = 6, Default = 1, },
				Input8 = InstanceInput { SourceOp = "Texto", Source = "Blue1", ControlGroup = 6, Default = 1, },
				Input9 = InstanceInput { SourceOp = "Separador", Source = "Center", Name = "Posición", },
				Input10 = InstanceInput { SourceOp = "Separador", Source = "Size", Name = "Escala", Default = 1, },
				Input11 = InstanceInput { SourceOp = "Separador", Source = "Entrada", Name = "Duración entrada (% del clip)", Default = 0.25, },
				Input12 = InstanceInput { SourceOp = "Separador", Source = "Salida", Name = "Duración salida (% del clip, 0 = sin salida)", Default = 0.12, },
			},
			Outputs = {
