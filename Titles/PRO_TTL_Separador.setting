						Green1 = Input { Value = 1, },
						Blue1 = Input { Value = 1, },
						CharacterSpacing = Input { Value = 1.5, },
					},
					ViewInfo = OperatorInfo { Pos = { -275, -99 } },
				},
				M1 = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "Lienzo", Source = "Output", },
						Foreground = Input { SourceOp = "Linea", Source = "Output", },
						Blend = Input { Value = 1, Expression = "Separador.Xs", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 } },
				},
				M2 = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "M1", Source = "Output", },
						Foreground = Input { SourceOp = "Puntos", Source = "Output", },
						Blend = Input { Value = 1, Expression = "(max(0, min(1, (Separador.U - 0)/0.3)))*(max(0, min(1, (Separador.U - 0)/0.3)))*(3-2*(max(0, min(1, (Separador.U - 0)/0.3))))*Separador.Xs", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 165, 0 } },
				},
				M3 = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "M2", Source = "Output", },
						Foreground = Input { SourceOp = "Texto", Source = "Output", },
						Blend = Input { Value = 1, Expression = "(max(0, min(1, (Separador.U - 0.5)/0.5)))*(max(0, min(1, (Separador.U - 0.5)/0.5)))*(3-2*(max(0, min(1, (Separador.U - 0.5)/0.5))))*Separador.Xs", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 220, 0 } },
				},
				Separador = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "M3", Source = "Output", },
						Progreso = Input { SourceOp = "PROSeparadorAnim", Source = "Value", },
						Entrada = Input { Value = 0.25, },
						Salida = Input { Value = 0.12, },
						U = Input { Value = 1, Expression = "max(0, min(1, Separador.Progreso/Separador.Entrada))", },
						Xs = Input { Value = 1, Expression = "(max(0, min(1, (1 - Separador.Progreso)/max(Separador.Salida, 0.0001))))*(max(0, min(1, (1 - Separador.Progreso)/max(Separador.Salida, 0.0001))))*(3-2*(max(0, min(1, (1 - Separador.Progreso)/max(Separador.Salida, 0.0001)))))", },
						Largo = Input { Value = 0.4, },
					},
					ViewInfo = OperatorInfo { Pos = { 440, 0 } },
					UserControls = ordered() {
						Progreso = {
							LINKS_Name = "Progreso",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
