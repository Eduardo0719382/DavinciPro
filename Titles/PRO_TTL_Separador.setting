							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
					},
				},
			},
		},
		PROSeparadorAnim = LUTLookup {
