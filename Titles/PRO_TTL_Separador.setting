					},
					ViewInfo = OperatorInfo { Pos = { -275, -132 } },
				},
				Linea = Background {
					CtrlWShown = false,
					Inputs = {
						EffectMask = Input { SourceOp = "MascLinea", Source = "Mask", },
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 1, },
						TopLeftGreen = Input { Value = 1, },
						TopLeftBlue = Input { Value = 1, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { -385, -99 } },
				},
				Puntos = Background {
					CtrlWShown = false,
					Inputs = {
						EffectMask = Input { SourceOp = "MascDer", Source = "Mask", },
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 1, Expression = "Linea.TopLeftRed", },
						TopLeftGreen = Input { Value = 1, Expression = "Linea.TopLeftGreen", },
						TopLeftBlue = Input { Value = 1, Expression = "Linea.TopLeftBlue", },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { -330, -99 } },
				},
				Texto = TextPlus {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						Center = Input { Value = { 0.5, 0.54 }, },
						StyledText = Input { Value = "CAPÍTULO UNO", },
						Font = Input { Value = "Arial", },
						Style = Input { Value = "Regular", },
						Size = Input { Value = 0.03, },
