							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Entrada = {
							LINKS_Name = "Duración entrada (% del clip)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.25,
							INP_MinScale = 0.01,
							INP_MaxScale = 0.8,
							INP_MinAllowed = 0.01,
							INP_MaxAllowed = 0.8,
							ICS_ControlPage = "Controls",
						},
						Salida = {
							LINKS_Name = "Duración salida (% del clip, 0 = sin salida)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.12,
							INP_MinScale = 0,
							INP_MaxScale = 0.5,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 0.5,
							ICS_ControlPage = "Controls",
						},
						Largo = {
							LINKS_Name = "Largo",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.4,
							INP_MinScale = 0.02,
							INP_MaxScale = 1,
							INP_MinAllowed = 0.02,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						U = {
