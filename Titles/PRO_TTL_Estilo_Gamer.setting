{
	Tools = ordered() {
		PRO_TTL_Estilo_Gamer = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				Input1 = InstanceInput { SourceOp = "Titulo", Source = "StyledText", Name = "Título", },
				Input2 = InstanceInput { SourceOp = "Sub", Source = "StyledText", Name = "Texto que parpadea", },
				Input3 = InstanceInput { SourceOp = "Titulo", Source = "Font", Name = "Fuente del título", ControlGroup = 3, },
				Input4 = InstanceInput { SourceOp = "Titulo", Source = "Style", ControlGroup = 3, },
				Input5 = InstanceInput { SourceOp = "Gamer", Source = "TamTitulo", Name = "Tamaño del título", Default = 0.06, },
				Input6 = InstanceInput { SourceOp = "Titulo", Source = "Red1", Name = "Color del título", ControlGroup = 6, Default = 0.3, },
				Input7 = InstanceInput { SourceOp = "Titulo", Source = "Green1", ControlGroup = 6, Default = 1, },
				Input8 = InstanceInput { SourceOp = "Titulo", Source = "Blue1", ControlGroup = 6, Default = 0.35, },
				Input9 = InstanceInput { SourceOp = "Sub", Source = "Font", Name = "Fuente del parpadeo", ControlGroup = 9, },
				Input10 = InstanceInput { SourceOp = "Sub", Source = "Style", ControlGroup = 9, },
				Input11 = InstanceInput { SourceOp = "Gamer", Source = "TamSub", Name = "Tamaño del parpadeo", Default = 0.025, },
				Input12 = InstanceInput { SourceOp = "Sub", Source = "Red1", Name = "Color del parpadeo", ControlGroup = 12, Default = 1, },
				Input13 = InstanceInput { SourceOp = "Sub", Source = "Green1", ControlGroup = 12, Default = 1, },
				Input14 = InstanceInput { SourceOp = "Sub", Source = "Blue1", ControlGroup = 12, Default = 1, },
				Input15 = InstanceInput { SourceOp = "Gamer", Source = "Vertical", Name = "Formato vertical (9:16)", Default = 0, },
				Input16 = InstanceInput { SourceOp = "Gamer", Source = "Center", Name = "Posición", },
				Input17 = InstanceInput { SourceOp = "Gamer", Source = "Size", Name = "Escala", Default = 1, },
				Input18 = InstanceInput { SourceOp = "Gamer", Source = "Entrada", Name = "Duración entrada (% del clip)", Default = 0.2, },
				Input19 = InstanceInput { SourceOp = "Gamer", Source = "Salida", Name = "Duración salida (% del clip, 0 = sin salida)", Default = 0.05, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Gamer", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Lienzo = Background {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 0, },
						TopLeftGreen = Input { Value = 0, },
						TopLeftBlue = Input { Value = 0, },
						TopLeftAlpha = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -440, 0 } },
				},
				Titulo = TextPlus {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						Center = Input { Value = { 0.5, 0.5 }, },
						StyledText = Input { Value = "NIVEL 1", },
						Font = Input { Value = "Press Start 2P", },
						Style = Input { Value = "Regular", },
						Size = Input { Value = 0.06, Expression = "Gamer.TamTitulo*iif(Gamer.Vertical > 0.5, 0.3164, 1)", },
						Red1 = Input { Value = 0.3, },
						Green1 = Input { Value = 1, },
						Blue1 = Input { Value = 0.35, },
						Enabled4 = Input { Value = 1, },
						ElementShape4 = Input { Value = 0, },
						Offset4 = Input { Value = { 0.005, -0.008 }, },
						Red4 = Input { Value = 0, },
						Green4 = Input { Value = 0, },
						Blue4 = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -385, -132 } },
				},
				Sub = TextPlus {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						Center = Input { Value = { 0.5, 0.5 }, },
						StyledText = Input { Value = "PRESS START", },
						Font = Input { Value = "Press Start 2P", },
						Style = Input { Value = "Regular", },
						Size = Input { Value = 0.025, Expression = "Gamer.TamSub*iif(Gamer.Vertical > 0.5, 0.3164, 1)", },
						Red1 = Input { Value = 1, },
						Green1 = Input { Value = 1, },
						Blue1 = Input { Value = 1, },
						Enabled4 = Input { Value = 1, },
						ElementShape4 = Input { Value = 0, },
						Offset4 = Input { Value = { 0.003, -0.005 }, },
						Red4 = Input { Value = 0, },
						Green4 = Input { Value = 0, },
						Blue4 = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -330, -132 } },
				},
				Anim1 = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Titulo", Source = "Output", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5, 0.5 + ((0.54) - 0.5)*iif(Gamer.Vertical > 0.5, 0.3164, 1))", },
						Size = Input { Value = 1, Expression = "floor(4*max(0, min(1, Gamer.U/0.6)) + 0.0001)/4", },
					},
					ViewInfo = OperatorInfo { Pos = { -385, -66 } },
				},
				Anim2 = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Sub", Source = "Output", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5, 0.5 + ((0.43) - 0.5)*iif(Gamer.Vertical > 0.5, 0.3164, 1))", },
						Size = Input { Value = 1, Expression = "1", },
					},
					ViewInfo = OperatorInfo { Pos = { -330, -66 } },
				},
				M1 = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "Lienzo", Source = "Output", },
						Foreground = Input { SourceOp = "Anim1", Source = "Output", },
						Blend = Input { Value = 1, Expression = "Gamer.Xs*iif(Gamer.U > 0, 1, 0)", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 } },
				},
				M2 = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "M1", Source = "Output", },
						Foreground = Input { SourceOp = "Anim2", Source = "Output", },
						Blend = Input { Value = 1, Expression = "Gamer.Xs*iif(Gamer.U >= 1, 1, 0)*iif(sin(time*0.3) > 0, 1, 0)", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 165, 0 } },
				},
				Formato = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "M2", Source = "Output", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5 + iif(Gamer.Vertical > 0.5, 0, 0), 0.5 + iif(Gamer.Vertical > 0.5, 0, 0))", },
						Size = Input { Value = 1, Expression = "iif(Gamer.Vertical > 0.5, 2.2, 1)", },
					},
					ViewInfo = OperatorInfo { Pos = { 385, 0 } },
				},
				Gamer = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Formato", Source = "Output", },
						Progreso = Input { SourceOp = "PROEstiloGamerAnim", Source = "Value", },
						Entrada = Input { Value = 0.2, },
						Salida = Input { Value = 0.05, },
						U = Input { Value = 1, Expression = "max(0, min(1, Gamer.Progreso/Gamer.Entrada))", },
						Xs = Input { Value = 1, Expression = "(max(0, min(1, (1 - Gamer.Progreso)/max(Gamer.Salida, 0.0001))))*(max(0, min(1, (1 - Gamer.Progreso)/max(Gamer.Salida, 0.0001))))*(3-2*(max(0, min(1, (1 - Gamer.Progreso)/max(Gamer.Salida, 0.0001)))))", },
						Vertical = Input { Value = 0, },
						TamTitulo = Input { Value = 0.06, },
						TamSub = Input { Value = 0.025, },
					},
					ViewInfo = OperatorInfo { Pos = { 440, 0 } },
					UserControls = ordered() {
						Progreso = {
							LINKS_Name = "Progreso",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Entrada = {
							LINKS_Name = "Duración entrada (% del clip)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.2,
							INP_MinScale = 0.01,
							INP_MaxScale = 0.8,
							INP_MinAllowed = 0.01,
							INP_MaxAllowed = 0.8,
							ICS_ControlPage = "Controls",
						},
						Salida = {
							LINKS_Name = "Duración salida (% del clip, 0 = sin salida)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.05,
							INP_MinScale = 0,
							INP_MaxScale = 0.5,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 0.5,
							ICS_ControlPage = "Controls",
						},
						Vertical = {
							LINKS_Name = "Formato vertical (9:16)",
							LINKID_DataType = "Number",
							INPID_InputControl = "CheckboxControl",
							INP_Integer = true,
							CBC_TriState = false,
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						TamTitulo = {
							LINKS_Name = "Tamaño Titulo",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.06,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
						TamSub = {
							LINKS_Name = "Tamaño Sub",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.025,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
						U = {
							LINKS_Name = "Avance interno",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
						Xs = {
							LINKS_Name = "Salida interna",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
					},
				},
			},
		},
		PROEstiloGamerAnim = LUTLookup {
			Inputs = {
			},
			CtrlWZoom = false,
		},
	},
	ActiveTool = "PRO_TTL_Estilo_Gamer"
}
