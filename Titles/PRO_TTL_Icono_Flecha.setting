						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5 + Flecha.Recorrido*sin(time*0.25)*sin((Flecha.Angulo*3.14159265/180)), 0.5 - Flecha.Recorrido*sin(time*0.25)*cos((Flecha.Angulo*3.14159265/180))*iif(Flecha.Vertical > 0.5, 0.5625, 1.7778))", },
