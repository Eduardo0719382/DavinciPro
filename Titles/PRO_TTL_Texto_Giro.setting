						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5 + iif(Giro.Vertical > 0.5, 0, 0), 0.5 + iif(Giro.Vertical > 0.5, 0, 0))", },
						Size = Input { Value = 1, Expression = "iif(Giro.Vertical > 0.5, 1.7, 1)", },
					},
					ViewInfo = OperatorInfo { Pos = { 385, 0 } },
