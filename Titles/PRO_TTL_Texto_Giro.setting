{
	Tools = ordered() {
		PRO_TTL_Texto_Giro = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				Input1 = InstanceInput { SourceOp = "Texto1", Source = "StyledText", Name = "Línea 1", },
				Input2 = InstanceInput { SourceOp = "Texto2", Source = "StyledText", Name = "Línea 2", },
				Input3 = InstanceInput { SourceOp = "Texto1", Source = "Font", Name = "Fuente de la línea 1", ControlGroup = 3, },
				Input4 = InstanceInput { SourceOp = "Texto1", Source = "Style", ControlGroup = 3, },
				Input5 = InstanceInput { SourceOp = "Giro", Source = "TamTexto1", Name = "Tamaño de la línea 1", Default = 0.06, },
				Input6 = InstanceInput { SourceOp = "Texto1", Source = "Red1", Name = "Color de la línea 1", ControlGroup = 6, Default = 1, },
				Input7 = InstanceInput { SourceOp = "Texto1", Source = "Green1", ControlGroup = 6, Default = 1, },
				Input8 = InstanceInput { SourceOp = "Texto1", Source = "Blue1", ControlGroup = 6, Default = 1, },
				Input9 = InstanceInput { SourceOp = "Texto2", Source = "Font", Name = "Fuente de la línea 2", ControlGroup = 9, },
				Input10 = InstanceInput { SourceOp = "Texto2", Source = "Style", ControlGroup = 9, },
				Input11 = InstanceInput { SourceOp = "Giro", Source = "TamTexto2", Name = "Tamaño de la línea 2", Default = 0.09, },
