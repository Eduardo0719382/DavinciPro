						Green8 = Input { Value = 0, },
						Blue8 = Input { Value = 0, },
						Alpha8 = Input { Value = 0.25, },
					},
					ViewInfo = OperatorInfo { Pos = { -385, -198 } },
				},
				Texto2 = TextPlus {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						Center = Input { Value = { 0.5, 0.45 }, Expression = "Point(0.5, 0.5 + ((0.45) - 0.5)*iif(Giro.Vertical > 0.5, 0.3164, 1))", },
						StyledText = Input { Value = "ABRIR PASO", },
						Font = Input { Value = "Inter 24pt", },
						Style = Input { Value = "Black", },
						Size = Input { Value = 0.09, Expression = "Giro.TamTexto2*iif(Giro.Vertical > 0.5, 0.3164, 1)", },
						Red1 = Input { Value = 1, },
						Green1 = Input { Value = 0.85, },
						Blue1 = Input { Value = 0.15, },
						Enabled8 = Input { Value = 1, },
						Softness8 = Input { Value = 1, },
						SoftnessX8 = Input { Value = 6, },
						SoftnessY8 = Input { Value = 6, },
						Offset8 = Input { Value = { 0.003, -0.008 }, },
						Red8 = Input { Value = 0, },
						Green8 = Input { Value = 0, },
						Blue8 = Input { Value = 0, },
						Alpha8 = Input { Value = 0.25, },
					},
					ViewInfo = OperatorInfo { Pos = { -330, -198 } },
				},
				Mece1 = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Texto1", Source = "Output", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5, 0.5 + ((0.5) - 0.5)*iif(Giro.Vertical > 0.5, 0.3164, 1))", },
						Size = Input { Value = 1, Expression = "max(0, (1 + ((1.70158*Giro.Rebote) + 1)*(max(0, min(1, (Giro.U - 0)/0.6)) - 1)*(max(0, min(1, (Giro.U - 0)/0.6)) - 1)*(max(0, min(1, (Giro.U - 0)/0.6)) - 1) + (1.70158*Giro.Rebote)*(max(0, min(1, (Giro.U - 0)/0.6)) - 1)*(max(0, min(1, (Giro.U - 0)/0.6)) - 1)))*(1 + 0.02*Giro.Respira*sin(2*(time*2*3.14159265/Giro.Periodo)))", },
						Angle = Input { Value = 0, Expression = "Giro.Angulo*sin((time*2*3.14159265/Giro.Periodo))", },
						Pivot = Input { Value = { 0.5, 0.55 }, Expression = "Point(0.5, 0.5 + (0.55 - 0.5)*iif(Giro.Vertical > 0.5, 0.3164, 1))", },
					},
					ViewInfo = OperatorInfo { Pos = { -385, -132 } },
				},
				Mece2 = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Texto2", Source = "Output", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5, 0.5 + ((0.5) - 0.5)*iif(Giro.Vertical > 0.5, 0.3164, 1))", },
						Size = Input { Value = 1, Expression = "max(0, (1 + ((1.70158*Giro.Rebote) + 1)*(max(0, min(1, (Giro.U - 0.3)/0.7)) - 1)*(max(0, min(1, (Giro.U - 0.3)/0.7)) - 1)*(max(0, min(1, (Giro.U - 0.3)/0.7)) - 1) + (1.70158*Giro.Rebote)*(max(0, min(1, (Giro.U - 0.3)/0.7)) - 1)*(max(0, min(1, (Giro.U - 0.3)/0.7)) - 1)))*(1 + 0.02*Giro.Respira*sin(2*(time*2*3.14159265/Giro.Periodo) + 1))", },
						Angle = Input { Value = 0, Expression = "-Giro.Angulo*sin((time*2*3.14159265/Giro.Periodo) + 0.8)", },
						Pivot = Input { Value = { 0.5, 0.45 }, Expression = "Point(0.5, 0.5 + (0.45 - 0.5)*iif(Giro.Vertical > 0.5, 0.3164, 1))", },
