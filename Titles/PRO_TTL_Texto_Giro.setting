				Input13 = InstanceInput { SourceOp = "Texto2", Source = "Green1", ControlGroup = 12, Default = 0.85, },
				Input14 = InstanceInput { SourceOp = "Texto2", Source = "Blue1", ControlGroup = 12, Default = 0.15, },
				Input15 = InstanceInput { SourceOp = "Giro", Source = "Angulo", Name = "Giro (grados)", Default = 4, },
				Input16 = InstanceInput { SourceOp = "Giro", Source = "Periodo", Name = "Fotogramas por vaivén", Default = 50, },
				Input17 = InstanceInput { SourceOp = "Giro", Source = "Respira", Name = "Respiración", Default = 1, },
				Input18 = InstanceInput { SourceOp = "Giro", Source = "Vertical", Name = "Formato vertical (9:16)", Default = 0, },
				Input19 = InstanceInput { SourceOp = "Giro", Source = "Center", Name = "Posición", },
				Input20 = InstanceInput { SourceOp = "Giro", Source = "Size", Name = "Escala", Default = 1, },
				Input21 = InstanceInput { SourceOp = "Giro", Source = "Entrada", Name = "Duración entrada (% del clip)", Default = 0.12, },
				Input22 = InstanceInput { SourceOp = "Giro", Source = "Salida", Name = "Duración salida (% del clip, 0 = sin salida)", Default = 0.08, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Giro", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Lienzo = Background {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 0, },
						TopLeftGreen = Input { Value = 0, },
						TopLeftBlue = Input { Value = 0, },
						TopLeftAlpha = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -440, 0 } },
				},
				Texto1 = TextPlus {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						Center = Input { Value = { 0.5, 0.55 }, Expression = "Point(0.5, 0.5 + ((0.55) - 0.5)*iif(Giro.Vertical > 0.5, 0.3164, 1))", },
						StyledText = Input { Value = "NO TE VAN A", },
						Font = Input { Value = "Inter 24pt", },
						Style = Input { Value = "ExtraBold", },
						Size = Input { Value = 0.06, Expression = "Giro.TamTexto1*iif(Giro.Vertical > 0.5, 0.3164, 1)", },
