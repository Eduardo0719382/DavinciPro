{
	Tools = ordered() {
		PRO_TTL_Social_TextoPop = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				Input1 = InstanceInput { SourceOp = "Texto", Source = "StyledText", Name = "Texto", },
				Input2 = InstanceInput { SourceOp = "Texto", Source = "Font", Name = "Fuente", ControlGroup = 2, },
				Input3 = InstanceInput { SourceOp = "Texto", Source = "Style", ControlGroup = 2, },
				Input4 = InstanceInput { SourceOp = "Pop", Source = "TamTexto", Name = "Tamaño", Default = 0.09, },
				Input5 = InstanceInput { SourceOp = "Texto", Source = "Red1", Name = "Color", ControlGroup = 5, Default = 1, },
				Input6 = InstanceInput { SourceOp = "Texto", Source = "Green1", ControlGroup = 5, Default = 1, },
				Input7 = InstanceInput { SourceOp = "Texto", Source = "Blue1", ControlGroup = 5, Default = 1, },
				Input8 = InstanceInput { SourceOp = "Posicion", Source = "Center", Name = "Posición", },
				Input9 = InstanceInput { SourceOp = "Pop", Source = "Rebote", Name = "Rebote", Default = 1.2, },
				Input10 = InstanceInput { SourceOp = "Pop", Source = "Entrada", Name = "Duración entrada (% del clip)", Default = 0.15, },
				Input11 = InstanceInput { SourceOp = "Pop", Source = "Salida", Name = "Duración salida (% del clip)", Default = 0.1, },
				Input12 = InstanceInput { SourceOp = "Pop", Source = "Vertical", Name = "Formato vertical (9:16)", Default = 0, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Posicion", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Lienzo = Background {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 0, },
						TopLeftGreen = Input { Value = 0, },
						TopLeftBlue = Input { Value = 0, },
						TopLeftAlpha = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -220, -66 } },
				},
				Texto = TextPlus {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						StyledText = Input { Value = "TU TEXTO AQUÍ", },
						Font = Input { Value = "Arial", },
						Style = Input { Value = "Bold", },
						Size = Input { Value = 0.09, Expression = "Pop.TamTexto*iif(Pop.Vertical > 0.5, 0.6961, 1)", },
						Red1 = Input { Value = 1, },
						Green1 = Input { Value = 1, },
						Blue1 = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { -220, 0 } },
				},
				Escala = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Texto", Source = "Output", },
						Size = Input { Value = 1, Expression = "max(0, 0.6 + 0.4*Pop.E)", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5, 0.5 - 0.04*(1 - Pop.E))", },
					},
					ViewInfo = OperatorInfo { Pos = { -110, 0 } },
				},
				Pop = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "Lienzo", Source = "Output", },
						Foreground = Input { SourceOp = "Escala", Source = "Output", },
						Blend = Input { Value = 1, Expression = "min(1, 2*Pop.T)", },
						PerformDepthMerge = Input { Value = 0, },
						Progreso = Input { SourceOp = "PROSocialTextoPopAnim", Source = "Value", },
						Entrada = Input { Value = 0.15, },
						Salida = Input { Value = 0.1, },
						Rebote = Input { Value = 1.2, },
						T = Input { Value = 1, Expression = "max(0, min(1, min(Pop.Progreso/Pop.Entrada, (1 - Pop.Progreso)/max(Pop.Salida, 0.0001))))", },
						E = Input { Value = 1, Expression = "(1 + ((1.70158*Pop.Rebote) + 1)*(Pop.T - 1)*(Pop.T - 1)*(Pop.T - 1) + (1.70158*Pop.Rebote)*(Pop.T - 1)*(Pop.T - 1))", },
						TamTexto = Input { Value = 0.09, },
						Vertical = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 } },
					UserControls = ordered() {
						Vertical = {
							LINKS_Name = "Formato vertical (9:16)",
							LINKID_DataType = "Number",
							INPID_InputControl = "CheckboxControl",
							INP_Integer = true,
							CBC_TriState = false,
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						TamTexto = {
							LINKS_Name = "Tamaño",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.09,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
						Progreso = {
							LINKS_Name = "Progreso",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Entrada = {
							LINKS_Name = "Duración entrada (% del clip)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.15,
							INP_MinScale = 0.01,
							INP_MaxScale = 0.5,
							INP_MinAllowed = 0.01,
							INP_MaxAllowed = 0.5,
							ICS_ControlPage = "Controls",
						},
						Salida = {
							LINKS_Name = "Duración salida (% del clip)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.1,
							INP_MinScale = 0,
							INP_MaxScale = 0.5,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 0.5,
							ICS_ControlPage = "Controls",
						},
						Rebote = {
							LINKS_Name = "Rebote",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1.2,
							INP_MinScale = 0,
							INP_MaxScale = 3,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 3,
							ICS_ControlPage = "Controls",
						},
						T = {
							LINKS_Name = "t interno",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
						E = {
							LINKS_Name = "Curva interna",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = -1,
							INP_MaxScale = 2,
							ICS_ControlPage = "Controls",
						},
					},
				},
				Posicion = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Pop", Source = "Output", },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 } },
				},
			},
		},
		PROSocialTextoPopAnim = LUTLookup {
			Inputs = {
			},
			CtrlWZoom = false,
		},
	},
	ActiveTool = "PRO_TTL_Social_TextoPop"
}
