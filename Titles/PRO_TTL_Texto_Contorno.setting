						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						Center = Input { Value = { 0.5, 0.5 }, },
						StyledText = Input { Value = "CAOS", Expression = "Text(Relleno.StyledText.Value)", },
						Font = Input { Value = "Inter 24pt", },
						Style = Input { Value = "Black", },
						Size = Input { Value = 0.3, Expression = "Contorno.TamRelleno*iif(Contorno.Vertical > 0.5, 0.3164, 1)", },
						Red1 = Input { Value = 1, },
						Green1 = Input { Value = 1, },
						Blue1 = Input { Value = 1, },
						Enabled2 = Input { Value = 1, },
						Thickness2 = Input { Value = 0.012, },
						OutsideOnly2 = Input { Value = 1, },
						Red2 = Input { Value = 1, },
						Green2 = Input { Value = 1, },
						Blue2 = Input { Value = 1, },
						Enabled1 = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -330, -198 } },
				},
				Abre1 = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Eco1", Source = "Output", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5, 0.5 + ((0.5) - 0.5)*iif(Contorno.Vertical > 0.5, 0.3164, 1))", },
						Size = Input { Value = 1, Expression = "(1 + 1*Contorno.Separacion*(max(0, min(1, (Contorno.U - 0.2)/0.8)))*(max(0, min(1, (Contorno.U - 0.2)/0.8)))*(3-2*(max(0, min(1, (Contorno.U - 0.2)/0.8)))))*(1 + 0.03*Contorno.Pulso*sin(time*0.2))", },
					},
					ViewInfo = OperatorInfo { Pos = { -330, -132 } },
				},
				Eco2 = TextPlus {
