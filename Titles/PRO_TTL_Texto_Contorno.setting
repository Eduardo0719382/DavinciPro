						Salida = Input { Value = 0.1, },
						U = Input { Value = 1, Expression = "max(0, min(1, Contorno.Progreso/Contorno.Entrada))", },
						Xs = Input { Value = 1, Expression = "(max(0, min(1, (1 - Contorno.Progreso)/max(Contorno.Salida, 0.0001))))*(max(0, min(1, (1 - Contorno.Progreso)/max(Contorno.Salida, 0.0001))))*(3-2*(max(0, min(1, (1 - Contorno.Progreso)/max(Contorno.Salida, 0.0001)))))", },
						Separacion = Input { Value = 0.08, },
						Pulso = Input { Value = 1, },
						Rebote = Input { Value = 1.2, },
						Vertical = Input { Value = 0, },
						TamRelleno = Input { Value = 0.3, },
