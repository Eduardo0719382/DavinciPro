						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5, 0.5 + ((0.5) - 0.5)*iif(Contorno.Vertical > 0.5, 0.3164, 1))", },
						Size = Input { Value = 1, Expression = "max(0, (1 + ((1.70158*Contorno.Rebote) + 1)*(max(0, min(1, (Contorno.U - 0)/0.4)) - 1)*(max(0, min(1, (Contorno.U - 0)/0.4)) - 1)*(max(0, min(1, (Contorno.U - 0)/0.4)) - 1) + (1.70158*Contorno.Rebote)*(max(0, min(1, (Contorno.U - 0)/0.4)) - 1)*(max(0, min(1, (Contorno.U - 0)/0.4)) - 1)))", },
					},
					ViewInfo = OperatorInfo { Pos = { -440, -132 } },
				},
