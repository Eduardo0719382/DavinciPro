						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5, 0.5 + ((0.5) - 0.5)*iif(Contorno.Vertical > 0.5, 0.3164, 1))", },
						Size = Input { Value = 1, Expression = "(1 + 3*Contorno.Separacion*(max(0, min(1, (Contorno.U - 0.2)/0.8)))*(max(0, min(1, (Contorno.U - 0.2)/0.8)))*(3-2*(max(0, min(1, (Contorno.U - 0.2)/0.8)))))*(1 + 0.03*Contorno.Pulso*sin(time*0.2))", },
