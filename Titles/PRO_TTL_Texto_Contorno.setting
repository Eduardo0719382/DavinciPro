					Inputs = {
						Input = Input { SourceOp = "M4", Source = "Output", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5 + iif(Contorno.Vertical > 0.5, 0, 0), 0.5 + iif(Contorno.Vertical > 0.5, 0, 0))", },
						Size = Input { Value = 1, Expression = "iif(Contorno.Vertical > 0.5, 1.8, 1)", },
					},
					ViewInfo = OperatorInfo { Pos = { 385, 0 } },
				},
				Contorno = Transform {
					CtrlWShown = false,
					Inputs = {
