{
	Tools = ordered() {
		PRO_TTL_Texto_Contorno = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				Input1 = InstanceInput { SourceOp = "Relleno", Source = "StyledText", Name = "Palabra", },
				Input2 = InstanceInput { SourceOp = "Contorno", Source = "TamRelleno", Name = "Tamaño", Default = 0.3, },
				Input3 = InstanceInput { SourceOp = "Relleno", Source = "Red1", Name = "Color de la palabra", ControlGroup = 3, Default = 1, },
				Input4 = InstanceInput { SourceOp = "Relleno", Source = "Green1", ControlGroup = 3, Default = 1, },
				Input5 = InstanceInput { SourceOp = "Relleno", Source = "Blue1", ControlGroup = 3, Default = 1, },
				Input6 = InstanceInput { SourceOp = "Eco1", Source = "Red2", Name = "Color del contorno", ControlGroup = 6, Default = 1, },
				Input7 = InstanceInput { SourceOp = "Eco1", Source = "Green2", ControlGroup = 6, Default = 1, },
				Input8 = InstanceInput { SourceOp = "Eco1", Source = "Blue2", ControlGroup = 6, Default = 1, },
				Input9 = InstanceInput { SourceOp = "Eco1", Source = "Thickness2", Name = "Grosor del contorno", Default = 0.012, },
				Input10 = InstanceInput { SourceOp = "Contorno", Source = "Separacion", Name = "Separación de los ecos", Default = 0.08, },
				Input11 = InstanceInput { SourceOp = "Contorno", Source = "Pulso", Name = "Pulso", Default = 1, },
				Input12 = InstanceInput { SourceOp = "Contorno", Source = "Vertical", Name = "Formato vertical (9:16)", Default = 0, },
				Input13 = InstanceInput { SourceOp = "Contorno", Source = "Center", Name = "Posición", },
				Input14 = InstanceInput { SourceOp = "Contorno", Source = "Size", Name = "Escala", Default = 1, },
				Input15 = InstanceInput { SourceOp = "Contorno", Source = "Entrada", Name = "Duración entrada (% del clip)", Default = 0.25, },
				Input16 = InstanceInput { SourceOp = "Contorno", Source = "Salida", Name = "Duración salida (% del clip, 0 = sin salida)", Default = 0.1, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Contorno", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Lienzo = Background {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 0, },
						TopLeftGreen = Input { Value = 0, },
						TopLeftBlue = Input { Value = 0, },
						TopLeftAlpha = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -440, 0 } },
				},
				Relleno = TextPlus {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						Center = Input { Value = { 0.5, 0.5 }, },
						StyledText = Input { Value = "CAOS", },
						Font = Input { Value = "Inter 24pt", },
						Style = Input { Value = "Black", },
						Size = Input { Value = 0.3, Expression = "Contorno.TamRelleno*iif(Contorno.Vertical > 0.5, 0.3164, 1)", },
						Red1 = Input { Value = 1, },
						Green1 = Input { Value = 1, },
						Blue1 = Input { Value = 1, },
						Enabled8 = Input { Value = 1, },
						Softness8 = Input { Value = 1, },
						SoftnessX8 = Input { Value = 6, },
						SoftnessY8 = Input { Value = 6, },
						Offset8 = Input { Value = { 0.003, -0.008 }, },
						Red8 = Input { Value = 0, },
						Green8 = Input { Value = 0, },
						Blue8 = Input { Value = 0, },
