						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						Center = Input { Value = { 0.5, 0.5 }, },
						StyledText = Input { Value = "CAOS", Expression = "Text(Relleno.StyledText.Value)", },
						Font = Input { Value = "Inter 24pt", },
						Style = Input { Value = "Black", },
						Size = Input { Value = 0.3, Expression = "Contorno.TamRelleno*iif(Contorno.Vertical > 0.5, 0.3164, 1)", },
