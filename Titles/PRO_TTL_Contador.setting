{
	Tools = ordered() {
		PRO_TTL_Contador = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				Input1 = InstanceInput { SourceOp = "Contador", Source = "Inicio", Name = "Valor inicial", Default = 0, },
				Input2 = InstanceInput { SourceOp = "Contador", Source = "Fin", Name = "Valor final", Default = 1000, },
				Input3 = InstanceInput { SourceOp = "Contador", Source = "Duracion", Name = "Duración del conteo (% del clip)", Default = 0.6, },
				Input4 = InstanceInput { SourceOp = "Numero", Source = "Font", Name = "Fuente del número", ControlGroup = 4, },
				Input5 = InstanceInput { SourceOp = "Numero", Source = "Style", ControlGroup = 4, },
				Input6 = InstanceInput { SourceOp = "Numero", Source = "Red1", Name = "Color del número", ControlGroup = 6, Default = 1, },
				Input7 = InstanceInput { SourceOp = "Numero", Source = "Green1", ControlGroup = 6, Default = 1, },
				Input8 = InstanceInput { SourceOp = "Numero", Source = "Blue1", ControlGroup = 6, Default = 1, },
				Input9 = InstanceInput { SourceOp = "Etiqueta", Source = "StyledText", Name = "Etiqueta", },
				Input10 = InstanceInput { SourceOp = "Etiqueta", Source = "Red1", Name = "Color de la etiqueta", ControlGroup = 10, Default = 0.85, },
				Input11 = InstanceInput { SourceOp = "Etiqueta", Source = "Green1", ControlGroup = 10, Default = 0.85, },
				Input12 = InstanceInput { SourceOp = "Etiqueta", Source = "Blue1", ControlGroup = 10, Default = 0.85, },
				Input13 = InstanceInput { SourceOp = "Contador", Source = "Center", Name = "Posición", },
				Input14 = InstanceInput { SourceOp = "Contador", Source = "Size", Name = "Escala", Default = 1, },
				Input15 = InstanceInput { SourceOp = "Contador", Source = "Entrada", Name = "Duración entrada (% del clip)", Default = 0.1, },
				Input16 = InstanceInput { SourceOp = "Contador", Source = "Salida", Name = "Duración salida (% del clip, 0 = sin salida)", Default = 0.1, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Contador", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Lienzo = Background {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 0, },
						TopLeftGreen = Input { Value = 0, },
						TopLeftBlue = Input { Value = 0, },
						TopLeftAlpha = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -440, 0 } },
				},
				Numero = TextPlus {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						Center = Input { Value = { 0.5, 0.55 }, },
						StyledText = Input { Value = "0", Expression = "Text(string.format(\"%.0f\", Contador.Inicio + (Contador.Fin - Contador.Inicio)*(1 - (1 - max(0, min(1, Contador.Progreso/Contador.Duracion)))*(1 - max(0, min(1, Contador.Progreso/Contador.Duracion)))*(1 - max(0, min(1, Contador.Progreso/Contador.Duracion))))))", },
						Font = Input { Value = "Arial", },
						Style = Input { Value = "Bold", },
						Size = Input { Value = 0.14, },
						Red1 = Input { Value = 1, },
						Green1 = Input { Value = 1, },
						Blue1 = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { -385, -66 } },
				},
				Etiqueta = TextPlus {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						Center = Input { Value = { 0.5, 0.4 }, },
						StyledText = Input { Value = "SEGUIDORES", },
						Font = Input { Value = "Arial", },
						Style = Input { Value = "Regular", },
						Size = Input { Value = 0.04, },
						Red1 = Input { Value = 0.85, },
						Green1 = Input { Value = 0.85, },
						Blue1 = Input { Value = 0.85, },
						CharacterSpacing = Input { Value = 1.3, },
					},
					ViewInfo = OperatorInfo { Pos = { -330, -66 } },
				},
				M1 = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "Lienzo", Source = "Output", },
						Foreground = Input { SourceOp = "Numero", Source = "Output", },
						Blend = Input { Value = 1, Expression = "(max(0, min(1, (Contador.U - 0)/0.6)))*(max(0, min(1, (Contador.U - 0)/0.6)))*(3-2*(max(0, min(1, (Contador.U - 0)/0.6))))*Contador.Xs", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 } },
				},
				M2 = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "M1", Source = "Output", },
						Foreground = Input { SourceOp = "Etiqueta", Source = "Output", },
						Blend = Input { Value = 1, Expression = "(max(0, min(1, (Contador.U - 0.4)/0.6)))*(max(0, min(1, (Contador.U - 0.4)/0.6)))*(3-2*(max(0, min(1, (Contador.U - 0.4)/0.6))))*Contador.Xs", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 165, 0 } },
				},
				Contador = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "M2", Source = "Output", },
						Progreso = Input { SourceOp = "PROContadorAnim", Source = "Value", },
						Entrada = Input { Value = 0.1, },
						Salida = Input { Value = 0.1, },
						U = Input { Value = 1, Expression = "max(0, min(1, Contador.Progreso/Contador.Entrada))", },
						Xs = Input { Value = 1, Expression = "(max(0, min(1, (1 - Contador.Progreso)/max(Contador.Salida, 0.0001))))*(max(0, min(1, (1 - Contador.Progreso)/max(Contador.Salida, 0.0001))))*(3-2*(max(0, min(1, (1 - Contador.Progreso)/max(Contador.Salida, 0.0001)))))", },
						Inicio = Input { Value = 0, },
						Fin = Input { Value = 1000, },
						Duracion = Input { Value = 0.6, },
					},
					ViewInfo = OperatorInfo { Pos = { 440, 0 } },
					UserControls = ordered() {
						Progreso = {
							LINKS_Name = "Progreso",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Entrada = {
							LINKS_Name = "Duración entrada (% del clip)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.1,
							INP_MinScale = 0.01,
							INP_MaxScale = 0.8,
							INP_MinAllowed = 0.01,
							INP_MaxAllowed = 0.8,
							ICS_ControlPage = "Controls",
						},
						Salida = {
							LINKS_Name = "Duración salida (% del clip, 0 = sin salida)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.1,
							INP_MinScale = 0,
							INP_MaxScale = 0.5,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 0.5,
							ICS_ControlPage = "Controls",
						},
						Inicio = {
							LINKS_Name = "Valor inicial",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = -1e+06,
							INP_MaxScale = 1e+06,
							ICS_ControlPage = "Controls",
						},
						Fin = {
							LINKS_Name = "Valor final",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1000,
							INP_MinScale = -1e+06,
							INP_MaxScale = 1e+06,
							ICS_ControlPage = "Controls",
						},
						Duracion = {
							LINKS_Name = "Duración del conteo (% del clip)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.6,
							INP_MinScale = 0.05,
							INP_MaxScale = 1,
							INP_MinAllowed = 0.05,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						U = {
							LINKS_Name = "Avance interno",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
						Xs = {
							LINKS_Name = "Salida interna",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
					},
				},
			},
		},
		PROContadorAnim = LUTLookup {
			Inputs = {
			},
			CtrlWZoom = false,
		},
	},
	ActiveTool = "PRO_TTL_Contador"
}
