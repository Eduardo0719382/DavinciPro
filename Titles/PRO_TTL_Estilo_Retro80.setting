						Font = Input { Value = "Montserrat", },
						Style = Input { Value = "Bold", },
						Size = Input { Value = 0.03, },
						Red1 = Input { Value = 0, },
						Green1 = Input { Value = 0.9, },
						Blue1 = Input { Value = 1, },
						CharacterSpacing = Input { Value = 1.8, },
					},
					ViewInfo = OperatorInfo { Pos = { -330, -132 } },
				},
				Anim1 = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Titulo", Source = "Output", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5, 0.53)", },
						Size = Input { Value = 1, Expression = "1", },
					},
					ViewInfo = OperatorInfo { Pos = { -385, -66 } },
				},
				Halo = Blur {
					CtrlWShown = false,
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" }, },
						XBlurSize = Input { Value = 30, },
						Input = Input { SourceOp = "Anim1", Source = "Output", },
					},
					ViewInfo = OperatorInfo { Pos = { -385, -33 } },
				},
				Anim2 = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Sub", Source = "Output", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5, 0.42 - 0.02*(1 - (max(0, min(1, (Retro.U - 0.5)/0.5)))*(max(0, min(1, (Retro.U - 0.5)/0.5)))*(3-2*(max(0, min(1, (Retro.U - 0.5)/0.5))))))", },
						Size = Input { Value = 1, Expression = "1", },
					},
					ViewInfo = OperatorInfo { Pos = { -330, -66 } },
				},
				M1 = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "Lienzo", Source = "Output", },
						Foreground = Input { SourceOp = "Halo", Source = "Output", },
						Blend = Input { Value = 1, Expression = "Retro.Glow*Retro.F*Retro.Xs", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 } },
				},
				M2 = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "M1", Source = "Output", },
						Foreground = Input { SourceOp = "Anim1", Source = "Output", },
						Blend = Input { Value = 1, Expression = "(0.3 + 0.7*Retro.F)*Retro.Xs", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 165, 0 } },
				},
				M3 = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "M2", Source = "Output", },
						Foreground = Input { SourceOp = "Anim2", Source = "Output", },
						Blend = Input { Value = 1, Expression = "(max(0, min(1, (Retro.U - 0.5)/0.5)))*(max(0, min(1, (Retro.U - 0.5)/0.5)))*(3-2*(max(0, min(1, (Retro.U - 0.5)/0.5))))*Retro.Xs", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 220, 0 } },
				},
				Formato = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "M3", Source = "Output", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5, 0.5 + iif(Retro.Vertical > 0.5, 0, 0))", },
						Size = Input { Value = 1, Expression = "iif(Retro.Vertical > 0.5, 0.8, 1)", },
					},
					ViewInfo = OperatorInfo { Pos = { 385, 0 } },
				},
				Retro = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Formato", Source = "Output", },
						Progreso = Input { SourceOp = "PROEstiloRetro80Anim", Source = "Value", },
						Entrada = Input { Value = 0.25, },
						Salida = Input { Value = 0.1, },
						U = Input { Value = 1, Expression = "max(0, min(1, Retro.Progreso/Retro.Entrada))", },
						Xs = Input { Value = 1, Expression = "(max(0, min(1, (1 - Retro.Progreso)/max(Retro.Salida, 0.0001))))*(max(0, min(1, (1 - Retro.Progreso)/max(Retro.Salida, 0.0001))))*(3-2*(max(0, min(1, (1 - Retro.Progreso)/max(Retro.Salida, 0.0001)))))", },
						Glow = Input { Value = 0.8, },
						F = Input { Value = 1, Expression = "iif(Retro.U < 1, iif(sin(time*2.3)*sin(time*0.9 + 1) > 0, 1, 0.15), 1)", },
						Vertical = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 440, 0 } },
					UserControls = ordered() {
						Progreso = {
							LINKS_Name = "Progreso",
							LINKID_DataType = "Number",
