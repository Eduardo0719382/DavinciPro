				Input14 = InstanceInput { SourceOp = "Sub", Source = "Red1", Name = "Color del subtítulo", ControlGroup = 14, Default = 0, },
				Input15 = InstanceInput { SourceOp = "Sub", Source = "Green1", ControlGroup = 14, Default = 0.9, },
				Input16 = InstanceInput { SourceOp = "Sub", Source = "Blue1", ControlGroup = 14, Default = 1, },
				Input17 = InstanceInput { SourceOp = "Retro", Source = "Vertical", Name = "Formato vertical (9:16)", Default = 0, },
				Input18 = InstanceInput { SourceOp = "Retro", Source = "Center", Name = "Posición", },
				Input19 = InstanceInput { SourceOp = "Retro", Source = "Size", Name = "Escala", Default = 1, },
				Input20 = InstanceInput { SourceOp = "Retro", Source = "Entrada", Name = "Duración entrada (% del clip)", Default = 0.25, },
				Input21 = InstanceInput { SourceOp = "Retro", Source = "Salida", Name = "Duración salida (% del clip, 0 = sin salida)", Default = 0.1, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Retro", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Lienzo = Background {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 0, },
						TopLeftGreen = Input { Value = 0, },
						TopLeftBlue = Input { Value = 0, },
						TopLeftAlpha = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -440, 0 } },
				},
				Titulo = TextPlus {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						Center = Input { Value = { 0.5, 0.5 }, },
						StyledText = Input { Value = "NEON NIGHTS", },
						Font = Input { Value = "Monoton", },
						Style = Input { Value = "Regular", },
						Size = Input { Value = 0.1, },
						Red1 = Input { Value = 1, },
						Green1 = Input { Value = 0.2, },
						Blue1 = Input { Value = 0.8, },
						Enabled4 = Input { Value = 1, },
						ElementShape4 = Input { Value = 0, },
						Offset4 = Input { Value = { 0.006, -0.009 }, },
						Red4 = Input { Value = 0, },
						Green4 = Input { Value = 0.9, },
						Blue4 = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { -385, -132 } },
				},
				Sub = TextPlus {
					CtrlWShown = false,
					Inputs = {
