{
	Tools = ordered() {
		PRO_TTL_Estilo_Retro80 = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				Input1 = InstanceInput { SourceOp = "Titulo", Source = "StyledText", Name = "Título", },
				Input2 = InstanceInput { SourceOp = "Sub", Source = "StyledText", Name = "Subtítulo", },
				Input3 = InstanceInput { SourceOp = "Titulo", Source = "Font", Name = "Fuente del título", ControlGroup = 3, },
				Input4 = InstanceInput { SourceOp = "Titulo", Source = "Style", ControlGroup = 3, },
				Input5 = InstanceInput { SourceOp = "Titulo", Source = "Size", Name = "Tamaño del título", Default = 0.1, },
				Input6 = InstanceInput { SourceOp = "Titulo", Source = "Red1", Name = "Color del título", ControlGroup = 6, Default = 1, },
				Input7 = InstanceInput { SourceOp = "Titulo", Source = "Green1", ControlGroup = 6, Default = 0.2, },
