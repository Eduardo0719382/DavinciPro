				Input10 = InstanceInput { SourceOp = "Titulo", Source = "Green4", ControlGroup = 9, Default = 0.9, },
				Input11 = InstanceInput { SourceOp = "Titulo", Source = "Blue4", ControlGroup = 9, Default = 1, },
				Input12 = InstanceInput { SourceOp = "Titulo", Source = "Offset4", Name = "Desplazamiento de la sombra", },
