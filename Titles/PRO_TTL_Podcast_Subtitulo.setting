{
	Tools = ordered() {
		PRO_TTL_Podcast_Subtitulo = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				Input1 = InstanceInput { SourceOp = "Fuente", Source = "StyledText", Name = "Frase completa", },
				Input2 = InstanceInput { SourceOp = "Palabra", Source = "Font", Name = "Fuente", ControlGroup = 2, },
				Input3 = InstanceInput { SourceOp = "Palabra", Source = "Style", ControlGroup = 2, },
				Input4 = InstanceInput { SourceOp = "Subtitulo", Source = "TamPalabra", Name = "Tamaño", Default = 0.08, },
				Input5 = InstanceInput { SourceOp = "ColorBase", Source = "TopLeftRed", Name = "Color del texto", ControlGroup = 5, Default = 1, },
				Input6 = InstanceInput { SourceOp = "ColorBase", Source = "TopLeftGreen", ControlGroup = 5, Default = 1, },
				Input7 = InstanceInput { SourceOp = "ColorBase", Source = "TopLeftBlue", ControlGroup = 5, Default = 1, },
				Input8 = InstanceInput { SourceOp = "ColorClave", Source = "TopLeftRed", Name = "Color de la palabra destacada", ControlGroup = 8, Default = 1, },
				Input9 = InstanceInput { SourceOp = "ColorClave", Source = "TopLeftGreen", ControlGroup = 8, Default = 0.85, },
				Input10 = InstanceInput { SourceOp = "ColorClave", Source = "TopLeftBlue", ControlGroup = 8, Default = 0.15, },
				Input11 = InstanceInput { SourceOp = "Subtitulo", Source = "Destacada", Name = "Palabra destacada (0 = ninguna)", Default = 0, },
				Input12 = InstanceInput { SourceOp = "Subtitulo", Source = "Mayus", Name = "Mayúsculas", Default = 1, },
				Input13 = InstanceInput { SourceOp = "Palabra", Source = "Red2", Name = "Color del contorno", ControlGroup = 13, Default = 0, },
				Input14 = InstanceInput { SourceOp = "Palabra", Source = "Green2", ControlGroup = 13, Default = 0, },
				Input15 = InstanceInput { SourceOp = "Palabra", Source = "Blue2", ControlGroup = 13, Default = 0, },
				Input16 = InstanceInput { SourceOp = "Palabra", Source = "Thickness2", Name = "Grosor del contorno", Default = 0.04, },
				Input17 = InstanceInput { SourceOp = "Subtitulo", Source = "Rebote", Name = "Rebote", Default = 1, },
				Input18 = InstanceInput { SourceOp = "Subtitulo", Source = "Glow", Name = "Brillo", Default = 0.5, },
				Input19 = InstanceInput { SourceOp = "Halo", Source = "XBlurSize", Name = "Tamaño del brillo", Default = 25, },
				Input20 = InstanceInput { SourceOp = "Subtitulo", Source = "Vertical", Name = "Formato vertical (9:16)", Default = 0, },
				Input21 = InstanceInput { SourceOp = "Subtitulo", Source = "Center", Name = "Posición", },
				Input22 = InstanceInput { SourceOp = "Subtitulo", Source = "Size", Name = "Escala", Default = 1, },
				Input23 = InstanceInput { SourceOp = "Subtitulo", Source = "Entrada", Name = "Duración entrada (% del clip)", Default = 0.02, },
				Input24 = InstanceInput { SourceOp = "Subtitulo", Source = "Salida", Name = "Duración salida (% del clip, 0 = sin salida)", Default = 0, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Subtitulo", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Lienzo = Background {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 0, },
						TopLeftGreen = Input { Value = 0, },
						TopLeftBlue = Input { Value = 0, },
						TopLeftAlpha = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -440, 0 } },
				},
				Fuente = TextPlus {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						Center = Input { Value = { 0.5, 0.5 }, },
						StyledText = Input { Value = "ESTO ES LO QUE NADIE TE CUENTA", },
						Font = Input { Value = "Arial", },
						Style = Input { Value = "Bold", },
						Size = Input { Value = 0.06, Expression = "Subtitulo.TamFuente*iif(Subtitulo.Vertical > 0.5, 0.3164, 1)", },
						Red1 = Input { Value = 1, },
						Green1 = Input { Value = 1, },
						Blue1 = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { -385, -264 } },
				},
				ColorBase = Background {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 1, },
						TopLeftGreen = Input { Value = 1, },
						TopLeftBlue = Input { Value = 1, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { -330, -264 } },
				},
				ColorClave = Background {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 1, },
						TopLeftGreen = Input { Value = 0.85, },
						TopLeftBlue = Input { Value = 0.15, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { -275, -264 } },
				},
				Palabra = TextPlus {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						Center = Input { Value = { 0.5, 0.3 }, Expression = "Point(0.5, 0.5 + ((0.3) - 0.5)*iif(Subtitulo.Vertical > 0.5, 0.3164, 1))", },
						StyledText = Input { Value = "", Expression = "Text(iif(Subtitulo.Mayus > 0.5, string.upper(string.match(Fuente.StyledText.Value, string.rep(\"%S+%s+\", Subtitulo.Idx) .. \"(%S+)\")), string.match(Fuente.StyledText.Value, string.rep(\"%S+%s+\", Subtitulo.Idx) .. \"(%S+)\")))", },
						Font = Input { Value = "Inter 24pt", },
						Style = Input { Value = "ExtraBold", },
						Size = Input { Value = 0.08, Expression = "Subtitulo.TamPalabra*iif(Subtitulo.Vertical > 0.5, 0.3164, 1)", },
						Red1 = Input { Value = 1, Expression = "iif(Subtitulo.Idx + 1 == Subtitulo.Destacada, ColorClave.TopLeftRed, ColorBase.TopLeftRed)", },
						Green1 = Input { Value = 1, Expression = "iif(Subtitulo.Idx + 1 == Subtitulo.Destacada, ColorClave.TopLeftGreen, ColorBase.TopLeftGreen)", },
						Blue1 = Input { Value = 1, Expression = "iif(Subtitulo.Idx + 1 == Subtitulo.Destacada, ColorClave.TopLeftBlue, ColorBase.TopLeftBlue)", },
						Enabled8 = Input { Value = 1, },
						Softness8 = Input { Value = 1, },
						SoftnessX8 = Input { Value = 6, },
						SoftnessY8 = Input { Value = 6, },
						Offset8 = Input { Value = { 0.003, -0.008 }, },
						Red8 = Input { Value = 0, },
						Green8 = Input { Value = 0, },
						Blue8 = Input { Value = 0, },
						Alpha8 = Input { Value = 0.25, },
						Enabled2 = Input { Value = 1, },
						Thickness2 = Input { Value = 0.04, },
						OutsideOnly2 = Input { Value = 1, },
						Red2 = Input { Value = 0, },
						Green2 = Input { Value = 0, },
						Blue2 = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -385, -198 } },
				},
				Rebota = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Palabra", Source = "Output", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5, 0.5 + ((0.5) - 0.5)*iif(Subtitulo.Vertical > 0.5, 0.3164, 1))", },
						Size = Input { Value = 1, Expression = "(1 + 0.18*Subtitulo.Rebote*pow(max(0, 1 - 5*Subtitulo.Fr), 2))", },
					},
					ViewInfo = OperatorInfo { Pos = { -385, -132 } },
				},
				Halo = Blur {
					CtrlWShown = false,
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" }, },
						XBlurSize = Input { Value = 25, },
						Input = Input { SourceOp = "Rebota", Source = "Output", },
					},
					ViewInfo = OperatorInfo { Pos = { -330, -132 } },
				},
				M1 = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "Lienzo", Source = "Output", },
						Foreground = Input { SourceOp = "Halo", Source = "Output", },
						Blend = Input { Value = 1, Expression = "Subtitulo.Glow*Subtitulo.Xs", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 } },
				},
				M2 = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "M1", Source = "Output", },
						Foreground = Input { SourceOp = "Rebota", Source = "Output", },
						Blend = Input { Value = 1, Expression = "Subtitulo.Xs", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 165, 0 } },
				},
				Formato = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "M2", Source = "Output", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5 + iif(Subtitulo.Vertical > 0.5, 0, 0), 0.5 + iif(Subtitulo.Vertical > 0.5, 0.05, 0))", },
						Size = Input { Value = 1, Expression = "iif(Subtitulo.Vertical > 0.5, 1.6, 1)", },
					},
					ViewInfo = OperatorInfo { Pos = { 385, 0 } },
				},
				Subtitulo = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Formato", Source = "Output", },
						Progreso = Input { SourceOp = "PROPodcastSubtituloAnim", Source = "Value", },
						Entrada = Input { Value = 0.02, },
						Salida = Input { Value = 0, },
						U = Input { Value = 1, Expression = "max(0, min(1, Subtitulo.Progreso/Subtitulo.Entrada))", },
						Xs = Input { Value = 1, Expression = "(max(0, min(1, (1 - Subtitulo.Progreso)/max(Subtitulo.Salida, 0.0001))))*(max(0, min(1, (1 - Subtitulo.Progreso)/max(Subtitulo.Salida, 0.0001))))*(3-2*(max(0, min(1, (1 - Subtitulo.Progreso)/max(Subtitulo.Salida, 0.0001)))))", },
						Rebote = Input { Value = 1, },
						Destacada = Input { Value = 0, },
						Mayus = Input { Value = 1, },
						Glow = Input { Value = 0.5, },
						N = Input { Value = 1, Expression = "max(1, string.len((string.gsub((string.gsub(Fuente.StyledText.Value, \"%S+\", \"x\")), \"%s+\", \"\"))))", },
						Idx = Input { Value = 0, Expression = "min(Subtitulo.N - 1, floor(Subtitulo.Progreso*Subtitulo.N))", },
						Fr = Input { Value = 0, Expression = "min(1, Subtitulo.Progreso*Subtitulo.N - Subtitulo.Idx)", },
						Vertical = Input { Value = 0, },
						TamFuente = Input { Value = 0.06, },
						TamPalabra = Input { Value = 0.08, },
					},
					ViewInfo = OperatorInfo { Pos = { 440, 0 } },
					UserControls = ordered() {
						Progreso = {
							LINKS_Name = "Progreso",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Entrada = {
							LINKS_Name = "Duración entrada (% del clip)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.02,
							INP_MinScale = 0.01,
							INP_MaxScale = 0.8,
							INP_MinAllowed = 0.01,
							INP_MaxAllowed = 0.8,
							ICS_ControlPage = "Controls",
						},
						Salida = {
							LINKS_Name = "Duración salida (% del clip, 0 = sin salida)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 0.5,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 0.5,
							ICS_ControlPage = "Controls",
						},
						Rebote = {
							LINKS_Name = "Rebote",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 3,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 3,
							ICS_ControlPage = "Controls",
						},
						Destacada = {
							LINKS_Name = "Palabra destacada (0 = ninguna)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 50,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 50,
							ICS_ControlPage = "Controls",
						},
						Mayus = {
							LINKS_Name = "Mayúsculas",
							LINKID_DataType = "Number",
							INPID_InputControl = "CheckboxControl",
							INP_Integer = true,
							CBC_TriState = false,
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Glow = {
							LINKS_Name = "Brillo",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.5,
							INP_MinScale = 0,
							INP_MaxScale = 2,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 2,
							ICS_ControlPage = "Controls",
						},
						N = {
							LINKS_Name = "Palabras",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 1,
							INP_MaxScale = 200,
							ICS_ControlPage = "Controls",
						},
						Idx = {
							LINKS_Name = "Palabra actual",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 200,
							ICS_ControlPage = "Controls",
						},
						Fr = {
							LINKS_Name = "Avance de la palabra",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
						Vertical = {
							LINKS_Name = "Formato vertical (9:16)",
							LINKID_DataType = "Number",
							INPID_InputControl = "CheckboxControl",
							INP_Integer = true,
							CBC_TriState = false,
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						TamFuente = {
							LINKS_Name = "Tamaño Fuente",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.06,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
						TamPalabra = {
							LINKS_Name = "Tamaño Palabra",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.08,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
						U = {
							LINKS_Name = "Avance interno",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
						Xs = {
							LINKS_Name = "Salida interna",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
					},
				},
			},
		},
		PROPodcastSubtituloAnim = LUTLookup {
			Inputs = {
			},
			CtrlWZoom = false,
		},
	},
	ActiveTool = "PRO_TTL_Podcast_Subtitulo"
}
