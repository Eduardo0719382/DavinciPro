				Input2 = InstanceInput { SourceOp = "Autor", Source = "StyledText", Name = "Autor", },
				Input3 = InstanceInput { SourceOp = "Frase", Source = "Font", Name = "Fuente de la frase", ControlGroup = 3, },
				Input4 = InstanceInput { SourceOp = "Frase", Source = "Style", ControlGroup = 3, },
				Input5 = InstanceInput { SourceOp = "Frase", Source = "Size", Name = "Tamaño de la frase", Default = 0.05, },
				Input6 = InstanceInput { SourceOp = "Comillas", Source = "Red1", Name = "Color de acento", ControlGroup = 6, Default = 0.95, },
				Input7 = InstanceInput { SourceOp = "Comillas", Source = "Green1", ControlGroup = 6, Default = 0.75, },
				Input8 = InstanceInput { SourceOp = "Comillas", Source = "Blue1", ControlGroup = 6, Default = 0.3, },
				Input9 = InstanceInput { SourceOp = "Cita", Source = "Center", Name = "Posición", },
				Input10 = InstanceInput { SourceOp = "Cita", Source = "Size", Name = "Escala", Default = 1, },
				Input11 = InstanceInput { SourceOp = "Cita", Source = "Entrada", Name = "Duración entrada (% del clip)", Default = 0.25, },
				Input12 = InstanceInput { SourceOp = "Cita", Source = "Salida", Name = "Duración salida (% del clip, 0 = sin salida)", Default = 0.12, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Cita", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Lienzo = Background {
