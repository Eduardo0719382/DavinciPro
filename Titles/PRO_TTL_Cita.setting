						StyledText = Input { Value = "ALBERT EINSTEIN", },
						Font = Input { Value = "Arial", },
						Style = Input { Value = "Regular", },
						Size = Input { Value = 0.028, },
						Red1 = Input { Value = 0.8, },
						Green1 = Input { Value = 0.8, },
						Blue1 = Input { Value = 0.8, },
						CharacterSpacing = Input { Value = 1.3, },
					},
					ViewInfo = OperatorInfo { Pos = { -220, -132 } },
				},
				M1 = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "Lienzo", Source = "Output", },
						Foreground = Input { SourceOp = "Comillas", Source = "Output", },
						Blend = Input { Value = 1, Expression = "(max(0, min(1, (Cita.U - 0)/0.4)))*(max(0, min(1, (Cita.U - 0)/0.4)))*(3-2*(max(0, min(1, (Cita.U - 0)/0.4))))*Cita.Xs", },
						PerformDepthMerge = Input { Value = 0, },
					},
