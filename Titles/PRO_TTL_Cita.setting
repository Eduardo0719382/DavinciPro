				},
				M2 = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "M1", Source = "Output", },
						Foreground = Input { SourceOp = "Frase", Source = "Output", },
						Blend = Input { Value = 1, Expression = "(max(0, min(1, (Cita.U - 0.15)/0.45)))*(max(0, min(1, (Cita.U - 0.15)/0.45)))*(3-2*(max(0, min(1, (Cita.U - 0.15)/0.45))))*Cita.Xs", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 165, 0 } },
				},
				M3 = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "M2", Source = "Output", },
						Foreground = Input { SourceOp = "Raya", Source = "Output", },
						Blend = Input { Value = 1, Expression = "Cita.Xs", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 220, 0 } },
				},
				M4 = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "M3", Source = "Output", },
						Foreground = Input { SourceOp = "Autor", Source = "Output", },
						Blend = Input { Value = 1, Expression = "(max(0, min(1, (Cita.U - 0.6)/0.4)))*(max(0, min(1, (Cita.U - 0.6)/0.4)))*(3-2*(max(0, min(1, (Cita.U - 0.6)/0.4))))*Cita.Xs", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 275, 0 } },
				},
				Cita = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "M4", Source = "Output", },
						Progreso = Input { SourceOp = "PROCitaAnim", Source = "Value", },
						Entrada = Input { Value = 0.25, },
						Salida = Input { Value = 0.12, },
						U = Input { Value = 1, Expression = "max(0, min(1, Cita.Progreso/Cita.Entrada))", },
						Xs = Input { Value = 1, Expression = "(max(0, min(1, (1 - Cita.Progreso)/max(Cita.Salida, 0.0001))))*(max(0, min(1, (1 - Cita.Progreso)/max(Cita.Salida, 0.0001))))*(3-2*(max(0, min(1, (1 - Cita.Progreso)/max(Cita.Salida, 0.0001)))))", },
					},
					ViewInfo = OperatorInfo { Pos = { 440, 0 } },
					UserControls = ordered() {
						Progreso = {
							LINKS_Name = "Progreso",
							LINKID_DataType = "Number",
