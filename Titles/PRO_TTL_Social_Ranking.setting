						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5, 0.5 + ((0.56) - 0.5)*iif(Ranking.Vertical > 0.5, 0.3164, 1))", },
						Size = Input { Value = 1, Expression = "1 + Ranking.Golpe*(1 - max(0, min(1, Ranking.U/0.5)))*(1 - max(0, min(1, Ranking.U/0.5)))", },
						Angle = Input { Value = 0, Expression = "-6*(1 - max(0, min(1, Ranking.U/0.5)))", },
					},
					ViewInfo = OperatorInfo { Pos = { -385, -66 } },
				},
				Anim2 = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Nombre", Source = "Output", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5, 0.5 + ((0.38 - 0.03*(1 - (max(0, min(1, (Ranking.U - 0.5)/0.5)))*(max(0, min(1, (Ranking.U - 0.5)/0.5)))*(3-2*(max(0, min(1, (Ranking.U - 0.5)/0.5)))))) - 0.5)*iif(Ranking.Vertical > 0.5, 0.3164, 1))", },
						Size = Input { Value = 1, Expression = "1", },
					},
					ViewInfo = OperatorInfo { Pos = { -330, -66 } },
				},
