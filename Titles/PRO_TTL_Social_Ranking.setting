					Inputs = {
						Background = Input { SourceOp = "M1", Source = "Output", },
						Foreground = Input { SourceOp = "Anim2", Source = "Output", },
						Blend = Input { Value = 1, Expression = "(max(0, min(1, (Ranking.U - 0.5)/0.5)))*(max(0, min(1, (Ranking.U - 0.5)/0.5)))*(3-2*(max(0, min(1, (Ranking.U - 0.5)/0.5))))*Ranking.Xs", },
