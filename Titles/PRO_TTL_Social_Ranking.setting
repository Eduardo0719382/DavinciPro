				Input18 = InstanceInput { SourceOp = "Ranking", Source = "Size", Name = "Escala", Default = 1, },
				Input19 = InstanceInput { SourceOp = "Ranking", Source = "Entrada", Name = "Duración entrada (% del clip)", Default = 0.2, },
				Input20 = InstanceInput { SourceOp = "Ranking", Source = "Salida", Name = "Duración salida (% del clip, 0 = sin salida)", Default = 0.08, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Ranking", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Lienzo = Background {
					CtrlWShown = false,
