						U = Input { Value = 1, Expression = "max(0, min(1, Ranking.Progreso/Ranking.Entrada))", },
						Xs = Input { Value = 1, Expression = "(max(0, min(1, (1 - Ranking.Progreso)/max(Ranking.Salida, 0.0001))))*(max(0, min(1, (1 - Ranking.Progreso)/max(Ranking.Salida, 0.0001))))*(3-2*(max(0, min(1, (1 - Ranking.Progreso)/max(Ranking.Salida, 0.0001)))))", },
