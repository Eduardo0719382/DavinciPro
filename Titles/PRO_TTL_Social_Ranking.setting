						Size = Input { Value = 1, Expression = "iif(Ranking.Vertical > 0.5, 2, 1)", },
					},
					ViewInfo = OperatorInfo { Pos = { 385, 0 } },
				},
				Ranking = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Formato", Source = "Output", },
