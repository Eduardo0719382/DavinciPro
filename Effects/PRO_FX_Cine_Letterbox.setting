{
	Tools = ordered() {
		PRO_FX_Cine_Letterbox = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				MainInput1 = InstanceInput { SourceOp = "ConSup", Source = "Background", },
				Input1 = InstanceInput { SourceOp = "Barras", Source = "AspDest", Name = "Aspecto destino", Default = 2.39, },
				Input2 = InstanceInput { SourceOp = "Barras", Source = "AspTL", Name = "Aspecto del timeline (16:9 = 1.778, 9:16 = 0.5625)", Default = 1.7778, },
				Input3 = InstanceInput { SourceOp = "Barras", Source = "Entrada", Name = "Duración entrada (% del clip)", Default = 0.1, },
				Input4 = InstanceInput { SourceOp = "Barras", Source = "Salida", Name = "Duración salida (% del clip, 0 = sin salida)", Default = 0, },
				Input5 = InstanceInput { SourceOp = "Negro", Source = "TopLeftRed", Name = "Color de las barras", ControlGroup = 5, Default = 0, },
				Input6 = InstanceInput { SourceOp = "Negro", Source = "TopLeftGreen", ControlGroup = 5, Default = 0, },
				Input7 = InstanceInput { SourceOp = "Negro", Source = "TopLeftBlue", ControlGroup = 5, Default = 0, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Barras", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Negro = Background {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 0, },
						TopLeftGreen = Input { Value = 0, },
						TopLeftBlue = Input { Value = 0, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { -110, -66 } },
				},
				BarraSup = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Negro", Source = "Output", },
						Center = Input { Value = { 0.5, 1.5 }, Expression = "Point(0.5, 1.5 - Barras.H)", },
					},
					ViewInfo = OperatorInfo { Pos = { 0, -99 } },
				},
				BarraInf = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Negro", Source = "Output", },
						Center = Input { Value = { 0.5, -0.5 }, Expression = "Point(0.5, -0.5 + Barras.H)", },
					},
					ViewInfo = OperatorInfo { Pos = { 0, -33 } },
				},
				ConSup = Merge {
					CtrlWShown = false,
					Inputs = {
						Foreground = Input { SourceOp = "BarraSup", Source = "Output", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 } },
				},
				Barras = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "ConSup", Source = "Output", },
						Foreground = Input { SourceOp = "BarraInf", Source = "Output", },
						PerformDepthMerge = Input { Value = 0, },
						Progreso = Input { SourceOp = "PROCineLetterboxAnim", Source = "Value", },
						Entrada = Input { Value = 0.1, },
						Salida = Input { Value = 0, },
						Raw = Input { Value = 1, Expression = "max(0, min(1, min(Barras.Progreso/max(Barras.Entrada, 0.0001), (1-Barras.Progreso)/max(Barras.Salida, 0.0001))))", },
						Env = Input { Value = 1, Expression = "(Barras.Raw)*(Barras.Raw)*(3-2*(Barras.Raw))", },
						AspDest = Input { Value = 2.39, },
						AspTL = Input { Value = 1.7778, },
						H = Input { Value = 0, Expression = "max(0, (1 - Barras.AspTL/Barras.AspDest)/2)*Barras.Env", },
					},
					ViewInfo = OperatorInfo { Pos = { 220, 0 } },
					UserControls = ordered() {
						Progreso = {
							LINKS_Name = "Progreso",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Entrada = {
							LINKS_Name = "Duración entrada (% del clip)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.1,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Salida = {
							LINKS_Name = "Duración salida (% del clip, 0 = sin salida)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Raw = {
							LINKS_Name = "Envolvente lineal",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
						Env = {
							LINKS_Name = "Envolvente suave",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
						AspDest = {
							LINKS_Name = "Aspecto destino",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 2.39,
							INP_MinScale = 1,
							INP_MaxScale = 3,
							INP_MinAllowed = 1,
							INP_MaxAllowed = 3,
							ICS_ControlPage = "Controls",
						},
						AspTL = {
							LINKS_Name = "Aspecto del timeline (16:9 = 1.778, 9:16 = 0.5625)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1.7778,
							INP_MinScale = 0.4,
							INP_MaxScale = 3,
							INP_MinAllowed = 0.4,
							INP_MaxAllowed = 3,
							ICS_ControlPage = "Controls",
						},
						H = {
							LINKS_Name = "Altura interna",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
					},
				},
			},
		},
		PROCineLetterboxAnim = LUTLookup {
			Inputs = {
			},
			CtrlWZoom = false,
		},
	},
	ActiveTool = "PRO_FX_Cine_Letterbox"
}
