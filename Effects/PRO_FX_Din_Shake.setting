{
	Tools = ordered() {
		PRO_FX_Din_Shake = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				MainInput1 = InstanceInput { SourceOp = "Sacudida", Source = "Input", },
				Input1 = InstanceInput { SourceOp = "Sacudida", Source = "Intensidad", Name = "Intensidad", Default = 0.3, },
				Input2 = InstanceInput { SourceOp = "Sacudida", Source = "Velocidad", Name = "Velocidad", Default = 1, },
				Input3 = InstanceInput { SourceOp = "Sacudida", Source = "Rotacion", Name = "Rotación", Default = 0.3, },
				Input4 = InstanceInput { SourceOp = "Sacudida", Source = "Decaimiento", Name = "Decaimiento (1 = se calma al final)", Default = 0, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Sacudida", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Sacudida = Transform {
					CtrlWShown = false,
					Inputs = {
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5 + Sacudida.Amp*(0.6*sin(time*0.9*Sacudida.Velocidad) + 0.4*sin(time*2.3*Sacudida.Velocidad + 1.3)), 0.5 + Sacudida.Amp*(0.6*sin(time*1.1*Sacudida.Velocidad + 0.7) + 0.4*sin(time*2.9*Sacudida.Velocidad + 2.1)))", },
						Size = Input { Value = 1, Expression = "1 + Sacudida.Intensidad*0.07 + Sacudida.Rotacion*0.05", },
						Angle = Input { Value = 0, Expression = "Sacudida.Rotacion*2.5*(1 - Sacudida.Decaimiento*Sacudida.Progreso)*sin(time*0.7*Sacudida.Velocidad + 0.4)", },
						Progreso = Input { SourceOp = "PRODinShakeAnim", Source = "Value", },
						Intensidad = Input { Value = 0.3, },
						Velocidad = Input { Value = 1, },
						Rotacion = Input { Value = 0.3, },
						Decaimiento = Input { Value = 0, },
						Amp = Input { Value = 0, Expression = "Sacudida.Intensidad*0.03*(1 - Sacudida.Decaimiento*Sacudida.Progreso)", },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 } },
					UserControls = ordered() {
						Progreso = {
							LINKS_Name = "Progreso",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Intensidad = {
							LINKS_Name = "Intensidad",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.3,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Velocidad = {
							LINKS_Name = "Velocidad",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0.1,
							INP_MaxScale = 3,
							INP_MinAllowed = 0.1,
							INP_MaxAllowed = 3,
							ICS_ControlPage = "Controls",
						},
						Rotacion = {
							LINKS_Name = "Rotación",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.3,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Decaimiento = {
							LINKS_Name = "Decaimiento (1 = se calma al final)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Amp = {
							LINKS_Name = "Amplitud interna",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
					},
				},
			},
		},
		PRODinShakeAnim = LUTLookup {
			Inputs = {
			},
			CtrlWZoom = false,
		},
	},
	ActiveTool = "PRO_FX_Din_Shake"
}
