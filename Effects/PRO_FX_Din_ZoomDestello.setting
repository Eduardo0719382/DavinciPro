{
	Tools = ordered() {
		PRO_FX_Din_ZoomDestello = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				MainInput1 = InstanceInput { SourceOp = "Acerca", Source = "Input", },
				Input1 = InstanceInput { SourceOp = "ZoomDestello", Source = "Zoom", Name = "Zoom inicial", Default = 0.3, },
				Input2 = InstanceInput { SourceOp = "ZoomDestello", Source = "Destello", Name = "Destello", Default = 0.8, },
				Input3 = InstanceInput { SourceOp = "ZoomDestello", Source = "Desenfoque", Name = "Desenfoque", Default = 12, },
				Input4 = InstanceInput { SourceOp = "Flash", Source = "TopLeftRed", Name = "Color del destello", ControlGroup = 4, Default = 1, },
				Input5 = InstanceInput { SourceOp = "Flash", Source = "TopLeftGreen", ControlGroup = 4, Default = 1, },
				Input6 = InstanceInput { SourceOp = "Flash", Source = "TopLeftBlue", ControlGroup = 4, Default = 1, },
				Input7 = InstanceInput { SourceOp = "Acerca", Source = "Center", Name = "Centro del zoom", },
				Input8 = InstanceInput { SourceOp = "ZoomDestello", Source = "Entrada", Name = "Duración entrada (% del clip)", Default = 0.1, },
				Input9 = InstanceInput { SourceOp = "ZoomDestello", Source = "Salida", Name = "Duración salida (% del clip, 0 = sin salida)", Default = 0, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "ZoomDestello", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Acerca = Transform {
					CtrlWShown = false,
					Inputs = {
						Size = Input { Value = 1, Expression = "1 + ZoomDestello.Zoom*(1 - ZoomDestello.Env)", },
						Center = Input { Value = { 0.5, 0.5 }, },
					},
					ViewInfo = OperatorInfo { Pos = { -165, 0 } },
				},
				Suaviza = Blur {
					CtrlWShown = false,
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" }, },
						XBlurSize = Input { Value = 0, Expression = "ZoomDestello.Desenfoque*(1 - ZoomDestello.Env)", },
						Input = Input { SourceOp = "Acerca", Source = "Output", },
					},
					ViewInfo = OperatorInfo { Pos = { -110, 0 } },
				},
				Flash = Background {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 1, },
						TopLeftGreen = Input { Value = 1, },
						TopLeftBlue = Input { Value = 1, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { -55, -66 } },
				},
				ConFlash = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "Suaviza", Source = "Output", },
						Foreground = Input { SourceOp = "Flash", Source = "Output", },
						ApplyMode = Input { Value = FuID { "Screen" }, },
						Blend = Input { Value = 0, Expression = "ZoomDestello.Destello*(1 - ZoomDestello.Env)*(1 - ZoomDestello.Env)", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -55, 0 } },
				},
				ZoomDestello = BrightnessContrast {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "ConFlash", Source = "Output", },
						Progreso = Input { SourceOp = "PRODinZoomDestelloAnim", Source = "Value", },
						Zoom = Input { Value = 0.3, },
						Destello = Input { Value = 0.8, },
						Desenfoque = Input { Value = 12, },
						Entrada = Input { Value = 0.1, },
						Salida = Input { Value = 0, },
						Raw = Input { Value = 1, Expression = "max(0, min(1, min(ZoomDestello.Progreso/max(ZoomDestello.Entrada, 0.0001), (1-ZoomDestello.Progreso)/max(ZoomDestello.Salida, 0.0001))))", },
						Env = Input { Value = 1, Expression = "(ZoomDestello.Raw)*(ZoomDestello.Raw)*(3-2*(ZoomDestello.Raw))", },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 } },
					UserControls = ordered() {
						Progreso = {
							LINKS_Name = "Progreso",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Entrada = {
							LINKS_Name = "Duración entrada (% del clip)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.1,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Salida = {
							LINKS_Name = "Duración salida (% del clip, 0 = sin salida)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Zoom = {
							LINKS_Name = "Zoom inicial",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.3,
							INP_MinScale = 0,
							INP_MaxScale = 2,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 2,
							ICS_ControlPage = "Controls",
						},
						Destello = {
							LINKS_Name = "Destello",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.8,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Desenfoque = {
							LINKS_Name = "Desenfoque",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 12,
							INP_MinScale = 0,
							INP_MaxScale = 80,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 80,
							ICS_ControlPage = "Controls",
						},
						Raw = {
							LINKS_Name = "Envolvente lineal",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
						Env = {
							LINKS_Name = "Envolvente suave",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
					},
				},
			},
		},
		PRODinZoomDestelloAnim = LUTLookup {
			Inputs = {
			},
			CtrlWZoom = false,
		},
	},
	ActiveTool = "PRO_FX_Din_ZoomDestello"
}
