{
	Tools = ordered() {
		PRO_FX_Din_Estrobo = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				MainInput1 = InstanceInput { SourceOp = "Entrada", Source = "Input", },
				Input1 = InstanceInput { SourceOp = "Estrobo", Source = "BPM", Name = "BPM de la música", Default = 120, },
				Input2 = InstanceInput { SourceOp = "Estrobo", Source = "FPS", Name = "Fotogramas por segundo", Default = 30, },
				Input3 = InstanceInput { SourceOp = "Estrobo", Source = "Desfase", Name = "Desfase (fotogramas hasta el primer golpe)", Default = 0, },
				Input4 = InstanceInput { SourceOp = "Estrobo", Source = "Negativo", Name = "Negativo (desmarcado = blanco y negro)", Default = 0, },
				Input5 = InstanceInput { SourceOp = "Estrobo", Source = "Mezcla", Name = "Intensidad", Default = 1, },
				Input6 = InstanceInput { SourceOp = "BN", Source = "Contrast", Name = "Contraste del blanco y negro", Default = 0.45, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Estrobo", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Entrada = PipeRouter {
					CtrlWShown = false,
					ViewInfo = PipeRouterInfo { Pos = { -330, 0 } },
				},
				BN = BrightnessContrast {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Entrada", Source = "Output", },
						Saturation = Input { Value = 0, },
						Contrast = Input { Value = 0.45, },
					},
					ViewInfo = OperatorInfo { Pos = { -275, -66 } },
				},
				Blanco = Background {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 1, },
						TopLeftGreen = Input { Value = 1, },
						TopLeftBlue = Input { Value = 1, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { -275, -132 } },
				},
				Inverso = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "Blanco", Source = "Output", },
						Foreground = Input { SourceOp = "Entrada", Source = "Output", },
						ApplyMode = Input { Value = FuID { "Difference" }, },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -220, -132 } },
				},
				ConBN = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "Entrada", Source = "Output", },
						Foreground = Input { SourceOp = "BN", Source = "Output", },
						Blend = Input { Value = 0, Expression = "Estrobo.Mezcla*(floor((max(0, time - Estrobo.Desfase)/(Estrobo.FPS*60/Estrobo.BPM))) - 2*floor(floor((max(0, time - Estrobo.Desfase)/(Estrobo.FPS*60/Estrobo.BPM)))/2))*(1 - Estrobo.Negativo)", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -165, 0 } },
				},
				ConInverso = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "ConBN", Source = "Output", },
						Foreground = Input { SourceOp = "Inverso", Source = "Output", },
						Blend = Input { Value = 0, Expression = "Estrobo.Mezcla*(floor((max(0, time - Estrobo.Desfase)/(Estrobo.FPS*60/Estrobo.BPM))) - 2*floor(floor((max(0, time - Estrobo.Desfase)/(Estrobo.FPS*60/Estrobo.BPM)))/2))*Estrobo.Negativo", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -110, 0 } },
				},
				Estrobo = BrightnessContrast {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "ConInverso", Source = "Output", },
						BPM = Input { Value = 120, },
						FPS = Input { Value = 30, },
						Desfase = Input { Value = 0, },
						Negativo = Input { Value = 0, },
						Mezcla = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { -55, 0 } },
					UserControls = ordered() {
						BPM = {
							LINKS_Name = "BPM de la música",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 120,
							INP_MinScale = 40,
							INP_MaxScale = 220,
							INP_MinAllowed = 40,
							INP_MaxAllowed = 220,
							ICS_ControlPage = "Controls",
						},
						FPS = {
							LINKS_Name = "Fotogramas por segundo",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 30,
							INP_MinScale = 1,
							INP_MaxScale = 120,
							INP_MinAllowed = 1,
							INP_MaxAllowed = 120,
							ICS_ControlPage = "Controls",
						},
						Desfase = {
							LINKS_Name = "Desfase (fotogramas hasta el primer golpe)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 120,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 120,
							ICS_ControlPage = "Controls",
						},
						Negativo = {
							LINKS_Name = "Negativo (desmarcado = blanco y negro)",
							LINKID_DataType = "Number",
							INPID_InputControl = "CheckboxControl",
							INP_Integer = true,
							CBC_TriState = false,
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Mezcla = {
							LINKS_Name = "Intensidad",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
					},
				},
			},
		},
	},
	ActiveTool = "PRO_FX_Din_Estrobo"
}
