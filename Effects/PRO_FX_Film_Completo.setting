{
	Tools = ordered() {
		PRO_FX_Film_Completo = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				MainInput1 = InstanceInput { SourceOp = "Entrada", Source = "Input", },
				Input1 = InstanceInput { SourceOp = "Pelicula", Source = "Formato", Name = "Formato (mm): 8 / 16 / 35 / 65", Default = 35, },
				Input2 = InstanceInput { SourceOp = "Pelicula", Source = "Grano", Name = "Grano", Default = 0.1, },
				Input3 = InstanceInput { SourceOp = "Pelicula", Source = "Halation", Name = "Halation", Default = 0.3, },
				Input4 = InstanceInput { SourceOp = "HalColor", Source = "TopLeftRed", Name = "Color de halation", ControlGroup = 4, Default = 1, },
				Input5 = InstanceInput { SourceOp = "HalColor", Source = "TopLeftGreen", ControlGroup = 4, Default = 0.25, },
				Input6 = InstanceInput { SourceOp = "HalColor", Source = "TopLeftBlue", ControlGroup = 4, Default = 0.08, },
				Input7 = InstanceInput { SourceOp = "Pelicula", Source = "Bloom", Name = "Bloom", Default = 0.2, },
				Input8 = InstanceInput { SourceOp = "Pelicula", Source = "Weave", Name = "Gate weave", Default = 1, },
				Input9 = InstanceInput { SourceOp = "Pelicula", Source = "Respiracion", Name = "Respiración", Default = 1, },
				Input10 = InstanceInput { SourceOp = "Pelicula", Source = "Vineta", Name = "Viñeta", Default = 0.25, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Pelicula", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Entrada = PipeRouter {
					CtrlWShown = false,
					ViewInfo = PipeRouterInfo { Pos = { -550, 0 } },
				},
				MecWeave = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Entrada", Source = "Output", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5 + Pelicula.Weave*Pelicula.EscalaFormato*0.0015*(sin(time*0.37) + 0.5*sin(time*1.13 + 2)), 0.5 + Pelicula.Weave*Pelicula.EscalaFormato*0.0025*(sin(time*0.29 + 1) + 0.5*sin(time*0.91)))", },
						Size = Input { Value = 1, Expression = "1 + Pelicula.Weave*Pelicula.EscalaFormato*0.006", },
					},
					ViewInfo = OperatorInfo { Pos = { -440, 0 } },
				},
				MecRespira = BrightnessContrast {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "MecWeave", Source = "Output", },
						Gain = Input { Value = 1, Expression = "1 + Pelicula.Respiracion*Pelicula.EscalaFormato*0.025*sin(time*7.3)*sin(time*3.1 + 1)", },
						Saturation = Input { Value = 1, Expression = "1 + Pelicula.Respiracion*Pelicula.EscalaFormato*0.03*sin(time*5.7 + 2)*sin(time*2.3)", },
					},
					ViewInfo = OperatorInfo { Pos = { -385, 0 } },
				},
				HalAltas = BrightnessContrast {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "MecRespira", Source = "Output", },
						Low = Input { Value = 0.75, },
						High = Input { Value = 1, },
						Saturation = Input { Value = 0.6, },
					},
					ViewInfo = OperatorInfo { Pos = { -330, -66 } },
				},
				HalBlur = Blur {
					CtrlWShown = false,
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" }, },
						XBlurSize = Input { Value = 30, },
						Input = Input { SourceOp = "HalAltas", Source = "Output", },
					},
					ViewInfo = OperatorInfo { Pos = { -275, -66 } },
				},
				HalColor = Background {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 1, },
						TopLeftGreen = Input { Value = 0.25, },
						TopLeftBlue = Input { Value = 0.08, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { -275, -99 } },
				},
				HalTenido = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "HalBlur", Source = "Output", },
						Foreground = Input { SourceOp = "HalColor", Source = "Output", },
						ApplyMode = Input { Value = FuID { "Multiply" }, },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -220, -66 } },
				},
				Halation = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "MecRespira", Source = "Output", },
						Foreground = Input { SourceOp = "HalTenido", Source = "Output", },
						ApplyMode = Input { Value = FuID { "Screen" }, },
						Blend = Input { Value = 0.3, Expression = "Pelicula.Halation", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -165, 0 } },
				},
				BlAltas = BrightnessContrast {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Halation", Source = "Output", },
						Low = Input { Value = 0.6, },
						High = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { -110, -66 } },
				},
				BlHalo = Blur {
					CtrlWShown = false,
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" }, },
						XBlurSize = Input { Value = 60, },
						Input = Input { SourceOp = "BlAltas", Source = "Output", },
					},
					ViewInfo = OperatorInfo { Pos = { -55, -66 } },
				},
				BlBloom = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "Halation", Source = "Output", },
						Foreground = Input { SourceOp = "BlHalo", Source = "Output", },
						ApplyMode = Input { Value = FuID { "Screen" }, },
						Blend = Input { Value = 0.2, Expression = "Pelicula.Bloom", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 55, 0 } },
				},
				GrRuido = FastNoise {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						Detail = Input { Value = 4, },
						Contrast = Input { Value = 1.5, },
						XScale = Input { Value = 40, },
						SeetheRate = Input { Value = 1, },
						Discontinuous = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 66 } },
				},
				GrGrano = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "BlBloom", Source = "Output", },
						Foreground = Input { SourceOp = "GrRuido", Source = "Output", },
						ApplyMode = Input { Value = FuID { "Overlay" }, },
						Blend = Input { Value = 0.1, Expression = "Pelicula.Grano*Pelicula.EscalaGrano", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 165, 0 } },
				},
				VinOvalo = EllipseMask {
					CtrlWShown = false,
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" }, },
						OutputSize = Input { Value = FuID { "Custom" }, },
						MaskWidth = Input { Value = 1920, },
						MaskHeight = Input { Value = 1080, },
						PixelAspect = Input { Value = { 1, 1 }, },
						UseFrameFormatSettings = Input { Value = 1, },
						ClippingMode = Input { Value = FuID { "None" }, },
						Invert = Input { Value = 1, },
						SoftEdge = Input { Value = 0.5, },
						Width = Input { Value = 1.25, },
						Height = Input { Value = 0.85, },
					},
					ViewInfo = OperatorInfo { Pos = { 220, -99 } },
				},
				VinSombra = Background {
					CtrlWShown = false,
					Inputs = {
						EffectMask = Input { SourceOp = "VinOvalo", Source = "Mask", },
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 0, },
						TopLeftGreen = Input { Value = 0, },
						TopLeftBlue = Input { Value = 0, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 220, -66 } },
				},
				VinVineta = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "GrGrano", Source = "Output", },
						Foreground = Input { SourceOp = "VinSombra", Source = "Output", },
						Blend = Input { Value = 0.25, Expression = "Pelicula.Vineta", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 275, 0 } },
				},
				Pelicula = BrightnessContrast {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "VinVineta", Source = "Output", },
						Formato = Input { Value = 35, },
						Grano = Input { Value = 0.1, },
						Halation = Input { Value = 0.3, },
						Bloom = Input { Value = 0.2, },
						Weave = Input { Value = 1, },
						Respiracion = Input { Value = 1, },
						Vineta = Input { Value = 0.25, },
						EscalaFormato = Input { Value = 1, Expression = "min(4, 35/Pelicula.Formato)", },
						EscalaGrano = Input { Value = 1, Expression = "min(2.5, 0.4 + 0.6*35/Pelicula.Formato)", },
					},
					ViewInfo = OperatorInfo { Pos = { 330, 0 } },
					UserControls = ordered() {
						Formato = {
							LINKS_Name = "Formato (mm): 8 / 16 / 35 / 65",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 35,
							INP_MinScale = 8,
							INP_MaxScale = 65,
							INP_MinAllowed = 8,
							INP_MaxAllowed = 65,
							ICS_ControlPage = "Controls",
						},
						Grano = {
							LINKS_Name = "Grano",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.1,
							INP_MinScale = 0,
							INP_MaxScale = 0.5,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 0.5,
							ICS_ControlPage = "Controls",
						},
						Halation = {
							LINKS_Name = "Halation",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.3,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Bloom = {
							LINKS_Name = "Bloom",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.2,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Weave = {
							LINKS_Name = "Gate weave",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
