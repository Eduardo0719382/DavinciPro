{
	Tools = ordered() {
		PRO_FX_Din_PulsoRitmo = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				MainInput1 = InstanceInput { SourceOp = "Pulso", Source = "Input", },
				Input1 = InstanceInput { SourceOp = "Ritmo", Source = "BPM", Name = "BPM de la música", Default = 120, },
				Input2 = InstanceInput { SourceOp = "Ritmo", Source = "FPS", Name = "Fotogramas por segundo", Default = 30, },
				Input3 = InstanceInput { SourceOp = "Ritmo", Source = "Desfase", Name = "Desfase (fotogramas hasta el primer golpe)", Default = 0, },
				Input4 = InstanceInput { SourceOp = "Ritmo", Source = "Zoom", Name = "Zoom por golpe", Default = 0.08, },
				Input5 = InstanceInput { SourceOp = "Ritmo", Source = "Flash", Name = "Flash por golpe", Default = 0, },
				Input6 = InstanceInput { SourceOp = "Ritmo", Source = "Temblor", Name = "Sacudida por golpe", Default = 0, },
				Input7 = InstanceInput { SourceOp = "Ritmo", Source = "Caida", Name = "Rapidez de la caída", Default = 4, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Ritmo", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Pulso = Transform {
					CtrlWShown = false,
					Inputs = {
						Size = Input { Value = 1, Expression = "1 + Ritmo.Zoom*pow(1 - ((max(0, time - Ritmo.Desfase)/(Ritmo.FPS*60/Ritmo.BPM)) - floor((max(0, time - Ritmo.Desfase)/(Ritmo.FPS*60/Ritmo.BPM)))), Ritmo.Caida)", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5 + Ritmo.Temblor*0.01*pow(1 - ((max(0, time - Ritmo.Desfase)/(Ritmo.FPS*60/Ritmo.BPM)) - floor((max(0, time - Ritmo.Desfase)/(Ritmo.FPS*60/Ritmo.BPM)))), Ritmo.Caida)*sin(time*7.3), 0.5 + Ritmo.Temblor*0.01*pow(1 - ((max(0, time - Ritmo.Desfase)/(Ritmo.FPS*60/Ritmo.BPM)) - floor((max(0, time - Ritmo.Desfase)/(Ritmo.FPS*60/Ritmo.BPM)))), Ritmo.Caida)*sin(time*9.1 + 1))", },
					},
					ViewInfo = OperatorInfo { Pos = { -110, 0 } },
				},
				Ritmo = BrightnessContrast {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Pulso", Source = "Output", },
						Gain = Input { Value = 1, Expression = "1 + Ritmo.Flash*pow(1 - ((max(0, time - Ritmo.Desfase)/(Ritmo.FPS*60/Ritmo.BPM)) - floor((max(0, time - Ritmo.Desfase)/(Ritmo.FPS*60/Ritmo.BPM)))), Ritmo.Caida)", },
						BPM = Input { Value = 120, },
						FPS = Input { Value = 30, },
						Desfase = Input { Value = 0, },
						Zoom = Input { Value = 0.08, },
						Flash = Input { Value = 0, },
						Temblor = Input { Value = 0, },
						Caida = Input { Value = 4, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 } },
					UserControls = ordered() {
						BPM = {
							LINKS_Name = "BPM de la música",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 120,
							INP_MinScale = 40,
							INP_MaxScale = 220,
							INP_MinAllowed = 40,
							INP_MaxAllowed = 220,
							ICS_ControlPage = "Controls",
						},
						FPS = {
							LINKS_Name = "Fotogramas por segundo",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 30,
							INP_MinScale = 1,
							INP_MaxScale = 120,
							INP_MinAllowed = 1,
							INP_MaxAllowed = 120,
							ICS_ControlPage = "Controls",
						},
						Desfase = {
							LINKS_Name = "Desfase (fotogramas hasta el primer golpe)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 120,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 120,
							ICS_ControlPage = "Controls",
						},
						Zoom = {
							LINKS_Name = "Zoom por golpe",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.08,
							INP_MinScale = 0,
							INP_MaxScale = 0.5,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 0.5,
							ICS_ControlPage = "Controls",
						},
						Flash = {
							LINKS_Name = "Flash por golpe",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Temblor = {
							LINKS_Name = "Sacudida por golpe",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 3,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 3,
							ICS_ControlPage = "Controls",
						},
						Caida = {
							LINKS_Name = "Rapidez de la caída",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 4,
							INP_MinScale = 1,
							INP_MaxScale = 12,
							INP_MinAllowed = 1,
							INP_MaxAllowed = 12,
							ICS_ControlPage = "Controls",
						},
					},
				},
			},
		},
	},
	ActiveTool = "PRO_FX_Din_PulsoRitmo"
}
