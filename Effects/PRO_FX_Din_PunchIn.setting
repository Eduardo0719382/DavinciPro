{
	Tools = ordered() {
		PRO_FX_Din_PunchIn = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				MainInput1 = InstanceInput { SourceOp = "Zoom", Source = "Input", },
				Input1 = InstanceInput { SourceOp = "Zoom", Source = "ZoomExtra", Name = "Zoom extra", Default = 0.15, },
				Input2 = InstanceInput { SourceOp = "Zoom", Source = "Center", Name = "Centro del zoom", },
				Input3 = InstanceInput { SourceOp = "Zoom", Source = "Entrada", Name = "Duración entrada (% del clip)", Default = 0.08, },
				Input4 = InstanceInput { SourceOp = "Zoom", Source = "Salida", Name = "Duración salida (% del clip, 0 = sin salida)", Default = 0, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Zoom", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Zoom = Transform {
					CtrlWShown = false,
					Inputs = {
						Center = Input { Value = { 0.5, 0.5 }, },
						Size = Input { Value = 1, Expression = "1 + Zoom.ZoomExtra*Zoom.Env", },
						Progreso = Input { SourceOp = "PRODinPunchInAnim", Source = "Value", },
						ZoomExtra = Input { Value = 0.15, },
						Entrada = Input { Value = 0.08, },
						Salida = Input { Value = 0, },
						Raw = Input { Value = 1, Expression = "max(0, min(1, min(Zoom.Progreso/max(Zoom.Entrada, 0.0001), (1-Zoom.Progreso)/max(Zoom.Salida, 0.0001))))", },
						Env = Input { Value = 1, Expression = "(Zoom.Raw)*(Zoom.Raw)*(3-2*(Zoom.Raw))", },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 } },
					UserControls = ordered() {
						Progreso = {
							LINKS_Name = "Progreso",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						ZoomExtra = {
							LINKS_Name = "Zoom extra",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.15,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Entrada = {
							LINKS_Name = "Duración entrada (% del clip)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.08,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Salida = {
							LINKS_Name = "Duración salida (% del clip, 0 = sin salida)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Raw = {
							LINKS_Name = "Envolvente lineal",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
						Env = {
							LINKS_Name = "Envolvente suave",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
					},
				},
			},
		},
		PRODinPunchInAnim = LUTLookup {
			Inputs = {
			},
			CtrlWZoom = false,
		},
	},
	ActiveTool = "PRO_FX_Din_PunchIn"
}
