{
	Tools = ordered() {
		PRO_FX_Din_ImpactoFrames = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				MainInput1 = InstanceInput { SourceOp = "Entrada", Source = "Input", },
				Input1 = InstanceInput { SourceOp = "Impacto", Source = "Duracion", Name = "Duración (fotogramas)", Default = 6, },
				Input2 = InstanceInput { SourceOp = "Impacto", Source = "AlRitmo", Name = "Repetir en cada golpe (usa BPM)", Default = 0, },
				Input3 = InstanceInput { SourceOp = "Impacto", Source = "Temblor", Name = "Sacudida", Default = 1, },
				Input4 = InstanceInput { SourceOp = "Tinta", Source = "Low", Name = "Umbral de tinta", Default = 0.4, },
				Input5 = InstanceInput { SourceOp = "Impacto", Source = "BPM", Name = "BPM de la música", Default = 120, },
				Input6 = InstanceInput { SourceOp = "Impacto", Source = "FPS", Name = "Fotogramas por segundo", Default = 30, },
				Input7 = InstanceInput { SourceOp = "Impacto", Source = "Desfase", Name = "Desfase (fotogramas hasta el primer golpe)", Default = 0, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Impacto", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Entrada = PipeRouter {
					CtrlWShown = false,
					ViewInfo = PipeRouterInfo { Pos = { -385, 0 } },
				},
				Tinta = BrightnessContrast {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Entrada", Source = "Output", },
						Saturation = Input { Value = 0, },
						Low = Input { Value = 0.4, },
						High = Input { Value = 0.6, },
					},
					ViewInfo = OperatorInfo { Pos = { -330, -66 } },
				},
				Blanco = Background {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 1, },
						TopLeftGreen = Input { Value = 1, },
						TopLeftBlue = Input { Value = 1, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { -330, -132 } },
				},
				Negativo = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "Tinta", Source = "Output", },
						Foreground = Input { SourceOp = "Blanco", Source = "Output", },
						ApplyMode = Input { Value = FuID { "Difference" }, },
						Blend = Input { Value = 0, Expression = "(floor(iif(Impacto.AlRitmo > 0.5, ((max(0, time - Impacto.Desfase)/(Impacto.FPS*60/Impacto.BPM)) - floor((max(0, time - Impacto.Desfase)/(Impacto.FPS*60/Impacto.BPM))))*(Impacto.FPS*60/Impacto.BPM), time)/2) - 2*floor(iif(Impacto.AlRitmo > 0.5, ((max(0, time - Impacto.Desfase)/(Impacto.FPS*60/Impacto.BPM)) - floor((max(0, time - Impacto.Desfase)/(Impacto.FPS*60/Impacto.BPM))))*(Impacto.FPS*60/Impacto.BPM), time)/4))", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -275, -66 } },
				},
				Golpe = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Negativo", Source = "Output", },
						Size = Input { Value = 1.06, },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5 + Impacto.Temblor*0.012*sin(time*11.3), 0.5 + Impacto.Temblor*0.012*sin(time*13.7 + 1))", },
					},
					ViewInfo = OperatorInfo { Pos = { -220, -66 } },
				},
				Mezcla = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "Entrada", Source = "Output", },
						Foreground = Input { SourceOp = "Golpe", Source = "Output", },
						Blend = Input { Value = 0, Expression = "Impacto.Act", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -165, 0 } },
				},
				Impacto = BrightnessContrast {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Mezcla", Source = "Output", },
						Duracion = Input { Value = 6, },
						AlRitmo = Input { Value = 0, },
						Temblor = Input { Value = 1, },
						Act = Input { Value = 0, Expression = "iif(iif(Impacto.AlRitmo > 0.5, ((max(0, time - Impacto.Desfase)/(Impacto.FPS*60/Impacto.BPM)) - floor((max(0, time - Impacto.Desfase)/(Impacto.FPS*60/Impacto.BPM))))*(Impacto.FPS*60/Impacto.BPM), time) < Impacto.Duracion, 1, 0)", },
						BPM = Input { Value = 120, },
						FPS = Input { Value = 30, },
						Desfase = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -110, 0 } },
					UserControls = ordered() {
						Duracion = {
							LINKS_Name = "Duración (fotogramas)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 6,
							INP_MinScale = 1,
							INP_MaxScale = 30,
							INP_MinAllowed = 1,
							INP_MaxAllowed = 30,
							ICS_ControlPage = "Controls",
						},
						AlRitmo = {
							LINKS_Name = "Repetir en cada golpe (usa BPM)",
							LINKID_DataType = "Number",
							INPID_InputControl = "CheckboxControl",
							INP_Integer = true,
							CBC_TriState = false,
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Temblor = {
							LINKS_Name = "Sacudida",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 5,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 5,
							ICS_ControlPage = "Controls",
						},
						Act = {
							LINKS_Name = "Activo interno",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
						BPM = {
							LINKS_Name = "BPM de la música",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 120,
							INP_MinScale = 40,
							INP_MaxScale = 220,
							INP_MinAllowed = 40,
							INP_MaxAllowed = 220,
							ICS_ControlPage = "Controls",
						},
						FPS = {
							LINKS_Name = "Fotogramas por segundo",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 30,
							INP_MinScale = 1,
							INP_MaxScale = 120,
							INP_MinAllowed = 1,
							INP_MaxAllowed = 120,
							ICS_ControlPage = "Controls",
						},
						Desfase = {
							LINKS_Name = "Desfase (fotogramas hasta el primer golpe)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 120,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 120,
							ICS_ControlPage = "Controls",
						},
					},
				},
			},
		},
	},
	ActiveTool = "PRO_FX_Din_ImpactoFrames"
}
