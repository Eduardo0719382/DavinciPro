{
	Tools = ordered() {
		PRO_FX_Social_PantallaDividida = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				MainInput1 = InstanceInput { SourceOp = "Colocar", Source = "Input", },
				Input1 = InstanceInput { SourceOp = "Celda", Source = "Columnas", Name = "Columnas", Default = 1, },
				Input2 = InstanceInput { SourceOp = "Celda", Source = "Filas", Name = "Filas", Default = 2, },
				Input3 = InstanceInput { SourceOp = "Celda", Source = "Columna", Name = "Columna de este clip", Default = 1, },
				Input4 = InstanceInput { SourceOp = "Celda", Source = "Fila", Name = "Fila de este clip (1 = arriba)", Default = 1, },
				Input5 = InstanceInput { SourceOp = "Celda", Source = "Separacion", Name = "Separación", Default = 0.01, },
				Input6 = InstanceInput { SourceOp = "Celda", Source = "Redondeo", Name = "Redondeo de esquinas", Default = 0, },
				Input7 = InstanceInput { SourceOp = "Celda", Source = "Zoom", Name = "Zoom dentro de la celda", Default = 1, },
				Input8 = InstanceInput { SourceOp = "Celda", Source = "MoverX", Name = "Encuadre X", Default = 0, },
				Input9 = InstanceInput { SourceOp = "Celda", Source = "MoverY", Name = "Encuadre Y", Default = 0, },
				Input10 = InstanceInput { SourceOp = "Celda", Source = "Aspecto", Name = "Aspecto del timeline (16:9 = 1.778, 9:16 = 0.5625)", Default = 0.5625, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Celda", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Colocar = Transform {
					CtrlWShown = false,
					Inputs = {
						Center = Input { Value = { 0.5, 0.75 }, Expression = "Point(((Celda.Columna - 0.5)*(1/Celda.Columnas)) + Celda.MoverX, (1 - (Celda.Fila - 0.5)*(1/Celda.Filas)) + Celda.MoverY)", },
						Size = Input { Value = 1, Expression = "max((1/Celda.Columnas), (1/Celda.Filas))*Celda.Zoom", },
					},
					ViewInfo = OperatorInfo { Pos = { -220, 0 } },
				},
				Vacio = Background {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 0, },
						TopLeftGreen = Input { Value = 0, },
						TopLeftBlue = Input { Value = 0, },
						TopLeftAlpha = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -220, -66 } },
				},
				MascCelda = RectangleMask {
					CtrlWShown = false,
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" }, },
						OutputSize = Input { Value = FuID { "Custom" }, },
						MaskWidth = Input { Value = 1920, },
						MaskHeight = Input { Value = 1080, },
						PixelAspect = Input { Value = { 1, 1 }, },
						UseFrameFormatSettings = Input { Value = 1, },
						ClippingMode = Input { Value = FuID { "None" }, },
						Center = Input { Value = { 0.5, 0.75 }, Expression = "Point(((Celda.Columna - 0.5)*(1/Celda.Columnas)), (1 - (Celda.Fila - 0.5)*(1/Celda.Filas)))", },
						Width = Input { Value = 1, Expression = "max(0, (1/Celda.Columnas) - Celda.Separacion)", },
						Height = Input { Value = 0.89, Expression = "max(0, (1/Celda.Filas)/Celda.Aspecto - Celda.Separacion)", },
						CornerRadius = Input { Value = 0, Expression = "Celda.Redondeo", },
					},
					ViewInfo = OperatorInfo { Pos = { -165, -99 } },
				},
				Celda = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "Vacio", Source = "Output", },
						Foreground = Input { SourceOp = "Colocar", Source = "Output", },
						Blend = Input { Value = 1, },
						PerformDepthMerge = Input { Value = 0, },
						EffectMask = Input { SourceOp = "MascCelda", Source = "Mask", },
						Columnas = Input { Value = 1, },
						Filas = Input { Value = 2, },
						Columna = Input { Value = 1, },
						Fila = Input { Value = 1, },
						Separacion = Input { Value = 0.01, },
						Redondeo = Input { Value = 0, },
						Zoom = Input { Value = 1, },
						MoverX = Input { Value = 0, },
						MoverY = Input { Value = 0, },
						Aspecto = Input { Value = 0.5625, },
					},
					ViewInfo = OperatorInfo { Pos = { -110, 0 } },
					UserControls = ordered() {
						Columnas = {
							LINKS_Name = "Columnas",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
							INP_Default = 1,
							INP_MinScale = 1,
							INP_MaxScale = 4,
							INP_MinAllowed = 1,
							INP_MaxAllowed = 4,
							ICS_ControlPage = "Controls",
						},
						Filas = {
							LINKS_Name = "Filas",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
							INP_Default = 2,
							INP_MinScale = 1,
							INP_MaxScale = 4,
							INP_MinAllowed = 1,
							INP_MaxAllowed = 4,
							ICS_ControlPage = "Controls",
						},
						Columna = {
							LINKS_Name = "Columna de este clip",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
							INP_Default = 1,
							INP_MinScale = 1,
							INP_MaxScale = 4,
							INP_MinAllowed = 1,
							INP_MaxAllowed = 4,
							ICS_ControlPage = "Controls",
						},
						Fila = {
							LINKS_Name = "Fila de este clip (1 = arriba)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
							INP_Default = 1,
							INP_MinScale = 1,
							INP_MaxScale = 4,
							INP_MinAllowed = 1,
							INP_MaxAllowed = 4,
							ICS_ControlPage = "Controls",
						},
						Separacion = {
							LINKS_Name = "Separación",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.01,
							INP_MinScale = 0,
							INP_MaxScale = 0.1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 0.1,
							ICS_ControlPage = "Controls",
						},
						Redondeo = {
							LINKS_Name = "Redondeo de esquinas",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 0.5,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 0.5,
							ICS_ControlPage = "Controls",
						},
						Zoom = {
							LINKS_Name = "Zoom dentro de la celda",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0.5,
							INP_MaxScale = 3,
							INP_MinAllowed = 0.5,
							INP_MaxAllowed = 3,
							ICS_ControlPage = "Controls",
						},
						MoverX = {
							LINKS_Name = "Encuadre X",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = -0.5,
							INP_MaxScale = 0.5,
							INP_MinAllowed = -0.5,
							INP_MaxAllowed = 0.5,
							ICS_ControlPage = "Controls",
						},
						MoverY = {
							LINKS_Name = "Encuadre Y",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = -0.5,
							INP_MaxScale = 0.5,
							INP_MinAllowed = -0.5,
							INP_MaxAllowed = 0.5,
