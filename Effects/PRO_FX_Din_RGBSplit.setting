{
	Tools = ordered() {
		PRO_FX_Din_RGBSplit = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				MainInput1 = InstanceInput { SourceOp = "Entrada", Source = "Input", },
				Input1 = InstanceInput { SourceOp = "Aberracion", Source = "Separacion", Name = "Separación", Default = 0.006, },
				Input2 = InstanceInput { SourceOp = "Aberracion", Source = "Angulo", Name = "Ángulo (grados)", Default = 0, },
				Input3 = InstanceInput { SourceOp = "Aberracion", Source = "Pulso", Name = "Pulso glitch", Default = 0, },
				Input4 = InstanceInput { SourceOp = "Aberracion", Source = "VelPulso", Name = "Velocidad del pulso", Default = 1, },
				Input5 = InstanceInput { SourceOp = "Aberracion", Source = "Blend", Name = "Mezcla con el original", Default = 1, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Aberracion", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Entrada = PipeRouter {
					CtrlWShown = false,
					ViewInfo = PipeRouterInfo { Pos = { -330, 0 } },
				},
				Rojo = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Entrada", Source = "Output", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5 + Aberracion.Off*sin(Aberracion.Angulo*3.14159265/180 + 1.5707963), 0.5 + Aberracion.Off*sin(Aberracion.Angulo*3.14159265/180)*1.7778)", },
					},
					ViewInfo = OperatorInfo { Pos = { -220, -66 } },
				},
				Azul = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Entrada", Source = "Output", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5 - Aberracion.Off*sin(Aberracion.Angulo*3.14159265/180 + 1.5707963), 0.5 - Aberracion.Off*sin(Aberracion.Angulo*3.14159265/180)*1.7778)", },
					},
					ViewInfo = OperatorInfo { Pos = { -220, 66 } },
				},
				SoloRojo = Background {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 1, },
						TopLeftGreen = Input { Value = 0, },
						TopLeftBlue = Input { Value = 0, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { -110, -99 } },
				},
				SoloVerde = Background {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 0, },
						TopLeftGreen = Input { Value = 1, },
						TopLeftBlue = Input { Value = 0, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { -110, -33 } },
				},
				SoloAzul = Background {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 0, },
						TopLeftGreen = Input { Value = 0, },
						TopLeftBlue = Input { Value = 1, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { -110, 99 } },
				},
				CanalR = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "Rojo", Source = "Output", },
						Foreground = Input { SourceOp = "SoloRojo", Source = "Output", },
						ApplyMode = Input { Value = FuID { "Multiply" }, },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, -66 } },
				},
				CanalG = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "Entrada", Source = "Output", },
						Foreground = Input { SourceOp = "SoloVerde", Source = "Output", },
						ApplyMode = Input { Value = FuID { "Multiply" }, },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 } },
				},
				CanalB = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "Azul", Source = "Output", },
						Foreground = Input { SourceOp = "SoloAzul", Source = "Output", },
						ApplyMode = Input { Value = FuID { "Multiply" }, },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 66 } },
				},
				SumaRG = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "CanalR", Source = "Output", },
						Foreground = Input { SourceOp = "CanalG", Source = "Output", },
						ApplyMode = Input { Value = FuID { "Screen" }, },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, -33 } },
				},
				SumaRGB = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "SumaRG", Source = "Output", },
						Foreground = Input { SourceOp = "CanalB", Source = "Output", },
						ApplyMode = Input { Value = FuID { "Screen" }, },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 33 } },
				},
				Aberracion = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "Entrada", Source = "Output", },
						Foreground = Input { SourceOp = "SumaRGB", Source = "Output", },
						Blend = Input { Value = 1, },
						PerformDepthMerge = Input { Value = 0, },
						Separacion = Input { Value = 0.006, },
						Angulo = Input { Value = 0, },
						Pulso = Input { Value = 0, },
						VelPulso = Input { Value = 1, },
						Off = Input { Value = 0, Expression = "Aberracion.Separacion*(1 - Aberracion.Pulso + Aberracion.Pulso*sin(time*1.7*Aberracion.VelPulso)*sin(time*1.7*Aberracion.VelPulso)*sin(time*0.37*Aberracion.VelPulso + 1)*sin(time*0.37*Aberracion.VelPulso + 1)*4)", },
					},
					ViewInfo = OperatorInfo { Pos = { 220, 0 } },
					UserControls = ordered() {
						Separacion = {
							LINKS_Name = "Separación",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.006,
							INP_MinScale = 0,
							INP_MaxScale = 0.05,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 0.05,
							ICS_ControlPage = "Controls",
						},
						Angulo = {
							LINKS_Name = "Ángulo (grados)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = -180,
							INP_MaxScale = 180,
							INP_MinAllowed = -180,
							INP_MaxAllowed = 180,
							ICS_ControlPage = "Controls",
						},
						Pulso = {
							LINKS_Name = "Pulso glitch",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						VelPulso = {
							LINKS_Name = "Velocidad del pulso",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0.1,
							INP_MaxScale = 4,
							INP_MinAllowed = 0.1,
							INP_MaxAllowed = 4,
							ICS_ControlPage = "Controls",
						},
						Off = {
							LINKS_Name = "Desplazamiento interno",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
					},
				},
			},
		},
	},
	ActiveTool = "PRO_FX_Din_RGBSplit"
}
