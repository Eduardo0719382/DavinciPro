{
	Tools = ordered() {
		PRO_FX_Din_KenBurns = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				MainInput1 = InstanceInput { SourceOp = "KenBurns", Source = "Input", },
				Input1 = InstanceInput { SourceOp = "KenBurns", Source = "ZoomIni", Name = "Zoom inicial", Default = 1.1, },
				Input2 = InstanceInput { SourceOp = "KenBurns", Source = "ZoomFin", Name = "Zoom final", Default = 1.3, },
				Input3 = InstanceInput { SourceOp = "KenBurns", Source = "XIni", Name = "Desplazamiento X inicial", Default = -0.03, },
				Input4 = InstanceInput { SourceOp = "KenBurns", Source = "XFin", Name = "Desplazamiento X final", Default = 0.03, },
				Input5 = InstanceInput { SourceOp = "KenBurns", Source = "YIni", Name = "Desplazamiento Y inicial", Default = 0, },
				Input6 = InstanceInput { SourceOp = "KenBurns", Source = "YFin", Name = "Desplazamiento Y final", Default = 0, },
				Input7 = InstanceInput { SourceOp = "KenBurns", Source = "Suave", Name = "Suavizado (0 = lineal)", Default = 1, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "KenBurns", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				KenBurns = Transform {
					CtrlWShown = false,
					Inputs = {
						Size = Input { Value = 1.1, Expression = "KenBurns.ZoomIni + (KenBurns.ZoomFin - KenBurns.ZoomIni)*(KenBurns.Progreso + KenBurns.Suave*((KenBurns.Progreso)*(KenBurns.Progreso)*(3-2*(KenBurns.Progreso)) - KenBurns.Progreso))", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5 + KenBurns.XIni + (KenBurns.XFin - KenBurns.XIni)*(KenBurns.Progreso + KenBurns.Suave*((KenBurns.Progreso)*(KenBurns.Progreso)*(3-2*(KenBurns.Progreso)) - KenBurns.Progreso)), 0.5 + KenBurns.YIni + (KenBurns.YFin - KenBurns.YIni)*(KenBurns.Progreso + KenBurns.Suave*((KenBurns.Progreso)*(KenBurns.Progreso)*(3-2*(KenBurns.Progreso)) - KenBurns.Progreso)))", },
						Progreso = Input { SourceOp = "PRODinKenBurnsAnim", Source = "Value", },
						ZoomIni = Input { Value = 1.1, },
						ZoomFin = Input { Value = 1.3, },
						XIni = Input { Value = -0.03, },
						XFin = Input { Value = 0.03, },
						YIni = Input { Value = 0, },
						YFin = Input { Value = 0, },
						Suave = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 } },
					UserControls = ordered() {
						Progreso = {
							LINKS_Name = "Progreso",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						ZoomIni = {
							LINKS_Name = "Zoom inicial",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1.1,
							INP_MinScale = 1,
							INP_MaxScale = 3,
							INP_MinAllowed = 1,
							INP_MaxAllowed = 3,
							ICS_ControlPage = "Controls",
						},
						ZoomFin = {
							LINKS_Name = "Zoom final",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1.3,
							INP_MinScale = 1,
							INP_MaxScale = 3,
							INP_MinAllowed = 1,
							INP_MaxAllowed = 3,
							ICS_ControlPage = "Controls",
						},
						XIni = {
							LINKS_Name = "Desplazamiento X inicial",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = -0.03,
							INP_MinScale = -0.5,
							INP_MaxScale = 0.5,
							INP_MinAllowed = -0.5,
							INP_MaxAllowed = 0.5,
							ICS_ControlPage = "Controls",
						},
						XFin = {
							LINKS_Name = "Desplazamiento X final",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.03,
							INP_MinScale = -0.5,
							INP_MaxScale = 0.5,
							INP_MinAllowed = -0.5,
							INP_MaxAllowed = 0.5,
							ICS_ControlPage = "Controls",
						},
						YIni = {
							LINKS_Name = "Desplazamiento Y inicial",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = -0.5,
							INP_MaxScale = 0.5,
							INP_MinAllowed = -0.5,
							INP_MaxAllowed = 0.5,
							ICS_ControlPage = "Controls",
						},
						YFin = {
							LINKS_Name = "Desplazamiento Y final",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = -0.5,
							INP_MaxScale = 0.5,
							INP_MinAllowed = -0.5,
							INP_MaxAllowed = 0.5,
							ICS_ControlPage = "Controls",
						},
						Suave = {
							LINKS_Name = "Suavizado (0 = lineal)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
					},
				},
			},
		},
		PRODinKenBurnsAnim = LUTLookup {
			Inputs = {
