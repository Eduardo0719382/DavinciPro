{
	Tools = ordered() {
		PRO_FX_Film_Proyector = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				MainInput1 = InstanceInput { SourceOp = "Entrada", Source = "Input", },
				Input1 = InstanceInput { SourceOp = "Proyector", Source = "Weave", Name = "Gate weave (vaivén)", Default = 1, },
				Input2 = InstanceInput { SourceOp = "Proyector", Source = "Respiracion", Name = "Respiración (parpadeo)", Default = 1, },
				Input3 = InstanceInput { SourceOp = "Proyector", Source = "Polvo", Name = "Polvo", Default = 0.6, },
				Input4 = InstanceInput { SourceOp = "Proyector", Source = "Rayas", Name = "Rayas", Default = 0.4, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Proyector", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Entrada = PipeRouter {
					CtrlWShown = false,
					ViewInfo = PipeRouterInfo { Pos = { -440, 0 } },
				},
				MecWeave = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Entrada", Source = "Output", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5 + Proyector.Weave*Proyector.EscalaFormato*0.0015*(sin(time*0.37) + 0.5*sin(time*1.13 + 2)), 0.5 + Proyector.Weave*Proyector.EscalaFormato*0.0025*(sin(time*0.29 + 1) + 0.5*sin(time*0.91)))", },
						Size = Input { Value = 1, Expression = "1 + Proyector.Weave*Proyector.EscalaFormato*0.006", },
					},
					ViewInfo = OperatorInfo { Pos = { -330, 0 } },
				},
				MecRespira = BrightnessContrast {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "MecWeave", Source = "Output", },
						Gain = Input { Value = 1, Expression = "1 + Proyector.Respiracion*Proyector.EscalaFormato*0.025*sin(time*7.3)*sin(time*3.1 + 1)", },
						Saturation = Input { Value = 1, Expression = "1 + Proyector.Respiracion*Proyector.EscalaFormato*0.03*sin(time*5.7 + 2)*sin(time*2.3)", },
					},
					ViewInfo = OperatorInfo { Pos = { -275, 0 } },
				},
				DanoMotas = FastNoise {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						Detail = Input { Value = 8, },
						Contrast = Input { Value = 2, },
						XScale = Input { Value = 25, },
						SeetheRate = Input { Value = 3, },
						Discontinuous = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { -165, 99 } },
				},
				DanoUmbral = BrightnessContrast {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "DanoMotas", Source = "Output", },
						Low = Input { Value = 0.93, },
						High = Input { Value = 1, },
						Saturation = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -110, 99 } },
				},
				DanoBlanco = Background {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 1, },
						TopLeftGreen = Input { Value = 1, },
						TopLeftBlue = Input { Value = 1, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { -110, 132 } },
				},
				DanoInvertir = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "DanoBlanco", Source = "Output", },
						Foreground = Input { SourceOp = "DanoUmbral", Source = "Output", },
						ApplyMode = Input { Value = FuID { "Difference" }, },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -55, 99 } },
				},
				DanoPolvo = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "MecRespira", Source = "Output", },
						Foreground = Input { SourceOp = "DanoInvertir", Source = "Output", },
						ApplyMode = Input { Value = FuID { "Multiply" }, },
						Blend = Input { Value = 0.6, Expression = "Proyector.Polvo", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 } },
				},
				DanoLinea = RectangleMask {
					CtrlWShown = false,
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" }, },
						OutputSize = Input { Value = FuID { "Custom" }, },
						MaskWidth = Input { Value = 1920, },
						MaskHeight = Input { Value = 1080, },
						PixelAspect = Input { Value = { 1, 1 }, },
						UseFrameFormatSettings = Input { Value = 1, },
						ClippingMode = Input { Value = FuID { "None" }, },
						Width = Input { Value = 0.0015, },
						Height = Input { Value = 3, },
						SoftEdge = Input { Value = 0.001, },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5 + 0.35*sin(time*0.13)*sin(time*0.071 + 1), 0.5)", },
					},
					ViewInfo = OperatorInfo { Pos = { 0, -99 } },
				},
				DanoRaya = Background {
					CtrlWShown = false,
					Inputs = {
						EffectMask = Input { SourceOp = "DanoLinea", Source = "Mask", },
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 0.95, },
						TopLeftGreen = Input { Value = 0.95, },
						TopLeftBlue = Input { Value = 0.9, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, -66 } },
				},
				DanoRayas = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "DanoPolvo", Source = "Output", },
						Foreground = Input { SourceOp = "DanoRaya", Source = "Output", },
						Blend = Input { Value = 0, Expression = "Proyector.Rayas*max(0, sin(time*0.05))*max(0, sin(time*0.05))", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 55, 0 } },
				},
				Proyector = BrightnessContrast {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "DanoRayas", Source = "Output", },
						Weave = Input { Value = 1, },
						Respiracion = Input { Value = 1, },
						Polvo = Input { Value = 0.6, },
						Rayas = Input { Value = 0.4, },
						EscalaFormato = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 } },
					UserControls = ordered() {
						Weave = {
							LINKS_Name = "Gate weave (vaivén)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 5,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 5,
							ICS_ControlPage = "Controls",
						},
						Respiracion = {
							LINKS_Name = "Respiración (parpadeo)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 5,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 5,
							ICS_ControlPage = "Controls",
						},
						Polvo = {
							LINKS_Name = "Polvo",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.6,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Rayas = {
							LINKS_Name = "Rayas",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.4,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						EscalaFormato = {
							LINKS_Name = "Escala interna",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 10,
							ICS_ControlPage = "Controls",
						},
					},
				},
			},
		},
	},
	ActiveTool = "PRO_FX_Film_Proyector"
}
