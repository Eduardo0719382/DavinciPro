{
	Tools = ordered() {
		PRO_FX_Din_Clones = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				MainInput1 = InstanceInput { SourceOp = "Clones", Source = "Input", },
				Input1 = InstanceInput { SourceOp = "Clones", Source = "Cantidad", Name = "Clones por lado", Default = 2, },
				Input2 = InstanceInput { SourceOp = "Clones", Source = "AlRitmo", Name = "Cambiar en cada golpe (usa BPM)", Default = 0, },
				Input3 = InstanceInput { SourceOp = "Clones", Source = "Maximo", Name = "Máximo al ritmo", Default = 3, },
				Input4 = InstanceInput { SourceOp = "Clones", Source = "Espejo", Name = "Espejo", Default = 0, },
				Input5 = InstanceInput { SourceOp = "Clones", Source = "BPM", Name = "BPM de la música", Default = 120, },
				Input6 = InstanceInput { SourceOp = "Clones", Source = "FPS", Name = "Fotogramas por segundo", Default = 30, },
				Input7 = InstanceInput { SourceOp = "Clones", Source = "Desfase", Name = "Desfase (fotogramas hasta el primer golpe)", Default = 0, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Clones", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Clones = Transform {
					CtrlWShown = false,
					Inputs = {
						Size = Input { Value = 0.5, Expression = "1/iif(Clones.AlRitmo > 0.5, 1 + (floor((max(0, time - Clones.Desfase)/(Clones.FPS*60/Clones.BPM))) - Clones.Maximo*floor(floor((max(0, time - Clones.Desfase)/(Clones.FPS*60/Clones.BPM)))/Clones.Maximo)), Clones.Cantidad)", },
						Edges = Input { Value = 1, Expression = "iif(Clones.Espejo > 0.5, 3, 1)", },
						Cantidad = Input { Value = 2, },
						AlRitmo = Input { Value = 0, },
						Maximo = Input { Value = 3, },
						Espejo = Input { Value = 0, },
						BPM = Input { Value = 120, },
						FPS = Input { Value = 30, },
						Desfase = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 } },
					UserControls = ordered() {
						Cantidad = {
							LINKS_Name = "Clones por lado",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
							INP_Default = 2,
							INP_MinScale = 1,
							INP_MaxScale = 6,
							INP_MinAllowed = 1,
							INP_MaxAllowed = 6,
							ICS_ControlPage = "Controls",
						},
						AlRitmo = {
							LINKS_Name = "Cambiar en cada golpe (usa BPM)",
							LINKID_DataType = "Number",
							INPID_InputControl = "CheckboxControl",
							INP_Integer = true,
							CBC_TriState = false,
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Maximo = {
							LINKS_Name = "Máximo al ritmo",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
							INP_Default = 3,
							INP_MinScale = 2,
							INP_MaxScale = 6,
							INP_MinAllowed = 2,
							INP_MaxAllowed = 6,
							ICS_ControlPage = "Controls",
						},
						Espejo = {
							LINKS_Name = "Espejo",
							LINKID_DataType = "Number",
							INPID_InputControl = "CheckboxControl",
							INP_Integer = true,
							CBC_TriState = false,
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						BPM = {
							LINKS_Name = "BPM de la música",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 120,
							INP_MinScale = 40,
							INP_MaxScale = 220,
							INP_MinAllowed = 40,
							INP_MaxAllowed = 220,
							ICS_ControlPage = "Controls",
						},
						FPS = {
							LINKS_Name = "Fotogramas por segundo",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 30,
							INP_MinScale = 1,
							INP_MaxScale = 120,
							INP_MinAllowed = 1,
							INP_MaxAllowed = 120,
							ICS_ControlPage = "Controls",
						},
						Desfase = {
							LINKS_Name = "Desfase (fotogramas hasta el primer golpe)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 120,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 120,
							ICS_ControlPage = "Controls",
						},
					},
				},
			},
		},
	},
	ActiveTool = "PRO_FX_Din_Clones"
}
