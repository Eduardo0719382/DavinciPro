{
	Tools = ordered() {
		PRO_FX_Anim_Flow = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				MainInput1 = InstanceInput { SourceOp = "Mover", Source = "Input", },
				Input1 = InstanceInput { SourceOp = "Anim", Source = "Salida", Name = "Modo salida (desmarcado = entrada)", Default = 0, },
				Input2 = InstanceInput { SourceOp = "Anim", Source = "Duracion", Name = "Duración (% del clip)", Default = 0.25, },
				Input3 = InstanceInput { SourceOp = "Anim", Source = "Direccion", Name = "Dirección (grados, 180 = desde la izquierda)", Default = 180, },
				Input4 = InstanceInput { SourceOp = "Anim", Source = "Distancia", Name = "Distancia", Default = 0.6, },
				Input5 = InstanceInput { SourceOp = "Anim", Source = "Zoom", Name = "Zoom (-1 = pop desde 0)", Default = 0, },
				Input6 = InstanceInput { SourceOp = "Anim", Source = "Giro", Name = "Giro (grados)", Default = 0, },
				Input7 = InstanceInput { SourceOp = "Anim", Source = "Rebote", Name = "Rebote", Default = 1, },
				Input8 = InstanceInput { SourceOp = "Anim", Source = "Desenfoque", Name = "Desenfoque de movimiento", Default = 15, },
				Input9 = InstanceInput { SourceOp = "Anim", Source = "Fundido", Name = "Fundido", Default = 0, },
				Input10 = InstanceInput { SourceOp = "Anim", Source = "Aspecto", Name = "Aspecto del timeline (9:16 = 0.5625)", Default = 0.5625, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Anim", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Mover = Transform {
					CtrlWShown = false,
					Inputs = {
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5 + Anim.Distancia*sin(Anim.Direccion*3.14159265/180 + 1.5707963)/Anim.Aspecto*(1 - Anim.E), 0.5 + Anim.Distancia*sin(Anim.Direccion*3.14159265/180)*(1 - Anim.E))", },
						Size = Input { Value = 1, Expression = "max(0, 1 + Anim.Zoom*(1 - Anim.E))", },
						Angle = Input { Value = 0, Expression = "Anim.Giro*(1 - Anim.E)", },
					},
					ViewInfo = OperatorInfo { Pos = { -220, 0 } },
				},
				Estela = Blur {
					CtrlWShown = false,
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" }, },
						Input = Input { SourceOp = "Mover", Source = "Output", },
						XBlurSize = Input { Value = 0, Expression = "Anim.Desenfoque*max(0, (1 - Anim.E))", },
					},
					ViewInfo = OperatorInfo { Pos = { -110, 0 } },
				},
				Vacio = Background {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 0, },
						TopLeftGreen = Input { Value = 0, },
						TopLeftBlue = Input { Value = 0, },
						TopLeftAlpha = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -110, -66 } },
				},
				Anim = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "Vacio", Source = "Output", },
						Foreground = Input { SourceOp = "Estela", Source = "Output", },
						Blend = Input { Value = 1, Expression = "1 - Anim.Fundido*(1 - min(1, 2*Anim.T))", },
						PerformDepthMerge = Input { Value = 0, },
						Progreso = Input { SourceOp = "PROAnimFlowAnim", Source = "Value", },
						Salida = Input { Value = 0, },
						Duracion = Input { Value = 0.25, },
						Direccion = Input { Value = 180, },
						Distancia = Input { Value = 0.6, },
						Zoom = Input { Value = 0, },
						Giro = Input { Value = 0, },
						Rebote = Input { Value = 1, },
						Fundido = Input { Value = 0, },
						Desenfoque = Input { Value = 15, },
						Aspecto = Input { Value = 0.5625, },
						T = Input { Value = 0, Expression = "(1 - Anim.Salida)*max(0, min(1, Anim.Progreso/Anim.Duracion)) + Anim.Salida*max(0, min(1, (1 - Anim.Progreso)/Anim.Duracion))", },
						E = Input { Value = 1, Expression = "(1 + ((1.70158*Anim.Rebote) + 1)*(Anim.T - 1)*(Anim.T - 1)*(Anim.T - 1) + (1.70158*Anim.Rebote)*(Anim.T - 1)*(Anim.T - 1))", },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 } },
					UserControls = ordered() {
						Progreso = {
							LINKS_Name = "Progreso",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Salida = {
							LINKS_Name = "Modo salida (desmarcado = entrada)",
							LINKID_DataType = "Number",
							INPID_InputControl = "CheckboxControl",
							INP_Integer = true,
							CBC_TriState = false,
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Duracion = {
							LINKS_Name = "Duración (% del clip)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.25,
							INP_MinScale = 0.02,
							INP_MaxScale = 1,
							INP_MinAllowed = 0.02,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Direccion = {
							LINKS_Name = "Dirección (grados, 180 = desde la izquierda)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 180,
							INP_MinScale = -180,
							INP_MaxScale = 180,
							INP_MinAllowed = -180,
							INP_MaxAllowed = 180,
							ICS_ControlPage = "Controls",
						},
						Distancia = {
							LINKS_Name = "Distancia",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.6,
							INP_MinScale = 0,
							INP_MaxScale = 2,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 2,
							ICS_ControlPage = "Controls",
						},
						Zoom = {
							LINKS_Name = "Zoom (-1 = pop desde 0)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = -1,
							INP_MaxScale = 2,
							INP_MinAllowed = -1,
							INP_MaxAllowed = 2,
							ICS_ControlPage = "Controls",
						},
						Giro = {
							LINKS_Name = "Giro (grados)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = -180,
							INP_MaxScale = 180,
							INP_MinAllowed = -180,
							INP_MaxAllowed = 180,
							ICS_ControlPage = "Controls",
						},
						Rebote = {
							LINKS_Name = "Rebote",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 3,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 3,
							ICS_ControlPage = "Controls",
						},
						Fundido = {
							LINKS_Name = "Fundido",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Desenfoque = {
							LINKS_Name = "Desenfoque de movimiento",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 15,
							INP_MinScale = 0,
							INP_MaxScale = 100,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 100,
							ICS_ControlPage = "Controls",
						},
						Aspecto = {
							LINKS_Name = "Aspecto del timeline (9:16 = 0.5625)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.5625,
							INP_MinScale = 0.4,
							INP_MaxScale = 3,
							INP_MinAllowed = 0.4,
							INP_MaxAllowed = 3,
							ICS_ControlPage = "Controls",
						},
						T = {
							LINKS_Name = "t interno",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
						E = {
							LINKS_Name = "Curva interna",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = -1,
							INP_MaxScale = 2,
							ICS_ControlPage = "Controls",
						},
					},
				},
			},
		},
		PROAnimFlowAnim = LUTLookup {
			Inputs = {
			},
			CtrlWZoom = false,
		},
	},
	ActiveTool = "PRO_FX_Anim_Flow"
}
