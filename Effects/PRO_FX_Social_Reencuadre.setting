{
	Tools = ordered() {
		PRO_FX_Social_Reencuadre = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				MainInput1 = InstanceInput { SourceOp = "Entrada", Source = "Input", },
				Input1 = InstanceInput { SourceOp = "Reencuadre", Source = "AspClip", Name = "Aspecto del clip (16:9 = 1.778, 9:16 = 0.5625)", Default = 1.7778, },
				Input2 = InstanceInput { SourceOp = "Reencuadre", Source = "AspTL", Name = "Aspecto del timeline (16:9 = 1.778, 9:16 = 0.5625)", Default = 0.5625, },
				Input3 = InstanceInput { SourceOp = "Difuminar", Source = "XBlurSize", Name = "Desenfoque del fondo", Default = 40, },
				Input4 = InstanceInput { SourceOp = "Fondo", Source = "Gain", Name = "Brillo del fondo", Default = 0.7, },
				Input5 = InstanceInput { SourceOp = "Reencuadre", Source = "ZoomFondo", Name = "Zoom extra del fondo", Default = 1.05, },
				Input6 = InstanceInput { SourceOp = "Reencuadre", Source = "EscalaFrente", Name = "Escala del clip", Default = 1, },
				Input7 = InstanceInput { SourceOp = "Reencuadre", Source = "MoverY", Name = "Posición vertical del clip", Default = 0, },
				Input8 = InstanceInput { SourceOp = "Reencuadre", Source = "Redondeo", Name = "Redondeo de esquinas", Default = 0, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Reencuadre", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Entrada = PipeRouter {
					CtrlWShown = false,
					ViewInfo = PipeRouterInfo { Pos = { -330, 0 } },
				},
				Ampliar = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Entrada", Source = "Output", },
						Size = Input { Value = 3.2, Expression = "max(Reencuadre.AspClip/Reencuadre.AspTL, Reencuadre.AspTL/Reencuadre.AspClip)*Reencuadre.ZoomFondo", },
					},
					ViewInfo = OperatorInfo { Pos = { -275, -66 } },
				},
				Difuminar = Blur {
					CtrlWShown = false,
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" }, },
						XBlurSize = Input { Value = 40, },
						Input = Input { SourceOp = "Ampliar", Source = "Output", },
					},
					ViewInfo = OperatorInfo { Pos = { -220, -66 } },
				},
				Fondo = BrightnessContrast {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Difuminar", Source = "Output", },
						Gain = Input { Value = 0.7, },
						Saturation = Input { Value = 1.1, },
					},
					ViewInfo = OperatorInfo { Pos = { -165, -66 } },
				},
				Frente = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Entrada", Source = "Output", },
						Size = Input { Value = 1, Expression = "Reencuadre.EscalaFrente", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5, 0.5 + Reencuadre.MoverY)", },
					},
					ViewInfo = OperatorInfo { Pos = { -220, 33 } },
				},
				MascFrente = RectangleMask {
					CtrlWShown = false,
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" }, },
						OutputSize = Input { Value = FuID { "Custom" }, },
						MaskWidth = Input { Value = 1920, },
						MaskHeight = Input { Value = 1080, },
						PixelAspect = Input { Value = { 1, 1 }, },
						UseFrameFormatSettings = Input { Value = 1, },
						ClippingMode = Input { Value = FuID { "None" }, },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5, 0.5 + Reencuadre.MoverY)", },
						Width = Input { Value = 1, Expression = "iif(Reencuadre.AspClip > Reencuadre.AspTL, 1, Reencuadre.AspClip/Reencuadre.AspTL)*Reencuadre.EscalaFrente", },
						Height = Input { Value = 0.5625, Expression = "iif(Reencuadre.AspClip > Reencuadre.AspTL, 1/Reencuadre.AspClip, 1/Reencuadre.AspTL)*Reencuadre.EscalaFrente", },
						CornerRadius = Input { Value = 0, Expression = "Reencuadre.Redondeo", },
					},
					ViewInfo = OperatorInfo { Pos = { -165, 66 } },
				},
				Reencuadre = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "Fondo", Source = "Output", },
						Foreground = Input { SourceOp = "Frente", Source = "Output", },
						Blend = Input { Value = 1, },
						PerformDepthMerge = Input { Value = 0, },
						EffectMask = Input { SourceOp = "MascFrente", Source = "Mask", },
						AspClip = Input { Value = 1.7778, },
						AspTL = Input { Value = 0.5625, },
						ZoomFondo = Input { Value = 1.05, },
						EscalaFrente = Input { Value = 1, },
						MoverY = Input { Value = 0, },
						Redondeo = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -110, 0 } },
					UserControls = ordered() {
						AspClip = {
							LINKS_Name = "Aspecto del clip (16:9 = 1.778, 9:16 = 0.5625)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1.7778,
							INP_MinScale = 0.4,
							INP_MaxScale = 3,
							INP_MinAllowed = 0.4,
							INP_MaxAllowed = 3,
							ICS_ControlPage = "Controls",
						},
						AspTL = {
							LINKS_Name = "Aspecto del timeline (16:9 = 1.778, 9:16 = 0.5625)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.5625,
							INP_MinScale = 0.4,
							INP_MaxScale = 3,
							INP_MinAllowed = 0.4,
							INP_MaxAllowed = 3,
							ICS_ControlPage = "Controls",
						},
						ZoomFondo = {
							LINKS_Name = "Zoom extra del fondo",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1.05,
							INP_MinScale = 1,
							INP_MaxScale = 3,
							INP_MinAllowed = 1,
							INP_MaxAllowed = 3,
							ICS_ControlPage = "Controls",
						},
						EscalaFrente = {
							LINKS_Name = "Escala del clip",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0.3,
							INP_MaxScale = 3,
							INP_MinAllowed = 0.3,
							INP_MaxAllowed = 3,
							ICS_ControlPage = "Controls",
						},
						MoverY = {
							LINKS_Name = "Posición vertical del clip",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = -0.5,
							INP_MaxScale = 0.5,
							INP_MinAllowed = -0.5,
							INP_MaxAllowed = 0.5,
							ICS_ControlPage = "Controls",
						},
						Redondeo = {
							LINKS_Name = "Redondeo de esquinas",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 0.5,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 0.5,
							ICS_ControlPage = "Controls",
						},
					},
				},
			},
		},
	},
	ActiveTool = "PRO_FX_Social_Reencuadre"
}
