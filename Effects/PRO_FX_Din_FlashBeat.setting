{
	Tools = ordered() {
		PRO_FX_Din_FlashBeat = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				MainInput1 = InstanceInput { SourceOp = "Exposicion", Source = "Input", },
				Input1 = InstanceInput { SourceOp = "Destello", Source = "Intensidad", Name = "Intensidad del flash", Default = 0.8, },
				Input2 = InstanceInput { SourceOp = "Destello", Source = "Duracion", Name = "Duración (% del clip)", Default = 0.12, },
				Input3 = InstanceInput { SourceOp = "ColorFlash", Source = "TopLeftRed", Name = "Color del flash", ControlGroup = 3, Default = 1, },
				Input4 = InstanceInput { SourceOp = "ColorFlash", Source = "TopLeftGreen", ControlGroup = 3, Default = 1, },
				Input5 = InstanceInput { SourceOp = "ColorFlash", Source = "TopLeftBlue", ControlGroup = 3, Default = 1, },
				Input6 = InstanceInput { SourceOp = "Destello", Source = "Exposicion", Name = "Golpe de exposición", Default = 0.3, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Destello", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Exposicion = BrightnessContrast {
					CtrlWShown = false,
					Inputs = {
						Gain = Input { Value = 1, Expression = "1 + Destello.Exposicion*Destello.Caida", },
					},
					ViewInfo = OperatorInfo { Pos = { -110, 0 } },
				},
				ColorFlash = Background {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 1, },
						TopLeftGreen = Input { Value = 1, },
						TopLeftBlue = Input { Value = 1, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { -110, -66 } },
				},
				Destello = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "Exposicion", Source = "Output", },
						Foreground = Input { SourceOp = "ColorFlash", Source = "Output", },
						Blend = Input { Value = 0, Expression = "Destello.Intensidad*Destello.Caida", },
						PerformDepthMerge = Input { Value = 0, },
						Progreso = Input { SourceOp = "PRODinFlashBeatAnim", Source = "Value", },
						Intensidad = Input { Value = 0.8, },
						Duracion = Input { Value = 0.12, },
						Exposicion = Input { Value = 0.3, },
						Caida = Input { Value = 0, Expression = "(1 - max(0, min(1, Destello.Progreso/max(Destello.Duracion, 0.0001))))*(1 - max(0, min(1, Destello.Progreso/max(Destello.Duracion, 0.0001))))", },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 } },
					UserControls = ordered() {
						Progreso = {
							LINKS_Name = "Progreso",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Intensidad = {
							LINKS_Name = "Intensidad del flash",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.8,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Duracion = {
							LINKS_Name = "Duración (% del clip)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.12,
							INP_MinScale = 0.01,
							INP_MaxScale = 1,
							INP_MinAllowed = 0.01,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Exposicion = {
							LINKS_Name = "Golpe de exposición",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.3,
							INP_MinScale = 0,
							INP_MaxScale = 2,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 2,
							ICS_ControlPage = "Controls",
						},
						Caida = {
							LINKS_Name = "Caída interna",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
					},
				},
			},
		},
		PRODinFlashBeatAnim = LUTLookup {
			Inputs = {
			},
			CtrlWZoom = false,
		},
	},
	ActiveTool = "PRO_FX_Din_FlashBeat"
}
