{
	Tools = ordered() {
		PRO_TR_Iris = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				MainInput1 = InstanceInput { SourceOp = "EntradaA", Source = "Input", },
				MainInput2 = InstanceInput { SourceOp = "EntradaB", Source = "Input", },
				Input1 = InstanceInput { SourceOp = "Iris", Source = "CX", Name = "Origen X", Default = 0.5, },
				Input2 = InstanceInput { SourceOp = "Iris", Source = "CY", Name = "Origen Y", Default = 0.5, },
				Input3 = InstanceInput { SourceOp = "Iris", Source = "Borde", Name = "Grosor del aro", Default = 0.03, },
				Input4 = InstanceInput { SourceOp = "Aro", Source = "TopLeftRed", Name = "Color del aro", ControlGroup = 4, Default = 1, },
				Input5 = InstanceInput { SourceOp = "Aro", Source = "TopLeftGreen", ControlGroup = 4, Default = 1, },
				Input6 = InstanceInput { SourceOp = "Aro", Source = "TopLeftBlue", ControlGroup = 4, Default = 1, },
				Input7 = InstanceInput { SourceOp = "Iris", Source = "Suavidad", Name = "Suavidad del borde", Default = 0.003, },
				Input8 = InstanceInput { SourceOp = "Iris", Source = "Tamano", Name = "Tamaño final (súbelo si quedan esquinas)", Default = 4.2, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Iris", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				EntradaA = PipeRouter {
					CtrlWShown = false,
					ViewInfo = PipeRouterInfo { Pos = { -330, 0 } },
				},
				EntradaB = PipeRouter {
					CtrlWShown = false,
					ViewInfo = PipeRouterInfo { Pos = { -330, 66 } },
				},
				MascAro = EllipseMask {
					CtrlWShown = false,
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" }, },
						OutputSize = Input { Value = FuID { "Custom" }, },
						MaskWidth = Input { Value = 1920, },
						MaskHeight = Input { Value = 1080, },
						PixelAspect = Input { Value = { 1, 1 }, },
						UseFrameFormatSettings = Input { Value = 1, },
						ClippingMode = Input { Value = FuID { "None" }, },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(Iris.CX, Iris.CY)", },
						SoftEdge = Input { Value = 0.003, },
						Width = Input { Value = 0, Expression = "Iris.Tamano*(Iris.Progreso)*(Iris.Progreso)*(3-2*(Iris.Progreso))*(Iris.Progreso)*(Iris.Progreso)*(3-2*(Iris.Progreso)) + Iris.Borde*sin(Iris.Progreso*3.14159265)", },
						Height = Input { Value = 0, Expression = "Iris.Tamano*(Iris.Progreso)*(Iris.Progreso)*(3-2*(Iris.Progreso))*(Iris.Progreso)*(Iris.Progreso)*(3-2*(Iris.Progreso)) + Iris.Borde*sin(Iris.Progreso*3.14159265)", },
					},
					ViewInfo = OperatorInfo { Pos = { -275, -99 } },
				},
				Aro = Background {
					CtrlWShown = false,
					Inputs = {
						EffectMask = Input { SourceOp = "MascAro", Source = "Mask", },
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 1, },
						TopLeftGreen = Input { Value = 1, },
						TopLeftBlue = Input { Value = 1, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { -275, -66 } },
				},
				MascIris = EllipseMask {
					CtrlWShown = false,
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" }, },
						OutputSize = Input { Value = FuID { "Custom" }, },
						MaskWidth = Input { Value = 1920, },
						MaskHeight = Input { Value = 1080, },
						PixelAspect = Input { Value = { 1, 1 }, },
						UseFrameFormatSettings = Input { Value = 1, },
						ClippingMode = Input { Value = FuID { "None" }, },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(Iris.CX, Iris.CY)", },
						SoftEdge = Input { Value = 0.003, Expression = "Iris.Suavidad", },
						Width = Input { Value = 0, Expression = "Iris.Tamano*(Iris.Progreso)*(Iris.Progreso)*(3-2*(Iris.Progreso))*(Iris.Progreso)*(Iris.Progreso)*(3-2*(Iris.Progreso))", },
						Height = Input { Value = 0, Expression = "Iris.Tamano*(Iris.Progreso)*(Iris.Progreso)*(3-2*(Iris.Progreso))*(Iris.Progreso)*(Iris.Progreso)*(3-2*(Iris.Progreso))", },
					},
					ViewInfo = OperatorInfo { Pos = { -220, -99 } },
				},
				ConAro = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "EntradaA", Source = "Output", },
						Foreground = Input { SourceOp = "Aro", Source = "Output", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -220, 0 } },
				},
				ConIris = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "ConAro", Source = "Output", },
						Foreground = Input { SourceOp = "EntradaB", Source = "Output", },
						PerformDepthMerge = Input { Value = 0, },
						EffectMask = Input { SourceOp = "MascIris", Source = "Mask", },
					},
					ViewInfo = OperatorInfo { Pos = { -165, 0 } },
				},
				Iris = BrightnessContrast {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "ConIris", Source = "Output", },
						Progreso = Input { SourceOp = "PROIrisAnim", Source = "Value", },
						CX = Input { Value = 0.5, },
						CY = Input { Value = 0.5, },
						Borde = Input { Value = 0.03, },
						Suavidad = Input { Value = 0.003, },
						Tamano = Input { Value = 4.2, },
					},
					ViewInfo = OperatorInfo { Pos = { -110, 0 } },
					UserControls = ordered() {
						Progreso = {
							LINKS_Name = "Progreso",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						CX = {
							LINKS_Name = "Origen X",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.5,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						CY = {
							LINKS_Name = "Origen Y",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.5,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Borde = {
							LINKS_Name = "Grosor del aro",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.03,
							INP_MinScale = 0,
							INP_MaxScale = 0.2,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 0.2,
							ICS_ControlPage = "Controls",
						},
						Suavidad = {
							LINKS_Name = "Suavidad del borde",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.003,
							INP_MinScale = 0,
							INP_MaxScale = 0.2,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 0.2,
							ICS_ControlPage = "Controls",
						},
						Tamano = {
							LINKS_Name = "Tamaño final (súbelo si quedan esquinas)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 4.2,
							INP_MinScale = 1,
							INP_MaxScale = 8,
							INP_MinAllowed = 1,
							INP_MaxAllowed = 8,
							ICS_ControlPage = "Controls",
						},
					},
				},
			},
		},
		PROIrisAnim = LUTLookup {
			Inputs = {
			},
