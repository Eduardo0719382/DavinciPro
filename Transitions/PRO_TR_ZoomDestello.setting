{
	Tools = ordered() {
		PRO_TR_ZoomDestello = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				MainInput1 = InstanceInput { SourceOp = "ZoomSaliente", Source = "Input", },
				MainInput2 = InstanceInput { SourceOp = "ZoomEntrante", Source = "Input", },
				Input1 = InstanceInput { SourceOp = "Mezcla", Source = "Zoom", Name = "Zoom", Default = 0.6, },
				Input2 = InstanceInput { SourceOp = "Mezcla", Source = "Desenfoque", Name = "Desenfoque", Default = 25, },
				Input3 = InstanceInput { SourceOp = "Mezcla", Source = "Destello", Name = "Destello", Default = 1, },
				Input4 = InstanceInput { SourceOp = "Flash", Source = "TopLeftRed", Name = "Color del destello", ControlGroup = 4, Default = 1, },
				Input5 = InstanceInput { SourceOp = "Flash", Source = "TopLeftGreen", ControlGroup = 4, Default = 1, },
				Input6 = InstanceInput { SourceOp = "Flash", Source = "TopLeftBlue", ControlGroup = 4, Default = 1, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Mezcla", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				ZoomSaliente = Transform {
					CtrlWShown = false,
					Inputs = {
						Size = Input { Value = 1, Expression = "1 + Mezcla.Zoom*pow(min(1, 2*Mezcla.Progreso), 3)", },
					},
					ViewInfo = OperatorInfo { Pos = { -275, -33 } },
				},
				ZoomEntrante = Transform {
					CtrlWShown = false,
					Inputs = {
						Size = Input { Value = 1, Expression = "1 + Mezcla.Zoom*pow((1 - max(0, 2*Mezcla.Progreso - 1)), 3)", },
					},
					ViewInfo = OperatorInfo { Pos = { -275, 33 } },
				},
				Corte = Dissolve {
					CtrlWShown = false,
					Inputs = {
						Mix = Input { Value = 0, Expression = "iif(Mezcla.Progreso < 0.5, 0, 1)", },
						Background = Input { SourceOp = "ZoomSaliente", Source = "Output", },
						Foreground = Input { SourceOp = "ZoomEntrante", Source = "Output", },
					},
					ViewInfo = OperatorInfo { Pos = { -220, 0 } },
				},
				Movimiento = Blur {
					CtrlWShown = false,
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" }, },
						XBlurSize = Input { Value = 0, Expression = "Mezcla.Desenfoque*sin(Mezcla.Progreso*3.14159265)*sin(Mezcla.Progreso*3.14159265)", },
						Input = Input { SourceOp = "Corte", Source = "Output", },
					},
					ViewInfo = OperatorInfo { Pos = { -165, 0 } },
				},
				Flash = Background {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 1, },
						TopLeftGreen = Input { Value = 1, },
						TopLeftBlue = Input { Value = 1, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { -110, -66 } },
				},
				Mezcla = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "Movimiento", Source = "Output", },
						Foreground = Input { SourceOp = "Flash", Source = "Output", },
						ApplyMode = Input { Value = FuID { "Screen" }, },
						Blend = Input { Value = 0, Expression = "Mezcla.Destello*pow(sin(Mezcla.Progreso*3.14159265), 6)", },
						PerformDepthMerge = Input { Value = 0, },
						Progreso = Input { SourceOp = "PROZoomDestelloAnim", Source = "Value", },
						Zoom = Input { Value = 0.6, },
						Desenfoque = Input { Value = 25, },
						Destello = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { -110, 0 } },
					UserControls = ordered() {
						Progreso = {
							LINKS_Name = "Progreso",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Zoom = {
							LINKS_Name = "Zoom",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.6,
							INP_MinScale = 0,
							INP_MaxScale = 3,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 3,
							ICS_ControlPage = "Controls",
						},
						Desenfoque = {
							LINKS_Name = "Desenfoque",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 25,
							INP_MinScale = 0,
							INP_MaxScale = 100,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 100,
							ICS_ControlPage = "Controls",
						},
						Destello = {
							LINKS_Name = "Destello",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
					},
				},
			},
		},
		PROZoomDestelloAnim = LUTLookup {
			Inputs = {
			},
			CtrlWZoom = false,
		},
	},
	ActiveTool = "PRO_TR_ZoomDestello"
}
