							INPID_InputControl = "SliderControl",
							INP_Default = 0.4,
							INP_MinScale = 0,
							INP_MaxScale = 0.9,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 0.9,
							ICS_ControlPage = "Controls",
						},
						Etiquetas = {
							LINKS_Name = "Etiquetas",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
