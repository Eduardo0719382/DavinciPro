{
	Tools = ordered() {
		PRO_TR_AntesDespues = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				MainInput1 = InstanceInput { SourceOp = "EntradaA", Source = "Input", },
				MainInput2 = InstanceInput { SourceOp = "EntradaB", Source = "Input", },
				Input1 = InstanceInput { SourceOp = "Comparar", Source = "Pausa", Name = "Pausa a la mitad (% de la transición)", Default = 0.4, },
				Input2 = InstanceInput { SourceOp = "Comparar", Source = "Etiquetas", Name = "Etiquetas", Default = 1, },
				Input3 = InstanceInput { SourceOp = "Antes", Source = "StyledText", Name = "Etiqueta de antes", },
				Input4 = InstanceInput { SourceOp = "Despues", Source = "StyledText", Name = "Etiqueta de después", },
				Input5 = InstanceInput { SourceOp = "Linea", Source = "TopLeftRed", Name = "Color de la línea", ControlGroup = 5, Default = 1, },
				Input6 = InstanceInput { SourceOp = "Linea", Source = "TopLeftGreen", ControlGroup = 5, Default = 1, },
				Input7 = InstanceInput { SourceOp = "Linea", Source = "TopLeftBlue", ControlGroup = 5, Default = 1, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Comparar", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				EntradaA = PipeRouter {
					CtrlWShown = false,
					ViewInfo = PipeRouterInfo { Pos = { -330, -66 } },
				},
				EntradaB = PipeRouter {
					CtrlWShown = false,
					ViewInfo = PipeRouterInfo { Pos = { -330, 66 } },
				},
				MascB = RectangleMask {
					CtrlWShown = false,
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" }, },
						OutputSize = Input { Value = FuID { "Custom" }, },
						MaskWidth = Input { Value = 1920, },
						MaskHeight = Input { Value = 1080, },
						PixelAspect = Input { Value = { 1, 1 }, },
						UseFrameFormatSettings = Input { Value = 1, },
						ClippingMode = Input { Value = FuID { "None" }, },
						Center = Input { Value = { 0, 0.5 }, Expression = "Point(Comparar.E/2, 0.5)", },
						Width = Input { Value = 0, Expression = "Comparar.E", },
						Height = Input { Value = 8, },
					},
					ViewInfo = OperatorInfo { Pos = { -275, -132 } },
				},
				ConB = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "EntradaA", Source = "Output", },
						Foreground = Input { SourceOp = "EntradaB", Source = "Output", },
						PerformDepthMerge = Input { Value = 0, },
						EffectMask = Input { SourceOp = "MascB", Source = "Mask", },
					},
					ViewInfo = OperatorInfo { Pos = { -275, 0 } },
				},
				MascLinea = RectangleMask {
					CtrlWShown = false,
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" }, },
						OutputSize = Input { Value = FuID { "Custom" }, },
						MaskWidth = Input { Value = 1920, },
						MaskHeight = Input { Value = 1080, },
						PixelAspect = Input { Value = { 1, 1 }, },
						UseFrameFormatSettings = Input { Value = 1, },
						ClippingMode = Input { Value = FuID { "None" }, },
						Center = Input { Value = { 0, 0.5 }, Expression = "Point(Comparar.E, 0.5)", },
						Width = Input { Value = 0.005, },
						Height = Input { Value = 8, },
					},
					ViewInfo = OperatorInfo { Pos = { -220, -132 } },
				},
				Linea = Background {
					CtrlWShown = false,
					Inputs = {
						EffectMask = Input { SourceOp = "MascLinea", Source = "Mask", },
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 1, },
						TopLeftGreen = Input { Value = 1, },
						TopLeftBlue = Input { Value = 1, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { -220, -99 } },
				},
				ConLinea = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "ConB", Source = "Output", },
						Foreground = Input { SourceOp = "Linea", Source = "Output", },
						Blend = Input { Value = 1, Expression = "iif(Comparar.E > 0.001, iif(Comparar.E < 0.999, 1, 0), 0)", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -220, 0 } },
				},
				Antes = TextPlus {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						Center = Input { Value = { 0.88, 0.9 }, },
						StyledText = Input { Value = "ANTES", },
						Font = Input { Value = "Montserrat", },
						Style = Input { Value = "ExtraBold", },
						Size = Input { Value = 0.03, },
						Red1 = Input { Value = 1, },
						Green1 = Input { Value = 1, },
						Blue1 = Input { Value = 1, },
						Enabled6 = Input { Value = 1, },
						ElementShape6 = Input { Value = 2, },
						Level6 = Input { Value = 1, },
						ExtendHorizontal6 = Input { Value = 0.02, },
						ExtendVertical6 = Input { Value = 0.015, },
						Round6 = Input { Value = 0.3, },
						Red6 = Input { Value = 0, },
						Green6 = Input { Value = 0, },
						Blue6 = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -165, -132 } },
				},
				Despues = TextPlus {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						Center = Input { Value = { 0.12, 0.9 }, },
						StyledText = Input { Value = "DESPUÉS", },
						Font = Input { Value = "Montserrat", },
						Style = Input { Value = "ExtraBold", },
						Size = Input { Value = 0.03, },
						Red1 = Input { Value = 1, },
						Green1 = Input { Value = 1, },
						Blue1 = Input { Value = 1, },
						Enabled6 = Input { Value = 1, },
						ElementShape6 = Input { Value = 2, },
						Level6 = Input { Value = 1, },
						ExtendHorizontal6 = Input { Value = 0.02, },
						ExtendVertical6 = Input { Value = 0.015, },
						Round6 = Input { Value = 0.3, },
						Red6 = Input { Value = 0, },
						Green6 = Input { Value = 0, },
						Blue6 = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -110, -132 } },
				},
				ConAntes = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "ConLinea", Source = "Output", },
						Foreground = Input { SourceOp = "Antes", Source = "Output", },
						Blend = Input { Value = 1, Expression = "Comparar.Etiquetas*max(0, min(1, (0.85 - Comparar.E)/0.1))", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -165, 0 } },
				},
				ConDespues = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "ConAntes", Source = "Output", },
						Foreground = Input { SourceOp = "Despues", Source = "Output", },
						Blend = Input { Value = 1, Expression = "Comparar.Etiquetas*max(0, min(1, (Comparar.E - 0.15)/0.1))", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -110, 0 } },
				},
				Comparar = BrightnessContrast {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "ConDespues", Source = "Output", },
						Progreso = Input { SourceOp = "PROAntesDespuesAnim", Source = "Value", },
						Pausa = Input { Value = 0.4, },
						Etiquetas = Input { Value = 1, },
						E = Input { Value = 0, Expression = "iif(Comparar.Progreso < ((1 - Comparar.Pausa)/2), 0.5*(max(0, min(1, Comparar.Progreso/((1 - Comparar.Pausa)/2))))*(max(0, min(1, Comparar.Progreso/((1 - Comparar.Pausa)/2))))*(3-2*(max(0, min(1, Comparar.Progreso/((1 - Comparar.Pausa)/2))))), iif(Comparar.Progreso < 1 - ((1 - Comparar.Pausa)/2), 0.5, 0.5 + 0.5*(max(0, min(1, (Comparar.Progreso - (1 - ((1 - Comparar.Pausa)/2)))/((1 - Comparar.Pausa)/2))))*(max(0, min(1, (Comparar.Progreso - (1 - ((1 - Comparar.Pausa)/2)))/((1 - Comparar.Pausa)/2))))*(3-2*(max(0, min(1, (Comparar.Progreso - (1 - ((1 - Comparar.Pausa)/2)))/((1 - Comparar.Pausa)/2)))))))", },
					},
					ViewInfo = OperatorInfo { Pos = { -55, 0 } },
					UserControls = ordered() {
						Progreso = {
							LINKS_Name = "Progreso",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Pausa = {
