{
	Tools = ordered() {
		PRO_TR_SaltoCinta = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				MainInput1 = InstanceInput { SourceOp = "Saliente", Source = "Input", },
				MainInput2 = InstanceInput { SourceOp = "Entrante", Source = "Input", },
				Input1 = InstanceInput { SourceOp = "Pelicula", Source = "Linea", Name = "Línea de fotograma", Default = 0.08, },
				Input2 = InstanceInput { SourceOp = "Pelicula", Source = "Desenfoque", Name = "Desenfoque de arrastre", Default = 60, },
				Input3 = InstanceInput { SourceOp = "Pelicula", Source = "Direccion", Name = "Dirección (1 arriba / -1 abajo)", Default = 1, },
				Input4 = InstanceInput { SourceOp = "Pelicula", Source = "Danos", Name = "Daños de película", Default = 1, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Pelicula", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Saliente = Transform {
					CtrlWShown = false,
					Inputs = {
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5, 0.5 + Pelicula.Direccion*(Pelicula.Progreso)*(Pelicula.Progreso)*(3-2*(Pelicula.Progreso))*(1 + Pelicula.Linea))", },
					},
					ViewInfo = OperatorInfo { Pos = { -330, -33 } },
				},
				Entrante = Transform {
					CtrlWShown = false,
					Inputs = {
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5, 0.5 - Pelicula.Direccion*(1 - (Pelicula.Progreso)*(Pelicula.Progreso)*(3-2*(Pelicula.Progreso)))*(1 + Pelicula.Linea))", },
					},
					ViewInfo = OperatorInfo { Pos = { -330, 33 } },
				},
				Negro = Background {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 0, },
						TopLeftGreen = Input { Value = 0, },
						TopLeftBlue = Input { Value = 0, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { -275, -99 } },
				},
				ConA = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "Negro", Source = "Output", },
						Foreground = Input { SourceOp = "Saliente", Source = "Output", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -220, 0 } },
				},
				ConB = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "ConA", Source = "Output", },
						Foreground = Input { SourceOp = "Entrante", Source = "Output", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -165, 0 } },
				},
				Arrastre = Blur {
					CtrlWShown = false,
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" }, },
						LockXY = Input { Value = 0, },
						XBlurSize = Input { Value = 0, },
						YBlurSize = Input { Value = 0, Expression = "Pelicula.Desenfoque*sin(Pelicula.Progreso*3.14159265)*sin(Pelicula.Progreso*3.14159265)", },
						Input = Input { SourceOp = "ConB", Source = "Output", },
					},
					ViewInfo = OperatorInfo { Pos = { -110, 0 } },
				},
				Parpadeo = BrightnessContrast {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Arrastre", Source = "Output", },
						Gain = Input { Value = 1, Expression = "1 + 0.5*Pelicula.Danos*sin(Pelicula.Progreso*3.14159265)*sin(time*9.1)*sin(time*3.7 + 1)", },
					},
					ViewInfo = OperatorInfo { Pos = { -55, 0 } },
				},
				DanoMotas = FastNoise {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						Detail = Input { Value = 8, },
						Contrast = Input { Value = 2, },
						XScale = Input { Value = 25, },
						SeetheRate = Input { Value = 3, },
						Discontinuous = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 99 } },
				},
				DanoUmbral = BrightnessContrast {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "DanoMotas", Source = "Output", },
						Low = Input { Value = 0.93, },
						High = Input { Value = 1, },
						Saturation = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 55, 99 } },
				},
				DanoBlanco = Background {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 1, },
						TopLeftGreen = Input { Value = 1, },
						TopLeftBlue = Input { Value = 1, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 55, 132 } },
				},
				DanoInvertir = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "DanoBlanco", Source = "Output", },
						Foreground = Input { SourceOp = "DanoUmbral", Source = "Output", },
						ApplyMode = Input { Value = FuID { "Difference" }, },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 99 } },
				},
				DanoPolvo = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "Parpadeo", Source = "Output", },
						Foreground = Input { SourceOp = "DanoInvertir", Source = "Output", },
						ApplyMode = Input { Value = FuID { "Multiply" }, },
						Blend = Input { Value = 0.6, Expression = "Pelicula.Polvo", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 165, 0 } },
				},
				DanoLinea = RectangleMask {
					CtrlWShown = false,
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" }, },
						OutputSize = Input { Value = FuID { "Custom" }, },
						MaskWidth = Input { Value = 1920, },
						MaskHeight = Input { Value = 1080, },
						PixelAspect = Input { Value = { 1, 1 }, },
						UseFrameFormatSettings = Input { Value = 1, },
						ClippingMode = Input { Value = FuID { "None" }, },
						Width = Input { Value = 0.0015, },
						Height = Input { Value = 3, },
						SoftEdge = Input { Value = 0.001, },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5 + 0.35*sin(time*0.13)*sin(time*0.071 + 1), 0.5)", },
					},
					ViewInfo = OperatorInfo { Pos = { 165, -99 } },
				},
				DanoRaya = Background {
					CtrlWShown = false,
					Inputs = {
						EffectMask = Input { SourceOp = "DanoLinea", Source = "Mask", },
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 0.95, },
						TopLeftGreen = Input { Value = 0.95, },
						TopLeftBlue = Input { Value = 0.9, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 165, -66 } },
				},
				DanoRayas = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "DanoPolvo", Source = "Output", },
						Foreground = Input { SourceOp = "DanoRaya", Source = "Output", },
						Blend = Input { Value = 0, Expression = "Pelicula.Rayas*max(0, sin(time*0.05))*max(0, sin(time*0.05))", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 220, 0 } },
				},
				Pelicula = BrightnessContrast {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "DanoRayas", Source = "Output", },
						Progreso = Input { SourceOp = "PROSaltoCintaAnim", Source = "Value", },
						Danos = Input { Value = 1, },
						Polvo = Input { Value = 0, Expression = "min(1, 0.8*Pelicula.Danos*sin(Pelicula.Progreso*3.14159265))", },
						Rayas = Input { Value = 0, Expression = "min(1, 0.7*Pelicula.Danos*sin(Pelicula.Progreso*3.14159265))", },
						Weave = Input { Value = 0, Expression = "3*Pelicula.Danos*sin(Pelicula.Progreso*3.14159265)", },
						Respiracion = Input { Value = 0, Expression = "4*Pelicula.Danos*sin(Pelicula.Progreso*3.14159265)", },
						EscalaFormato = Input { Value = 1, },
						Linea = Input { Value = 0.08, },
						Desenfoque = Input { Value = 60, },
						Direccion = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 330, 0 } },
					UserControls = ordered() {
						Progreso = {
							LINKS_Name = "Progreso",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Danos = {
							LINKS_Name = "Daños de película",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 3,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 3,
							ICS_ControlPage = "Controls",
						},
						Linea = {
							LINKS_Name = "Línea de fotograma",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.08,
							INP_MinScale = 0,
							INP_MaxScale = 0.3,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 0.3,
							ICS_ControlPage = "Controls",
						},
						Desenfoque = {
							LINKS_Name = "Desenfoque de arrastre",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 60,
							INP_MinScale = 0,
							INP_MaxScale = 200,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 200,
							ICS_ControlPage = "Controls",
						},
						Direccion = {
							LINKS_Name = "Dirección (1 arriba / -1 abajo)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
							INP_Default = 1,
							INP_MinScale = -1,
							INP_MaxScale = 1,
							INP_MinAllowed = -1,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
