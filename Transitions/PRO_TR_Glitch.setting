{
	Tools = ordered() {
		PRO_TR_Glitch = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				MainInput1 = InstanceInput { SourceOp = "Mezcla", Source = "Background", },
				MainInput2 = InstanceInput { SourceOp = "Mezcla", Source = "Foreground", },
				Input1 = InstanceInput { SourceOp = "Mezcla", Source = "Glitch", Name = "Intensidad del glitch", Default = 1, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Corte2", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Mezcla = Dissolve {
					CtrlWShown = false,
					Inputs = {
						Mix = Input { Value = 0, Expression = "max(0, min(1, 2*Mezcla.Progreso - 0.5 + 0.8*sin(time*5.1)*sin(time*2.3 + 1)*sin(Mezcla.Progreso*3.14159265)))", },
						Progreso = Input { SourceOp = "PROGlitchAnim", Source = "Value", },
						Glitch = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 } },
					UserControls = ordered() {
						Progreso = {
							LINKS_Name = "Progreso",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Glitch = {
							LINKS_Name = "Intensidad del glitch",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 3,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 3,
							ICS_ControlPage = "Controls",
						},
					},
				},
				SepR = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Mezcla", Source = "Output", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5 + Mezcla.Glitch*0.012*sin(Mezcla.Progreso*3.14159265)*sin(Mezcla.Progreso*3.14159265), 0.5 + 0)", },
					},
					ViewInfo = OperatorInfo { Pos = { 55, -66 } },
				},
				SepB = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Mezcla", Source = "Output", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5 - Mezcla.Glitch*0.012*sin(Mezcla.Progreso*3.14159265)*sin(Mezcla.Progreso*3.14159265), 0.5 - 0)", },
					},
					ViewInfo = OperatorInfo { Pos = { 55, 66 } },
				},
				SepSoloR = Background {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 1, },
						TopLeftGreen = Input { Value = 0, },
						TopLeftBlue = Input { Value = 0, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, -99 } },
				},
				SepSoloG = Background {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 0, },
						TopLeftGreen = Input { Value = 1, },
						TopLeftBlue = Input { Value = 0, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, -33 } },
				},
				SepSoloB = Background {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 0, },
						TopLeftGreen = Input { Value = 0, },
						TopLeftBlue = Input { Value = 1, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 99 } },
				},
				SepCanalR = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "SepR", Source = "Output", },
						Foreground = Input { SourceOp = "SepSoloR", Source = "Output", },
						ApplyMode = Input { Value = FuID { "Multiply" }, },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 165, -66 } },
				},
				SepCanalG = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "Mezcla", Source = "Output", },
						Foreground = Input { SourceOp = "SepSoloG", Source = "Output", },
						ApplyMode = Input { Value = FuID { "Multiply" }, },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 165, 0 } },
				},
				SepCanalB = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "SepB", Source = "Output", },
						Foreground = Input { SourceOp = "SepSoloB", Source = "Output", },
						ApplyMode = Input { Value = FuID { "Multiply" }, },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 165, 66 } },
				},
				SepRG = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "SepCanalR", Source = "Output", },
						Foreground = Input { SourceOp = "SepCanalG", Source = "Output", },
						ApplyMode = Input { Value = FuID { "Screen" }, },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 220, -33 } },
				},
				SepRGB = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "SepRG", Source = "Output", },
						Foreground = Input { SourceOp = "SepCanalB", Source = "Output", },
						ApplyMode = Input { Value = FuID { "Screen" }, },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 275, 0 } },
				},
				Corte1Masc = RectangleMask {
					CtrlWShown = false,
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" }, },
						OutputSize = Input { Value = FuID { "Custom" }, },
						MaskWidth = Input { Value = 1920, },
						MaskHeight = Input { Value = 1080, },
						PixelAspect = Input { Value = { 1, 1 }, },
						UseFrameFormatSettings = Input { Value = 1, },
						ClippingMode = Input { Value = FuID { "None" }, },
						Width = Input { Value = 3, },
						Height = Input { Value = 0.07, },
						Center = Input { Value = { 0.5, 0.3 }, Expression = "Point(0.5, 0.3 + 0.25*sin(time*3.3))", },
					},
					ViewInfo = OperatorInfo { Pos = { 330, -132 } },
				},
				Corte1Desp = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "SepRGB", Source = "Output", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5 + Mezcla.Glitch*0.06*sin(Mezcla.Progreso*3.14159265)*sin(Mezcla.Progreso*3.14159265)*sin(time*7.7 + 1), 0.5)", },
					},
					ViewInfo = OperatorInfo { Pos = { 330, -66 } },
				},
				Corte1 = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "SepRGB", Source = "Output", },
						Foreground = Input { SourceOp = "Corte1Desp", Source = "Output", },
						Blend = Input { Value = 1, },
						PerformDepthMerge = Input { Value = 0, },
						EffectMask = Input { SourceOp = "Corte1Masc", Source = "Mask", },
					},
					ViewInfo = OperatorInfo { Pos = { 440, 0 } },
				},
				Corte2Masc = RectangleMask {
					CtrlWShown = false,
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" }, },
						OutputSize = Input { Value = FuID { "Custom" }, },
						MaskWidth = Input { Value = 1920, },
						MaskHeight = Input { Value = 1080, },
						PixelAspect = Input { Value = { 1, 1 }, },
						UseFrameFormatSettings = Input { Value = 1, },
						ClippingMode = Input { Value = FuID { "None" }, },
						Width = Input { Value = 3, },
						Height = Input { Value = 0.07, },
						Center = Input { Value = { 0.5, 0.7 }, Expression = "Point(0.5, 0.7 + 0.25*sin(time*4.7))", },
					},
					ViewInfo = OperatorInfo { Pos = { 330, -165 } },
				},
				Corte2Desp = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Corte1", Source = "Output", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5 + Mezcla.Glitch*-0.08*sin(Mezcla.Progreso*3.14159265)*sin(Mezcla.Progreso*3.14159265)*sin(time*7.7 + 2), 0.5)", },
					},
					ViewInfo = OperatorInfo { Pos = { 330, -132 } },
				},
				Corte2 = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "Corte1", Source = "Output", },
						Foreground = Input { SourceOp = "Corte2Desp", Source = "Output", },
						Blend = Input { Value = 1, },
						PerformDepthMerge = Input { Value = 0, },
						EffectMask = Input { SourceOp = "Corte2Masc", Source = "Mask", },
					},
					ViewInfo = OperatorInfo { Pos = { 495, 0 } },
				},
			},
		},
		PROGlitchAnim = LUTLookup {
			Inputs = {
			},
			CtrlWZoom = false,
		},
	},
	ActiveTool = "PRO_TR_Glitch"
}
