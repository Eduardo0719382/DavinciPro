{
	Tools = ordered() {
		PRO_TR_WhipPan = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				MainInput1 = InstanceInput { SourceOp = "BlurSaliente", Source = "Input", },
				MainInput2 = InstanceInput { SourceOp = "BlurEntrante", Source = "Input", },
				Input1 = InstanceInput { SourceOp = "Barrido", Source = "Direccion", Name = "Dirección (1 / -1)", Default = 1, },
				Input2 = InstanceInput { SourceOp = "Barrido", Source = "Vertical", Name = "Barrido vertical", Default = 0, },
				Input3 = InstanceInput { SourceOp = "Barrido", Source = "Desenfoque", Name = "Desenfoque de movimiento", Default = 80, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Barrido", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				BlurSaliente = Blur {
					CtrlWShown = false,
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" }, },
						LockXY = Input { Value = 0, },
						XBlurSize = Input { Value = 0, Expression = "Barrido.Desenfoque*sin(Barrido.Progreso*3.14159265)*sin(Barrido.Progreso*3.14159265)*(1 - Barrido.Vertical)", },
						YBlurSize = Input { Value = 0, Expression = "Barrido.Desenfoque*sin(Barrido.Progreso*3.14159265)*sin(Barrido.Progreso*3.14159265)*Barrido.Vertical", },
					},
					ViewInfo = OperatorInfo { Pos = { -220, -33 } },
				},
				BlurEntrante = Blur {
					CtrlWShown = false,
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" }, },
						LockXY = Input { Value = 0, },
						XBlurSize = Input { Value = 0, Expression = "Barrido.Desenfoque*sin(Barrido.Progreso*3.14159265)*sin(Barrido.Progreso*3.14159265)*(1 - Barrido.Vertical)", },
						YBlurSize = Input { Value = 0, Expression = "Barrido.Desenfoque*sin(Barrido.Progreso*3.14159265)*sin(Barrido.Progreso*3.14159265)*Barrido.Vertical", },
					},
					ViewInfo = OperatorInfo { Pos = { -220, 33 } },
				},
				MoverSaliente = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "BlurSaliente", Source = "Output", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5 - Barrido.Direccion*Barrido.Env*(1 - Barrido.Vertical), 0.5 - Barrido.Direccion*Barrido.Env*Barrido.Vertical)", },
					},
					ViewInfo = OperatorInfo { Pos = { -110, -33 } },
				},
				MoverEntrante = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "BlurEntrante", Source = "Output", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5 + Barrido.Direccion*(1 - Barrido.Env)*(1 - Barrido.Vertical), 0.5 + Barrido.Direccion*(1 - Barrido.Env)*Barrido.Vertical)", },
					},
					ViewInfo = OperatorInfo { Pos = { -110, 33 } },
				},
				Barrido = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "MoverSaliente", Source = "Output", },
						Foreground = Input { SourceOp = "MoverEntrante", Source = "Output", },
						PerformDepthMerge = Input { Value = 0, },
						Progreso = Input { SourceOp = "PROWhipPanAnim", Source = "Value", },
						Direccion = Input { Value = 1, },
						Vertical = Input { Value = 0, },
						Desenfoque = Input { Value = 80, },
						Raw = Input { Value = 0, Expression = "(Barrido.Progreso)*(Barrido.Progreso)*(3-2*(Barrido.Progreso))", },
						Env = Input { Value = 0, Expression = "(Barrido.Raw)*(Barrido.Raw)*(3-2*(Barrido.Raw))", },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 } },
					UserControls = ordered() {
						Progreso = {
							LINKS_Name = "Progreso",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Direccion = {
							LINKS_Name = "Dirección (1 / -1)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
							INP_Default = 1,
							INP_MinScale = -1,
							INP_MaxScale = 1,
							INP_MinAllowed = -1,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Vertical = {
							LINKS_Name = "Barrido vertical",
							LINKID_DataType = "Number",
							INPID_InputControl = "CheckboxControl",
							INP_Integer = true,
							CBC_TriState = false,
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Desenfoque = {
							LINKS_Name = "Desenfoque de movimiento",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 80,
							INP_MinScale = 0,
							INP_MaxScale = 200,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 200,
							ICS_ControlPage = "Controls",
						},
						Raw = {
							LINKS_Name = "Curva interna",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
						Env = {
							LINKS_Name = "Curva interna suave",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
					},
				},
			},
		},
		PROWhipPanAnim = LUTLookup {
			Inputs = {
			},
			CtrlWZoom = false,
		},
	},
	ActiveTool = "PRO_TR_WhipPan"
}
