{
	Tools = ordered() {
		PRO_TR_QuemaOrganica = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				MainInput1 = InstanceInput { SourceOp = "Mezcla", Source = "Background", },
				MainInput2 = InstanceInput { SourceOp = "Mezcla", Source = "Foreground", },
				Input1 = InstanceInput { SourceOp = "Pelicula", Source = "Quemado", Name = "Intensidad del quemado", Default = 1, },
				Input2 = InstanceInput { SourceOp = "Pelicula", Source = "Danos", Name = "Daños de película", Default = 1, },
				Input3 = InstanceInput { SourceOp = "ColorFuego", Source = "TopLeftRed", Name = "Color del borde quemado", ControlGroup = 3, Default = 1, },
				Input4 = InstanceInput { SourceOp = "ColorFuego", Source = "TopLeftGreen", ControlGroup = 3, Default = 0.42, },
				Input5 = InstanceInput { SourceOp = "ColorFuego", Source = "TopLeftBlue", ControlGroup = 3, Default = 0.1, },
				Input6 = InstanceInput { SourceOp = "Fuego", Source = "XScale", Name = "Tamaño de las manchas (más alto = más pequeñas)", Default = 2.5, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Pelicula", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Mezcla = Dissolve {
					CtrlWShown = false,
					Inputs = {
						Mix = Input { Value = 0, Expression = "(max(0, min(1, (Pelicula.Progreso - 0.4)/0.2)))*(max(0, min(1, (Pelicula.Progreso - 0.4)/0.2)))*(3-2*(max(0, min(1, (Pelicula.Progreso - 0.4)/0.2))))", },
					},
					ViewInfo = OperatorInfo { Pos = { -440, 0 } },
				},
				MecWeave = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Mezcla", Source = "Output", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5 + Pelicula.Weave*Pelicula.EscalaFormato*0.0015*(sin(time*0.37) + 0.5*sin(time*1.13 + 2)), 0.5 + Pelicula.Weave*Pelicula.EscalaFormato*0.0025*(sin(time*0.29 + 1) + 0.5*sin(time*0.91)))", },
						Size = Input { Value = 1, Expression = "1 + Pelicula.Weave*Pelicula.EscalaFormato*0.006", },
					},
					ViewInfo = OperatorInfo { Pos = { -385, 0 } },
				},
				MecRespira = BrightnessContrast {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "MecWeave", Source = "Output", },
						Gain = Input { Value = 1, Expression = "1 + Pelicula.Respiracion*Pelicula.EscalaFormato*0.025*sin(time*7.3)*sin(time*3.1 + 1)", },
						Saturation = Input { Value = 1, Expression = "1 + Pelicula.Respiracion*Pelicula.EscalaFormato*0.03*sin(time*5.7 + 2)*sin(time*2.3)", },
					},
					ViewInfo = OperatorInfo { Pos = { -330, 0 } },
				},
				Expo = BrightnessContrast {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "MecRespira", Source = "Output", },
						Gain = Input { Value = 1, Expression = "1 + 1.2*Pelicula.Quemado*sin(Pelicula.Progreso*3.14159265)*sin(Pelicula.Progreso*3.14159265)", },
					},
					ViewInfo = OperatorInfo { Pos = { -275, 0 } },
				},
				Fuego = FastNoise {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						Detail = Input { Value = 6, },
						Contrast = Input { Value = 1.6, },
						XScale = Input { Value = 2.5, },
						SeetheRate = Input { Value = 0.03, },
					},
					ViewInfo = OperatorInfo { Pos = { -275, -132 } },
				},
				Borde = BrightnessContrast {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Fuego", Source = "Output", },
						Saturation = Input { Value = 0, },
						Low = Input { Value = 1, Expression = "1 - 0.9*Pelicula.Quemado*sin(Pelicula.Progreso*3.14159265)", },
						High = Input { Value = 1.08, Expression = "Borde.Low + 0.08", },
					},
					ViewInfo = OperatorInfo { Pos = { -220, -132 } },
				},
				BordeBlur = Blur {
					CtrlWShown = false,
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" }, },
						XBlurSize = Input { Value = 12, },
						Input = Input { SourceOp = "Borde", Source = "Output", },
					},
					ViewInfo = OperatorInfo { Pos = { -165, -132 } },
				},
				ColorFuego = Background {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 1, },
						TopLeftGreen = Input { Value = 0.42, },
						TopLeftBlue = Input { Value = 0.1, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { -165, -165 } },
				},
				FuegoTenido = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "BordeBlur", Source = "Output", },
						Foreground = Input { SourceOp = "ColorFuego", Source = "Output", },
						ApplyMode = Input { Value = FuID { "Multiply" }, },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -110, -132 } },
				},
				Nucleo = BrightnessContrast {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Fuego", Source = "Output", },
						Saturation = Input { Value = 0, },
						Low = Input { Value = 1, Expression = "1 - 0.7*Pelicula.Quemado*sin(Pelicula.Progreso*3.14159265)*sin(Pelicula.Progreso*3.14159265)", },
						High = Input { Value = 1.05, Expression = "Nucleo.Low + 0.05", },
					},
					ViewInfo = OperatorInfo { Pos = { -220, -66 } },
				},
				ColorNucleo = Background {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 1, },
						TopLeftGreen = Input { Value = 0.93, },
						TopLeftBlue = Input { Value = 0.78, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { -165, -33 } },
				},
				NucleoTenido = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "Nucleo", Source = "Output", },
						Foreground = Input { SourceOp = "ColorNucleo", Source = "Output", },
						ApplyMode = Input { Value = FuID { "Multiply" }, },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -110, -66 } },
				},
				Quema1 = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "Expo", Source = "Output", },
						Foreground = Input { SourceOp = "FuegoTenido", Source = "Output", },
						ApplyMode = Input { Value = FuID { "Screen" }, },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -55, 0 } },
				},
				Quema2 = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "Quema1", Source = "Output", },
						Foreground = Input { SourceOp = "NucleoTenido", Source = "Output", },
						ApplyMode = Input { Value = FuID { "Screen" }, },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 } },
				},
				DanoMotas = FastNoise {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						Detail = Input { Value = 8, },
						Contrast = Input { Value = 2, },
						XScale = Input { Value = 25, },
						SeetheRate = Input { Value = 3, },
						Discontinuous = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 55, 99 } },
				},
				DanoUmbral = BrightnessContrast {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "DanoMotas", Source = "Output", },
						Low = Input { Value = 0.93, },
						High = Input { Value = 1, },
						Saturation = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 99 } },
				},
				DanoBlanco = Background {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 1, },
						TopLeftGreen = Input { Value = 1, },
						TopLeftBlue = Input { Value = 1, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 132 } },
				},
				DanoInvertir = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "DanoBlanco", Source = "Output", },
						Foreground = Input { SourceOp = "DanoUmbral", Source = "Output", },
						ApplyMode = Input { Value = FuID { "Difference" }, },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 165, 99 } },
				},
				DanoPolvo = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "Quema2", Source = "Output", },
						Foreground = Input { SourceOp = "DanoInvertir", Source = "Output", },
						ApplyMode = Input { Value = FuID { "Multiply" }, },
						Blend = Input { Value = 0.6, Expression = "Pelicula.Polvo", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 220, 0 } },
				},
				DanoLinea = RectangleMask {
					CtrlWShown = false,
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" }, },
						OutputSize = Input { Value = FuID { "Custom" }, },
						MaskWidth = Input { Value = 1920, },
						MaskHeight = Input { Value = 1080, },
						PixelAspect = Input { Value = { 1, 1 }, },
						UseFrameFormatSettings = Input { Value = 1, },
						ClippingMode = Input { Value = FuID { "None" }, },
						Width = Input { Value = 0.0015, },
						Height = Input { Value = 3, },
						SoftEdge = Input { Value = 0.001, },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5 + 0.35*sin(time*0.13)*sin(time*0.071 + 1), 0.5)", },
					},
					ViewInfo = OperatorInfo { Pos = { 220, -99 } },
				},
				DanoRaya = Background {
					CtrlWShown = false,
					Inputs = {
						EffectMask = Input { SourceOp = "DanoLinea", Source = "Mask", },
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 0.95, },
						TopLeftGreen = Input { Value = 0.95, },
						TopLeftBlue = Input { Value = 0.9, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 220, -66 } },
				},
				DanoRayas = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "DanoPolvo", Source = "Output", },
						Foreground = Input { SourceOp = "DanoRaya", Source = "Output", },
						Blend = Input { Value = 0, Expression = "Pelicula.Rayas*max(0, sin(time*0.05))*max(0, sin(time*0.05))", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 275, 0 } },
				},
				Pelicula = BrightnessContrast {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "DanoRayas", Source = "Output", },
						Progreso = Input { SourceOp = "PROQuemaOrganicaAnim", Source = "Value", },
						Danos = Input { Value = 1, },
						Polvo = Input { Value = 0, Expression = "min(1, 0.8*Pelicula.Danos*sin(Pelicula.Progreso*3.14159265))", },
						Rayas = Input { Value = 0, Expression = "min(1, 0.7*Pelicula.Danos*sin(Pelicula.Progreso*3.14159265))", },
						Weave = Input { Value = 0, Expression = "3*Pelicula.Danos*sin(Pelicula.Progreso*3.14159265)", },
						Respiracion = Input { Value = 0, Expression = "4*Pelicula.Danos*sin(Pelicula.Progreso*3.14159265)", },
						EscalaFormato = Input { Value = 1, },
						Quemado = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 385, 0 } },
					UserControls = ordered() {
						Progreso = {
							LINKS_Name = "Progreso",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Danos = {
							LINKS_Name = "Daños de película",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 3,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 3,
							ICS_ControlPage = "Controls",
						},
						Quemado = {
							LINKS_Name = "Intensidad del quemado",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 1.5,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1.5,
							ICS_ControlPage = "Controls",
						},
						Polvo = {
							LINKS_Name = "Polvo interno",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
						Rayas = {
