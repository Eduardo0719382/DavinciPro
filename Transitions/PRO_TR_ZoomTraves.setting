{
	Tools = ordered() {
		PRO_TR_ZoomTraves = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				MainInput1 = InstanceInput { SourceOp = "ZoomA", Source = "Input", },
				MainInput2 = InstanceInput { SourceOp = "ZoomB", Source = "Input", },
				Input1 = InstanceInput { SourceOp = "Traves", Source = "AX", Name = "Punto de A: X", Default = 0.5, },
				Input2 = InstanceInput { SourceOp = "Traves", Source = "AY", Name = "Punto de A: Y", Default = 0.5, },
				Input3 = InstanceInput { SourceOp = "Traves", Source = "BX", Name = "Punto de B: X", Default = 0.5, },
				Input4 = InstanceInput { SourceOp = "Traves", Source = "BY", Name = "Punto de B: Y", Default = 0.5, },
				Input5 = InstanceInput { SourceOp = "Traves", Source = "Zoom", Name = "Zoom", Default = 6, },
				Input6 = InstanceInput { SourceOp = "Traves", Source = "Desenfoque", Name = "Desenfoque", Default = 20, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Traves", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				ZoomA = Transform {
					CtrlWShown = false,
					Inputs = {
						Size = Input { Value = 1, Expression = "(1 + Traves.Zoom*pow(min(1, 2*Traves.Progreso), 3))", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5 + (Traves.AX - 0.5)*(1 - (1 + Traves.Zoom*pow(min(1, 2*Traves.Progreso), 3))), 0.5 + (Traves.AY - 0.5)*(1 - (1 + Traves.Zoom*pow(min(1, 2*Traves.Progreso), 3))))", },
					},
					ViewInfo = OperatorInfo { Pos = { -275, -33 } },
				},
				ZoomB = Transform {
					CtrlWShown = false,
					Inputs = {
						Size = Input { Value = 1, Expression = "(1 + Traves.Zoom*pow((1 - max(0, 2*Traves.Progreso - 1)), 3))", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5 + (Traves.BX - 0.5)*(1 - (1 + Traves.Zoom*pow((1 - max(0, 2*Traves.Progreso - 1)), 3))), 0.5 + (Traves.BY - 0.5)*(1 - (1 + Traves.Zoom*pow((1 - max(0, 2*Traves.Progreso - 1)), 3))))", },
					},
					ViewInfo = OperatorInfo { Pos = { -275, 33 } },
				},
				Mezcla = Dissolve {
					CtrlWShown = false,
					Inputs = {
						Mix = Input { Value = 0, Expression = "(max(0, min(1, (Traves.Progreso - 0.45)/0.1)))*(max(0, min(1, (Traves.Progreso - 0.45)/0.1)))*(3-2*(max(0, min(1, (Traves.Progreso - 0.45)/0.1))))", },
						Background = Input { SourceOp = "ZoomA", Source = "Output", },
						Foreground = Input { SourceOp = "ZoomB", Source = "Output", },
					},
					ViewInfo = OperatorInfo { Pos = { -220, 0 } },
				},
				Movimiento = Blur {
					CtrlWShown = false,
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" }, },
						XBlurSize = Input { Value = 0, Expression = "Traves.Desenfoque*sin(Traves.Progreso*3.14159265)*sin(Traves.Progreso*3.14159265)", },
						Input = Input { SourceOp = "Mezcla", Source = "Output", },
					},
					ViewInfo = OperatorInfo { Pos = { -165, 0 } },
				},
				Traves = BrightnessContrast {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Movimiento", Source = "Output", },
						Progreso = Input { SourceOp = "PROZoomTravesAnim", Source = "Value", },
						AX = Input { Value = 0.5, },
						AY = Input { Value = 0.5, },
						BX = Input { Value = 0.5, },
						BY = Input { Value = 0.5, },
						Zoom = Input { Value = 6, },
						Desenfoque = Input { Value = 20, },
					},
					ViewInfo = OperatorInfo { Pos = { -110, 0 } },
					UserControls = ordered() {
						Progreso = {
							LINKS_Name = "Progreso",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						AX = {
							LINKS_Name = "Punto de A: X",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.5,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						AY = {
							LINKS_Name = "Punto de A: Y",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.5,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						BX = {
							LINKS_Name = "Punto de B: X",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.5,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						BY = {
							LINKS_Name = "Punto de B: Y",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.5,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Zoom = {
							LINKS_Name = "Zoom",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 6,
							INP_MinScale = 0.5,
							INP_MaxScale = 20,
							INP_MinAllowed = 0.5,
							INP_MaxAllowed = 20,
							ICS_ControlPage = "Controls",
						},
						Desenfoque = {
							LINKS_Name = "Desenfoque",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 20,
							INP_MinScale = 0,
							INP_MaxScale = 100,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 100,
							ICS_ControlPage = "Controls",
						},
					},
				},
			},
		},
		PROZoomTravesAnim = LUTLookup {
			Inputs = {
			},
			CtrlWZoom = false,
		},
	},
	ActiveTool = "PRO_TR_ZoomTraves"
}
