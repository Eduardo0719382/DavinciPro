{
	Tools = ordered() {
		PRO_TR_Corte = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				MainInput1 = InstanceInput { SourceOp = "EntradaA", Source = "Input", },
				MainInput2 = InstanceInput { SourceOp = "EntradaB", Source = "Input", },
				Input1 = InstanceInput { SourceOp = "Corte", Source = "Angulo", Name = "Ángulo del corte (grados)", Default = 30, },
				Input2 = InstanceInput { SourceOp = "Corte", Source = "Distancia", Name = "Distancia que se deslizan", Default = 1.2, },
				Input3 = InstanceInput { SourceOp = "Tajo", Source = "TopLeftRed", Name = "Color de la línea", ControlGroup = 3, Default = 1, },
				Input4 = InstanceInput { SourceOp = "Tajo", Source = "TopLeftGreen", ControlGroup = 3, Default = 1, },
				Input5 = InstanceInput { SourceOp = "Tajo", Source = "TopLeftBlue", ControlGroup = 3, Default = 1, },
				Input6 = InstanceInput { SourceOp = "Corte", Source = "Aspecto", Name = "Aspecto del timeline (16:9 = 1.778, 9:16 = 0.5625)", Default = 1.7778, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Corte", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				EntradaA = PipeRouter {
					CtrlWShown = false,
					ViewInfo = PipeRouterInfo { Pos = { -385, -66 } },
				},
				EntradaB = PipeRouter {
					CtrlWShown = false,
					ViewInfo = PipeRouterInfo { Pos = { -385, 66 } },
				},
				MitadSup = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "EntradaA", Source = "Output", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5 + 1*Corte.Distancia*(max(0, min(1, (Corte.Progreso - 0.15)/0.85)))*(max(0, min(1, (Corte.Progreso - 0.15)/0.85)))*(3-2*(max(0, min(1, (Corte.Progreso - 0.15)/0.85))))*cos((Corte.Angulo*3.14159265/180)) + 1*0.04*(max(0, min(1, (Corte.Progreso - 0.15)/0.85)))*(max(0, min(1, (Corte.Progreso - 0.15)/0.85)))*(3-2*(max(0, min(1, (Corte.Progreso - 0.15)/0.85))))*(-sin((Corte.Angulo*3.14159265/180))), 0.5 + 1*Corte.Distancia*(max(0, min(1, (Corte.Progreso - 0.15)/0.85)))*(max(0, min(1, (Corte.Progreso - 0.15)/0.85)))*(3-2*(max(0, min(1, (Corte.Progreso - 0.15)/0.85))))*sin((Corte.Angulo*3.14159265/180))*Corte.Aspecto + 1*0.04*(max(0, min(1, (Corte.Progreso - 0.15)/0.85)))*(max(0, min(1, (Corte.Progreso - 0.15)/0.85)))*(3-2*(max(0, min(1, (Corte.Progreso - 0.15)/0.85))))*cos((Corte.Angulo*3.14159265/180))*Corte.Aspecto)", },
					},
					ViewInfo = OperatorInfo { Pos = { -330, -66 } },
				},
				MascSup = RectangleMask {
					CtrlWShown = false,
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" }, },
						OutputSize = Input { Value = FuID { "Custom" }, },
						MaskWidth = Input { Value = 1920, },
						MaskHeight = Input { Value = 1080, },
						PixelAspect = Input { Value = { 1, 1 }, },
						UseFrameFormatSettings = Input { Value = 1, },
						ClippingMode = Input { Value = FuID { "None" }, },
						Width = Input { Value = 8, },
						Height = Input { Value = 8, },
						Angle = Input { Value = 30, Expression = "Corte.Angulo", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5 + 1*4*(-sin((Corte.Angulo*3.14159265/180)))/Corte.Aspecto + 1*Corte.Distancia*(max(0, min(1, (Corte.Progreso - 0.15)/0.85)))*(max(0, min(1, (Corte.Progreso - 0.15)/0.85)))*(3-2*(max(0, min(1, (Corte.Progreso - 0.15)/0.85))))*cos((Corte.Angulo*3.14159265/180)) + 1*0.04*(max(0, min(1, (Corte.Progreso - 0.15)/0.85)))*(max(0, min(1, (Corte.Progreso - 0.15)/0.85)))*(3-2*(max(0, min(1, (Corte.Progreso - 0.15)/0.85))))*(-sin((Corte.Angulo*3.14159265/180))), 0.5 + 1*4*cos((Corte.Angulo*3.14159265/180)) + 1*Corte.Distancia*(max(0, min(1, (Corte.Progreso - 0.15)/0.85)))*(max(0, min(1, (Corte.Progreso - 0.15)/0.85)))*(3-2*(max(0, min(1, (Corte.Progreso - 0.15)/0.85))))*sin((Corte.Angulo*3.14159265/180))*Corte.Aspecto + 1*0.04*(max(0, min(1, (Corte.Progreso - 0.15)/0.85)))*(max(0, min(1, (Corte.Progreso - 0.15)/0.85)))*(3-2*(max(0, min(1, (Corte.Progreso - 0.15)/0.85))))*cos((Corte.Angulo*3.14159265/180))*Corte.Aspecto)", },
					},
					ViewInfo = OperatorInfo { Pos = { -275, -132 } },
				},
				ConSup = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "EntradaB", Source = "Output", },
						Foreground = Input { SourceOp = "MitadSup", Source = "Output", },
						PerformDepthMerge = Input { Value = 0, },
						EffectMask = Input { SourceOp = "MascSup", Source = "Mask", },
					},
					ViewInfo = OperatorInfo { Pos = { -275, 0 } },
				},
				MitadInf = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "EntradaA", Source = "Output", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5 + -1*Corte.Distancia*(max(0, min(1, (Corte.Progreso - 0.15)/0.85)))*(max(0, min(1, (Corte.Progreso - 0.15)/0.85)))*(3-2*(max(0, min(1, (Corte.Progreso - 0.15)/0.85))))*cos((Corte.Angulo*3.14159265/180)) + -1*0.04*(max(0, min(1, (Corte.Progreso - 0.15)/0.85)))*(max(0, min(1, (Corte.Progreso - 0.15)/0.85)))*(3-2*(max(0, min(1, (Corte.Progreso - 0.15)/0.85))))*(-sin((Corte.Angulo*3.14159265/180))), 0.5 + -1*Corte.Distancia*(max(0, min(1, (Corte.Progreso - 0.15)/0.85)))*(max(0, min(1, (Corte.Progreso - 0.15)/0.85)))*(3-2*(max(0, min(1, (Corte.Progreso - 0.15)/0.85))))*sin((Corte.Angulo*3.14159265/180))*Corte.Aspecto + -1*0.04*(max(0, min(1, (Corte.Progreso - 0.15)/0.85)))*(max(0, min(1, (Corte.Progreso - 0.15)/0.85)))*(3-2*(max(0, min(1, (Corte.Progreso - 0.15)/0.85))))*cos((Corte.Angulo*3.14159265/180))*Corte.Aspecto)", },
					},
					ViewInfo = OperatorInfo { Pos = { -330, 66 } },
				},
