					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "ConSup", Source = "Output", },
						Foreground = Input { SourceOp = "MitadInf", Source = "Output", },
						PerformDepthMerge = Input { Value = 0, },
						EffectMask = Input { SourceOp = "MascInf", Source = "Mask", },
					},
					ViewInfo = OperatorInfo { Pos = { -220, 0 } },
				},
				MascTajo = RectangleMask {
					CtrlWShown = false,
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" }, },
						OutputSize = Input { Value = FuID { "Custom" }, },
						MaskWidth = Input { Value = 1920, },
						MaskHeight = Input { Value = 1080, },
						PixelAspect = Input { Value = { 1, 1 }, },
						UseFrameFormatSettings = Input { Value = 1, },
						ClippingMode = Input { Value = FuID { "None" }, },
						Width = Input { Value = 0, Expression = "8*max(0, min(1, Corte.Progreso/0.15))", },
						Height = Input { Value = 0.004, },
						Angle = Input { Value = 30, Expression = "Corte.Angulo", },
					},
					ViewInfo = OperatorInfo { Pos = { -165, -132 } },
				},
				Tajo = Background {
					CtrlWShown = false,
					Inputs = {
						EffectMask = Input { SourceOp = "MascTajo", Source = "Mask", },
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 1, },
						TopLeftGreen = Input { Value = 1, },
						TopLeftBlue = Input { Value = 1, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { -165, -99 } },
				},
				ConTajo = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "ConInf", Source = "Output", },
						Foreground = Input { SourceOp = "Tajo", Source = "Output", },
						Blend = Input { Value = 0, Expression = "min(1, 3*(1 - (max(0, min(1, (Corte.Progreso - 0.15)/0.85)))*(max(0, min(1, (Corte.Progreso - 0.15)/0.85)))*(3-2*(max(0, min(1, (Corte.Progreso - 0.15)/0.85))))))*iif(Corte.Progreso > 0, 1, 0)", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -165, 0 } },
