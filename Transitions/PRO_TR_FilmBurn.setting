{
	Tools = ordered() {
		PRO_TR_FilmBurn = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				MainInput1 = InstanceInput { SourceOp = "Mezcla", Source = "Background", },
				MainInput2 = InstanceInput { SourceOp = "Mezcla", Source = "Foreground", },
				Input1 = InstanceInput { SourceOp = "Mezcla", Source = "Quemado", Name = "Intensidad del quemado", Default = 1, },
				Input2 = InstanceInput { SourceOp = "QuemaMasc", Source = "Center", Name = "Origen del quemado", },
				Input3 = InstanceInput { SourceOp = "QuemaColor", Source = "TopLeftRed", Name = "Color del quemado", ControlGroup = 3, Default = 1, },
				Input4 = InstanceInput { SourceOp = "QuemaColor", Source = "TopLeftGreen", ControlGroup = 3, Default = 0.45, },
				Input5 = InstanceInput { SourceOp = "QuemaColor", Source = "TopLeftBlue", ControlGroup = 3, Default = 0.12, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Quemado2", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Mezcla = Dissolve {
					CtrlWShown = false,
					Inputs = {
						Mix = Input { Value = 0, Expression = "(max(0, min(1, (Mezcla.Progreso - 0.35)/0.3)))*(max(0, min(1, (Mezcla.Progreso - 0.35)/0.3)))*(3-2*(max(0, min(1, (Mezcla.Progreso - 0.35)/0.3))))", },
						Progreso = Input { SourceOp = "PROFilmBurnAnim", Source = "Value", },
						Quemado = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 } },
					UserControls = ordered() {
						Progreso = {
							LINKS_Name = "Progreso",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Quemado = {
							LINKS_Name = "Intensidad del quemado",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 2,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 2,
							ICS_ControlPage = "Controls",
						},
					},
				},
				Sobreexpo = BrightnessContrast {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Mezcla", Source = "Output", },
						Gain = Input { Value = 1, Expression = "1 + 1.5*Mezcla.Quemado*sin(Mezcla.Progreso*3.14159265)*sin(Mezcla.Progreso*3.14159265)", },
					},
					ViewInfo = OperatorInfo { Pos = { 55, 0 } },
				},
				QuemaMasc = EllipseMask {
					CtrlWShown = false,
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" }, },
						OutputSize = Input { Value = FuID { "Custom" }, },
						MaskWidth = Input { Value = 1920, },
						MaskHeight = Input { Value = 1080, },
						PixelAspect = Input { Value = { 1, 1 }, },
						UseFrameFormatSettings = Input { Value = 1, },
						ClippingMode = Input { Value = FuID { "None" }, },
						Center = Input { Value = { 0.3, 0.4 }, },
						SoftEdge = Input { Value = 0.8, },
						Width = Input { Value = 0.2, Expression = "0.2 + 2.5*sin(Mezcla.Progreso*3.14159265)", },
						Height = Input { Value = 0.2, Expression = "0.2 + 2.0*sin(Mezcla.Progreso*3.14159265)", },
					},
					ViewInfo = OperatorInfo { Pos = { 110, -99 } },
				},
				QuemaColor = Background {
					CtrlWShown = false,
					Inputs = {
						EffectMask = Input { SourceOp = "QuemaMasc", Source = "Mask", },
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 1, },
						TopLeftGreen = Input { Value = 0.45, },
						TopLeftBlue = Input { Value = 0.12, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, -66 } },
				},
				NucleoMasc = EllipseMask {
					CtrlWShown = false,
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" }, },
						OutputSize = Input { Value = FuID { "Custom" }, },
						MaskWidth = Input { Value = 1920, },
						MaskHeight = Input { Value = 1080, },
						PixelAspect = Input { Value = { 1, 1 }, },
						UseFrameFormatSettings = Input { Value = 1, },
						ClippingMode = Input { Value = FuID { "None" }, },
						SoftEdge = Input { Value = 0.5, },
						Center = Input { Value = { 0.3, 0.4 }, Expression = "Point(QuemaMasc.Center.X, QuemaMasc.Center.Y)", },
						Width = Input { Value = 0.1, Expression = "0.1 + 1.2*sin(Mezcla.Progreso*3.14159265)*sin(Mezcla.Progreso*3.14159265)", },
						Height = Input { Value = 0.1, Expression = "0.1 + 1.0*sin(Mezcla.Progreso*3.14159265)*sin(Mezcla.Progreso*3.14159265)", },
					},
					ViewInfo = OperatorInfo { Pos = { 165, -99 } },
				},
				NucleoColor = Background {
					CtrlWShown = false,
					Inputs = {
						EffectMask = Input { SourceOp = "NucleoMasc", Source = "Mask", },
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 1, },
						TopLeftGreen = Input { Value = 0.92, },
						TopLeftBlue = Input { Value = 0.75, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 165, -66 } },
				},
				Quemado1 = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "Sobreexpo", Source = "Output", },
						Foreground = Input { SourceOp = "QuemaColor", Source = "Output", },
						ApplyMode = Input { Value = FuID { "Screen" }, },
						Blend = Input { Value = 0, Expression = "Mezcla.Quemado*sin(Mezcla.Progreso*3.14159265)", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 165, 0 } },
				},
				Quemado2 = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "Quemado1", Source = "Output", },
						Foreground = Input { SourceOp = "NucleoColor", Source = "Output", },
						ApplyMode = Input { Value = FuID { "Screen" }, },
						Blend = Input { Value = 0, Expression = "Mezcla.Quemado*sin(Mezcla.Progreso*3.14159265)*sin(Mezcla.Progreso*3.14159265)", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 220, 0 } },
				},
			},
		},
		PROFilmBurnAnim = LUTLookup {
			Inputs = {
			},
			CtrlWZoom = false,
		},
	},
	ActiveTool = "PRO_TR_FilmBurn"
}
