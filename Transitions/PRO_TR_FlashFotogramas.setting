{
	Tools = ordered() {
		PRO_TR_FlashFotogramas = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				MainInput1 = InstanceInput { SourceOp = "Mezcla", Source = "Background", },
				MainInput2 = InstanceInput { SourceOp = "Mezcla", Source = "Foreground", },
				Input1 = InstanceInput { SourceOp = "Pelicula", Source = "Flashes", Name = "Destellos", Default = 1, },
				Input2 = InstanceInput { SourceOp = "Pelicula", Source = "Saltos", Name = "Saltos de fotograma", Default = 1, },
				Input3 = InstanceInput { SourceOp = "Pelicula", Source = "Danos", Name = "Daños de película", Default = 1, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Pelicula", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Mezcla = Dissolve {
					CtrlWShown = false,
					Inputs = {
						Mix = Input { Value = 0, Expression = "max(0, min(1, (Pelicula.Progreso - 0.5)*8 + 3*sin(time*2.9)*sin(time*1.7 + 1)*sin(Pelicula.Progreso*3.14159265)))", },
					},
					ViewInfo = OperatorInfo { Pos = { -385, 0 } },
				},
				Salto = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Mezcla", Source = "Output", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5, 0.5 + Pelicula.Saltos*0.04*sin(Pelicula.Progreso*3.14159265)*sin(time*3.7)*sin(time*1.9 + 2))", },
						Size = Input { Value = 1, Expression = "1 + Pelicula.Saltos*0.04*sin(Pelicula.Progreso*3.14159265)", },
					},
					ViewInfo = OperatorInfo { Pos = { -330, 0 } },
				},
				Destellos = BrightnessContrast {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Salto", Source = "Output", },
						Gain = Input { Value = 1, Expression = "1 + Pelicula.Flashes*sin(Pelicula.Progreso*3.14159265)*6*max(0, sin(time*4.1)*sin(time*1.3 + 2))", },
					},
					ViewInfo = OperatorInfo { Pos = { -275, 0 } },
				},
				MecWeave = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Destellos", Source = "Output", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5 + Pelicula.Weave*Pelicula.EscalaFormato*0.0015*(sin(time*0.37) + 0.5*sin(time*1.13 + 2)), 0.5 + Pelicula.Weave*Pelicula.EscalaFormato*0.0025*(sin(time*0.29 + 1) + 0.5*sin(time*0.91)))", },
						Size = Input { Value = 1, Expression = "1 + Pelicula.Weave*Pelicula.EscalaFormato*0.006", },
					},
					ViewInfo = OperatorInfo { Pos = { -220, 0 } },
				},
				MecRespira = BrightnessContrast {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "MecWeave", Source = "Output", },
						Gain = Input { Value = 1, Expression = "1 + Pelicula.Respiracion*Pelicula.EscalaFormato*0.025*sin(time*7.3)*sin(time*3.1 + 1)", },
						Saturation = Input { Value = 1, Expression = "1 + Pelicula.Respiracion*Pelicula.EscalaFormato*0.03*sin(time*5.7 + 2)*sin(time*2.3)", },
					},
					ViewInfo = OperatorInfo { Pos = { -165, 0 } },
				},
				DanoMotas = FastNoise {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						Detail = Input { Value = 8, },
						Contrast = Input { Value = 2, },
						XScale = Input { Value = 25, },
						SeetheRate = Input { Value = 3, },
						Discontinuous = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { -110, 99 } },
				},
				DanoUmbral = BrightnessContrast {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "DanoMotas", Source = "Output", },
						Low = Input { Value = 0.93, },
						High = Input { Value = 1, },
						Saturation = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -55, 99 } },
				},
				DanoBlanco = Background {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 1, },
						TopLeftGreen = Input { Value = 1, },
						TopLeftBlue = Input { Value = 1, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { -55, 132 } },
				},
				DanoInvertir = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "DanoBlanco", Source = "Output", },
						Foreground = Input { SourceOp = "DanoUmbral", Source = "Output", },
						ApplyMode = Input { Value = FuID { "Difference" }, },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 99 } },
				},
				DanoPolvo = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "MecRespira", Source = "Output", },
						Foreground = Input { SourceOp = "DanoInvertir", Source = "Output", },
						ApplyMode = Input { Value = FuID { "Multiply" }, },
						Blend = Input { Value = 0.6, Expression = "Pelicula.Polvo", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 55, 0 } },
				},
				DanoLinea = RectangleMask {
					CtrlWShown = false,
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" }, },
						OutputSize = Input { Value = FuID { "Custom" }, },
						MaskWidth = Input { Value = 1920, },
						MaskHeight = Input { Value = 1080, },
						PixelAspect = Input { Value = { 1, 1 }, },
						UseFrameFormatSettings = Input { Value = 1, },
						ClippingMode = Input { Value = FuID { "None" }, },
						Width = Input { Value = 0.0015, },
						Height = Input { Value = 3, },
						SoftEdge = Input { Value = 0.001, },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5 + 0.35*sin(time*0.13)*sin(time*0.071 + 1), 0.5)", },
					},
					ViewInfo = OperatorInfo { Pos = { 55, -99 } },
				},
				DanoRaya = Background {
					CtrlWShown = false,
					Inputs = {
						EffectMask = Input { SourceOp = "DanoLinea", Source = "Mask", },
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 0.95, },
						TopLeftGreen = Input { Value = 0.95, },
						TopLeftBlue = Input { Value = 0.9, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 55, -66 } },
				},
				DanoRayas = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "DanoPolvo", Source = "Output", },
						Foreground = Input { SourceOp = "DanoRaya", Source = "Output", },
						Blend = Input { Value = 0, Expression = "Pelicula.Rayas*max(0, sin(time*0.05))*max(0, sin(time*0.05))", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 } },
				},
				Pelicula = BrightnessContrast {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "DanoRayas", Source = "Output", },
						Progreso = Input { SourceOp = "PROFlashFotogramasAnim", Source = "Value", },
						Danos = Input { Value = 1, },
						Polvo = Input { Value = 0, Expression = "min(1, 0.8*Pelicula.Danos*sin(Pelicula.Progreso*3.14159265))", },
						Rayas = Input { Value = 0, Expression = "min(1, 0.7*Pelicula.Danos*sin(Pelicula.Progreso*3.14159265))", },
						Weave = Input { Value = 0, Expression = "3*Pelicula.Danos*sin(Pelicula.Progreso*3.14159265)", },
						Respiracion = Input { Value = 0, Expression = "4*Pelicula.Danos*sin(Pelicula.Progreso*3.14159265)", },
						EscalaFormato = Input { Value = 1, },
						Flashes = Input { Value = 1, },
						Saltos = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 220, 0 } },
					UserControls = ordered() {
						Progreso = {
							LINKS_Name = "Progreso",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Danos = {
							LINKS_Name = "Daños de película",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 3,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 3,
							ICS_ControlPage = "Controls",
						},
						Flashes = {
							LINKS_Name = "Destellos",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 2,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 2,
							ICS_ControlPage = "Controls",
						},
						Saltos = {
							LINKS_Name = "Saltos de fotograma",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 3,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 3,
							ICS_ControlPage = "Controls",
						},
						Polvo = {
							LINKS_Name = "Polvo interno",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
						Rayas = {
							LINKS_Name = "Rayas internas",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
						Weave = {
							LINKS_Name = "Weave interno",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 10,
							ICS_ControlPage = "Controls",
						},
						Respiracion = {
							LINKS_Name = "Respiración interna",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 10,
							ICS_ControlPage = "Controls",
						},
						EscalaFormato = {
							LINKS_Name = "Escala interna",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 10,
							ICS_ControlPage = "Controls",
						},
					},
				},
			},
		},
		PROFlashFotogramasAnim = LUTLookup {
			Inputs = {
			},
			CtrlWZoom = false,
		},
	},
	ActiveTool = "PRO_TR_FlashFotogramas"
}
