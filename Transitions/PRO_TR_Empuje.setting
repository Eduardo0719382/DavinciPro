{
	Tools = ordered() {
		PRO_TR_Empuje = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				MainInput1 = InstanceInput { SourceOp = "BlurA", Source = "Input", },
				MainInput2 = InstanceInput { SourceOp = "BlurB", Source = "Input", },
				Input1 = InstanceInput { SourceOp = "Empuje", Source = "DirX", Name = "Dirección X (-1 izquierda / 1 derecha)", Default = -1, },
				Input2 = InstanceInput { SourceOp = "Empuje", Source = "DirY", Name = "Dirección Y (-1 abajo / 1 arriba)", Default = 0, },
				Input3 = InstanceInput { SourceOp = "Empuje", Source = "Desenfoque", Name = "Desenfoque de movimiento", Default = 60, },
				Input4 = InstanceInput { SourceOp = "Empuje", Source = "Glow", Name = "Glow", Default = 0.5, },
				Input5 = InstanceInput { SourceOp = "Empuje", Source = "Flash", Name = "Flash", Default = 0.4, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Empuje", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				BlurA = Blur {
					CtrlWShown = false,
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" }, },
						LockXY = Input { Value = 0, },
						XBlurSize = Input { Value = 0, Expression = "Empuje.Desenfoque*sin(Empuje.Progreso*3.14159265)*sin(Empuje.Progreso*3.14159265)*Empuje.DirX*Empuje.DirX", },
						YBlurSize = Input { Value = 0, Expression = "Empuje.Desenfoque*sin(Empuje.Progreso*3.14159265)*sin(Empuje.Progreso*3.14159265)*Empuje.DirY*Empuje.DirY", },
					},
					ViewInfo = OperatorInfo { Pos = { -330, -33 } },
				},
				BlurB = Blur {
					CtrlWShown = false,
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" }, },
						LockXY = Input { Value = 0, },
						XBlurSize = Input { Value = 0, Expression = "Empuje.Desenfoque*sin(Empuje.Progreso*3.14159265)*sin(Empuje.Progreso*3.14159265)*Empuje.DirX*Empuje.DirX", },
						YBlurSize = Input { Value = 0, Expression = "Empuje.Desenfoque*sin(Empuje.Progreso*3.14159265)*sin(Empuje.Progreso*3.14159265)*Empuje.DirY*Empuje.DirY", },
					},
					ViewInfo = OperatorInfo { Pos = { -330, 33 } },
				},
				MoverA = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "BlurA", Source = "Output", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5 + Empuje.DirX*Empuje.Env, 0.5 + Empuje.DirY*Empuje.Env)", },
					},
					ViewInfo = OperatorInfo { Pos = { -275, -33 } },
				},
				MoverB = Transform {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "BlurB", Source = "Output", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5 - Empuje.DirX*(1 - Empuje.Env), 0.5 - Empuje.DirY*(1 - Empuje.Env))", },
					},
					ViewInfo = OperatorInfo { Pos = { -275, 33 } },
				},
				Juntos = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "MoverA", Source = "Output", },
						Foreground = Input { SourceOp = "MoverB", Source = "Output", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -220, 0 } },
				},
				GlowAltas = BrightnessContrast {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Juntos", Source = "Output", },
						Low = Input { Value = 0.6, },
						High = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { -165, -66 } },
				},
				GlowBlur = Blur {
					CtrlWShown = false,
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" }, },
						XBlurSize = Input { Value = 40, },
						Input = Input { SourceOp = "GlowAltas", Source = "Output", },
					},
					ViewInfo = OperatorInfo { Pos = { -110, -66 } },
				},
				ConGlow = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "Juntos", Source = "Output", },
						Foreground = Input { SourceOp = "GlowBlur", Source = "Output", },
						ApplyMode = Input { Value = FuID { "Screen" }, },
						Blend = Input { Value = 0, Expression = "Empuje.Glow*sin(Empuje.Progreso*3.14159265)*sin(Empuje.Progreso*3.14159265)", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -110, 0 } },
				},
				Blanco = Background {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 1, },
						TopLeftGreen = Input { Value = 1, },
						TopLeftBlue = Input { Value = 1, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { -55, -66 } },
				},
				Empuje = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "ConGlow", Source = "Output", },
						Foreground = Input { SourceOp = "Blanco", Source = "Output", },
						ApplyMode = Input { Value = FuID { "Screen" }, },
						Blend = Input { Value = 0, Expression = "Empuje.Flash*sin(Empuje.Progreso*3.14159265)*sin(Empuje.Progreso*3.14159265)*sin(Empuje.Progreso*3.14159265)*sin(Empuje.Progreso*3.14159265)", },
						PerformDepthMerge = Input { Value = 0, },
						Progreso = Input { SourceOp = "PROEmpujeAnim", Source = "Value", },
						DirX = Input { Value = -1, },
						DirY = Input { Value = 0, },
						Desenfoque = Input { Value = 60, },
						Glow = Input { Value = 0.5, },
						Flash = Input { Value = 0.4, },
						Raw = Input { Value = 0, Expression = "(Empuje.Progreso)*(Empuje.Progreso)*(3-2*(Empuje.Progreso))", },
						Env = Input { Value = 0, Expression = "(Empuje.Raw)*(Empuje.Raw)*(3-2*(Empuje.Raw))", },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 } },
					UserControls = ordered() {
						Progreso = {
							LINKS_Name = "Progreso",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						DirX = {
							LINKS_Name = "Dirección X (-1 izquierda / 1 derecha)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
							INP_Default = -1,
							INP_MinScale = -1,
							INP_MaxScale = 1,
							INP_MinAllowed = -1,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						DirY = {
							LINKS_Name = "Dirección Y (-1 abajo / 1 arriba)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
							INP_Default = 0,
							INP_MinScale = -1,
							INP_MaxScale = 1,
							INP_MinAllowed = -1,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Desenfoque = {
							LINKS_Name = "Desenfoque de movimiento",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 60,
							INP_MinScale = 0,
							INP_MaxScale = 200,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 200,
							ICS_ControlPage = "Controls",
						},
						Glow = {
							LINKS_Name = "Glow",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.5,
							INP_MinScale = 0,
							INP_MaxScale = 2,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 2,
							ICS_ControlPage = "Controls",
						},
						Flash = {
							LINKS_Name = "Flash",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.4,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Raw = {
							LINKS_Name = "Curva interna",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
						Env = {
							LINKS_Name = "Curva interna suave",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
					},
				},
			},
		},
		PROEmpujeAnim = LUTLookup {
			Inputs = {
			},
			CtrlWZoom = false,
		},
	},
	ActiveTool = "PRO_TR_Empuje"
}
