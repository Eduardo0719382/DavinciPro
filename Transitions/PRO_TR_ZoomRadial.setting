						Background = Input { SourceOp = "RadialMedia1", Source = "Output", },
						Foreground = Input { SourceOp = "Radial2", Source = "Output", },
						Blend = Input { Value = 0.333333, },
						PerformDepthMerge = Input { Value = 0, },
					},
