					Inputs = {
						Input = Input { SourceOp = "Mezcla", Source = "Output", },
						Size = Input { Value = 1, Expression = "1 + Mezcla.Fuerza*0.25*0.5*sin(Mezcla.Progreso*3.14159265)*sin(Mezcla.Progreso*3.14159265)", },
					},
					ViewInfo = OperatorInfo { Pos = { -11, -66 } },
				},
