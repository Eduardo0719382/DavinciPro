					Inputs = {
						Input = Input { SourceOp = "Mezcla", Source = "Output", },
						Size = Input { Value = 1, Expression = "1 + Mezcla.Fuerza*0.25*1*sin(Mezcla.Progreso*3.14159265)*sin(Mezcla.Progreso*3.14159265)", },
