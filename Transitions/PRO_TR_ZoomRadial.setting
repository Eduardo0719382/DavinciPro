						Input = Input { SourceOp = "Mezcla", Source = "Output", },
						Size = Input { Value = 1, Expression = "1 + Mezcla.Fuerza*0.25*0.833333*sin(Mezcla.Progreso*3.14159265)*sin(Mezcla.Progreso*3.14159265)", },
					},
					ViewInfo = OperatorInfo { Pos = { 55, -66 } },
				},
				RadialMedia5 = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "RadialMedia4", Source = "Output", },
						Foreground = Input { SourceOp = "Radial5", Source = "Output", },
						Blend = Input { Value = 0.166667, },
						PerformDepthMerge = Input { Value = 0, },
