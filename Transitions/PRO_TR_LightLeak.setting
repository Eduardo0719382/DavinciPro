{
	Tools = ordered() {
		PRO_TR_LightLeak = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				MainInput1 = InstanceInput { SourceOp = "Mezcla", Source = "Background", },
				MainInput2 = InstanceInput { SourceOp = "Mezcla", Source = "Foreground", },
				Input1 = InstanceInput { SourceOp = "Mezcla", Source = "Intensidad", Name = "Intensidad de la fuga", Default = 0.9, },
				Input2 = InstanceInput { SourceOp = "Fuga1", Source = "TopLeftRed", Name = "Color principal", ControlGroup = 2, Default = 1, },
				Input3 = InstanceInput { SourceOp = "Fuga1", Source = "TopLeftGreen", ControlGroup = 2, Default = 0.55, },
				Input4 = InstanceInput { SourceOp = "Fuga1", Source = "TopLeftBlue", ControlGroup = 2, Default = 0.2, },
				Input5 = InstanceInput { SourceOp = "Fuga2", Source = "TopLeftRed", Name = "Color secundario", ControlGroup = 3, Default = 1, },
				Input6 = InstanceInput { SourceOp = "Fuga2", Source = "TopLeftGreen", ControlGroup = 3, Default = 0.25, },
				Input7 = InstanceInput { SourceOp = "Fuga2", Source = "TopLeftBlue", ControlGroup = 3, Default = 0.1, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Luz2", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Mezcla = Dissolve {
					CtrlWShown = false,
					Inputs = {
						Mix = Input { Value = 0, Expression = "(max(0, min(1, (Mezcla.Progreso - 0.3)/0.4)))*(max(0, min(1, (Mezcla.Progreso - 0.3)/0.4)))*(3-2*(max(0, min(1, (Mezcla.Progreso - 0.3)/0.4))))", },
						Progreso = Input { SourceOp = "PROLightLeakAnim", Source = "Value", },
						Intensidad = Input { Value = 0.9, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 } },
					UserControls = ordered() {
						Progreso = {
							LINKS_Name = "Progreso",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Intensidad = {
							LINKS_Name = "Intensidad de la fuga",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.9,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
					},
				},
				Ovalo1 = EllipseMask {
					CtrlWShown = false,
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" }, },
						OutputSize = Input { Value = FuID { "Custom" }, },
						MaskWidth = Input { Value = 1920, },
						MaskHeight = Input { Value = 1080, },
						PixelAspect = Input { Value = { 1, 1 }, },
						UseFrameFormatSettings = Input { Value = 1, },
						ClippingMode = Input { Value = FuID { "None" }, },
						SoftEdge = Input { Value = 0.5, },
						Width = Input { Value = 0.9, },
						Height = Input { Value = 0.9, },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(-0.3 + 1.6*Mezcla.Progreso, 0.6 + 0.1*sin(Mezcla.Progreso*3.14159265))", },
					},
					ViewInfo = OperatorInfo { Pos = { 0, -132 } },
				},
				Ovalo2 = EllipseMask {
					CtrlWShown = false,
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" }, },
						OutputSize = Input { Value = FuID { "Custom" }, },
						MaskWidth = Input { Value = 1920, },
						MaskHeight = Input { Value = 1080, },
						PixelAspect = Input { Value = { 1, 1 }, },
						UseFrameFormatSettings = Input { Value = 1, },
						ClippingMode = Input { Value = FuID { "None" }, },
						SoftEdge = Input { Value = 0.4, },
						Width = Input { Value = 0.6, },
						Height = Input { Value = 0.6, },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(1.2 - 1.2*Mezcla.Progreso, 0.35)", },
					},
					ViewInfo = OperatorInfo { Pos = { 110, -132 } },
				},
				Fuga1 = Background {
					CtrlWShown = false,
					Inputs = {
						EffectMask = Input { SourceOp = "Ovalo1", Source = "Mask", },
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 1, },
						TopLeftGreen = Input { Value = 0.55, },
						TopLeftBlue = Input { Value = 0.2, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, -99 } },
				},
				Fuga2 = Background {
					CtrlWShown = false,
					Inputs = {
						EffectMask = Input { SourceOp = "Ovalo2", Source = "Mask", },
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 1, },
						TopLeftGreen = Input { Value = 0.25, },
						TopLeftBlue = Input { Value = 0.1, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, -99 } },
				},
				Luz1 = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "Mezcla", Source = "Output", },
						Foreground = Input { SourceOp = "Fuga1", Source = "Output", },
						ApplyMode = Input { Value = FuID { "Screen" }, },
						Blend = Input { Value = 0, Expression = "Mezcla.Intensidad*sin(Mezcla.Progreso*3.14159265)", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 } },
				},
				Luz2 = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "Luz1", Source = "Output", },
						Foreground = Input { SourceOp = "Fuga2", Source = "Output", },
						ApplyMode = Input { Value = FuID { "Screen" }, },
						Blend = Input { Value = 0, Expression = "0.8*Mezcla.Intensidad*sin(Mezcla.Progreso*3.14159265)", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 220, 0 } },
				},
			},
		},
		PROLightLeakAnim = LUTLookup {
			Inputs = {
			},
			CtrlWZoom = false,
		},
	},
	ActiveTool = "PRO_TR_LightLeak"
}
