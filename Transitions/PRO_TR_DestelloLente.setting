{
	Tools = ordered() {
		PRO_TR_DestelloLente = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				MainInput1 = InstanceInput { SourceOp = "Mezcla", Source = "Background", },
				MainInput2 = InstanceInput { SourceOp = "Mezcla", Source = "Foreground", },
				Input1 = InstanceInput { SourceOp = "Destello", Source = "Intensidad", Name = "Intensidad", Default = 1, },
				Input2 = InstanceInput { SourceOp = "Destello", Source = "Altura", Name = "Altura del destello", Default = 0.6, },
				Input3 = InstanceInput { SourceOp = "Nucleo", Source = "TopLeftRed", Name = "Color del núcleo", ControlGroup = 3, Default = 1, },
				Input4 = InstanceInput { SourceOp = "Nucleo", Source = "TopLeftGreen", ControlGroup = 3, Default = 0.92, },
				Input5 = InstanceInput { SourceOp = "Nucleo", Source = "TopLeftBlue", ControlGroup = 3, Default = 0.8, },
				Input6 = InstanceInput { SourceOp = "Raya", Source = "TopLeftRed", Name = "Color de la raya", ControlGroup = 6, Default = 0.55, },
				Input7 = InstanceInput { SourceOp = "Raya", Source = "TopLeftGreen", ControlGroup = 6, Default = 0.75, },
				Input8 = InstanceInput { SourceOp = "Raya", Source = "TopLeftBlue", ControlGroup = 6, Default = 1, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Destello", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Mezcla = Dissolve {
					CtrlWShown = false,
					Inputs = {
						Mix = Input { Value = 0, Expression = "(max(0, min(1, (Destello.Progreso - 0.46)/0.08)))*(max(0, min(1, (Destello.Progreso - 0.46)/0.08)))*(3-2*(max(0, min(1, (Destello.Progreso - 0.46)/0.08))))", },
					},
					ViewInfo = OperatorInfo { Pos = { -330, 0 } },
				},
				Exposicion = BrightnessContrast {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "Mezcla", Source = "Output", },
						Gain = Input { Value = 1, Expression = "1 + 1.5*Destello.Intensidad*sin(Destello.Progreso*3.14159265)*sin(Destello.Progreso*3.14159265)*sin(Destello.Progreso*3.14159265)", },
					},
					ViewInfo = OperatorInfo { Pos = { -275, 0 } },
				},
				MascNucleo = EllipseMask {
					CtrlWShown = false,
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" }, },
						OutputSize = Input { Value = FuID { "Custom" }, },
						MaskWidth = Input { Value = 1920, },
						MaskHeight = Input { Value = 1080, },
						PixelAspect = Input { Value = { 1, 1 }, },
						UseFrameFormatSettings = Input { Value = 1, },
						ClippingMode = Input { Value = FuID { "None" }, },
						SoftEdge = Input { Value = 0.5, },
						Width = Input { Value = 0.5, Expression = "0.15 + 0.6*sin(Destello.Progreso*3.14159265)", },
						Height = Input { Value = 0.5, Expression = "0.15 + 0.6*sin(Destello.Progreso*3.14159265)", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(-0.2 + 1.4*Destello.Progreso, Destello.Altura)", },
					},
					ViewInfo = OperatorInfo { Pos = { -220, -132 } },
				},
				Nucleo = Background {
					CtrlWShown = false,
					Inputs = {
						EffectMask = Input { SourceOp = "MascNucleo", Source = "Mask", },
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 1, },
						TopLeftGreen = Input { Value = 0.92, },
						TopLeftBlue = Input { Value = 0.8, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { -220, -99 } },
				},
				MascRaya = RectangleMask {
					CtrlWShown = false,
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" }, },
						OutputSize = Input { Value = FuID { "Custom" }, },
						MaskWidth = Input { Value = 1920, },
						MaskHeight = Input { Value = 1080, },
						PixelAspect = Input { Value = { 1, 1 }, },
						UseFrameFormatSettings = Input { Value = 1, },
						ClippingMode = Input { Value = FuID { "None" }, },
						Width = Input { Value = 4, },
						Height = Input { Value = 0.006, },
						SoftEdge = Input { Value = 0.01, },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(-0.2 + 1.4*Destello.Progreso, Destello.Altura)", },
					},
					ViewInfo = OperatorInfo { Pos = { -165, -132 } },
				},
				Raya = Background {
					CtrlWShown = false,
					Inputs = {
						EffectMask = Input { SourceOp = "MascRaya", Source = "Mask", },
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 0.55, },
						TopLeftGreen = Input { Value = 0.75, },
						TopLeftBlue = Input { Value = 1, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { -165, -99 } },
				},
				ConNucleo = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "Exposicion", Source = "Output", },
						Foreground = Input { SourceOp = "Nucleo", Source = "Output", },
						ApplyMode = Input { Value = FuID { "Screen" }, },
						Blend = Input { Value = 0, Expression = "Destello.Intensidad*sin(Destello.Progreso*3.14159265)", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -220, 0 } },
				},
				ConRaya = Merge {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "ConNucleo", Source = "Output", },
						Foreground = Input { SourceOp = "Raya", Source = "Output", },
						ApplyMode = Input { Value = FuID { "Screen" }, },
						Blend = Input { Value = 0, Expression = "Destello.Intensidad*sin(Destello.Progreso*3.14159265)", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -165, 0 } },
				},
				Destello = BrightnessContrast {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "ConRaya", Source = "Output", },
						Progreso = Input { SourceOp = "PRODestelloLenteAnim", Source = "Value", },
						Intensidad = Input { Value = 1, },
						Altura = Input { Value = 0.6, },
					},
					ViewInfo = OperatorInfo { Pos = { -110, 0 } },
					UserControls = ordered() {
						Progreso = {
							LINKS_Name = "Progreso",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						Intensidad = {
							LINKS_Name = "Intensidad",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 2,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 2,
							ICS_ControlPage = "Controls",
						},
						Altura = {
							LINKS_Name = "Altura del destello",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.6,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
					},
				},
			},
		},
		PRODestelloLenteAnim = LUTLookup {
			Inputs = {
			},
			CtrlWZoom = false,
		},
	},
	ActiveTool = "PRO_TR_DestelloLente"
}
